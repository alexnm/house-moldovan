---
import BaseLayout from "~/layouts/BaseLayout.astro";
import JournalIndexHeader from "~/components/journal/JournalIndexHeader.astro";
import RegionFilteredGrid from "~/components/journal/RegionFilteredGrid.astro";
import { en } from "~/i18n/en";
import { getEnFeed } from "~/lib/content";

const feed = await getEnFeed();
---

<BaseLayout
  title={`${en.journal.title} · ${en.siteName}`}
  description={en.journal.metaDescription}
>
  <JournalIndexHeader
    title={en.journal.title}
    summary={en.journal.summary}
    note={en.journal.note}
  />
  {
    feed.length > 0 ? (
      <RegionFilteredGrid articles={feed} />
    ) : (
      <p class="pad-canvas mx-auto max-w-canvas py-16 text-ink-dim">
        {en.journal.empty}
      </p>
    )
  }
</BaseLayout>
