---
import BaseLayout from "~/layouts/BaseLayout.astro";
import JournalIndexHeader from "~/components/journal/JournalIndexHeader.astro";
import RegionFilteredGrid from "~/components/journal/RegionFilteredGrid.astro";
import { en } from "~/i18n/en";
import { getSpotlights, type AnyEnArticle } from "~/lib/content";

const raw = await getSpotlights();
const articles: AnyEnArticle[] = raw.map((e) => ({
  ...e,
  kind: "spotlight" as const,
}));
---

<BaseLayout
  title={`${en.spotlightsIndex.metaTitle} · ${en.siteName}`}
  description={en.spotlightsIndex.intro}
>
  <JournalIndexHeader
    title={en.nav.spotlights}
    summary={en.spotlightsIndex.intro}
    note={en.spotlightsIndex.note}
    link={{
      href: en.footer.instagramUrl,
      label: en.spotlightsIndex.noteCta,
      external: true,
    }}
  />
  {
    articles.length > 0 ? (
      <RegionFilteredGrid articles={articles} showJournalLink />
    ) : (
      <p class="pad-canvas mx-auto max-w-canvas py-16 text-ink-dim">
        {en.journal.empty}
      </p>
    )
  }
</BaseLayout>
