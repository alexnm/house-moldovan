---
import Hero from "@shared/components/article/Hero.astro";
import BaseLayout from "~/layouts/BaseLayout.astro";
import { en } from "~/i18n/en";
import heroImage from "~/assets/italy/dolomites-misurina.jpeg";

Astro.response.status = 404;
---

<BaseLayout
  title={`${en.notFound.metaTitle} · ${en.siteName}`}
  description={en.notFound.metaDescription}
>
  <Hero
    image={heroImage}
    alt="A mountain trail climbing toward a high saddle in the Peruvian Andes"
    title={en.notFound.heroTitle}
    meta={en.notFound.heroSummary}
    transitionName="hero-404"
  >
    <p
      slot="kicker"
      class="m-0 flex animate-cinema-fade flex-wrap items-center gap-2"
    >
      <a href="/" class="stamp-badge">{en.notFound.homeCta}</a>
    </p>
  </Hero>
</BaseLayout>
