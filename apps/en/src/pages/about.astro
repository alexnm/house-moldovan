---
import Hero from "@shared/components/article/Hero.astro";
import CoverImage from "@shared/components/media/CoverImage.astro";
import type { SectionLink } from "@shared/components/article/SectionNavigation.astro";
import BaseLayout from "~/layouts/BaseLayout.astro";
import ArticleCard from "~/components/home/ArticleCard.astro";
import AboutContactSheet from "~/components/about/AboutContactSheet.astro";
import PassportPages from "~/components/about/PassportPages.astro";
import { en } from "~/i18n/en";
import { getEnFeed } from "~/lib/content";
import { SISTER_SITE_URL } from "~/lib/site";
import heroImage from "~/assets/about/hero.JPG";
import alexMelaImage from "~/assets/about/alex-mela.JPG";
import coverImage from "~/assets/about/cover.jpg";
import melaImage from "~/assets/about/mela.JPG";
import alexImage from "~/assets/about/alex.jpg";
import alexIguazuImage from "~/assets/about/alex-iguazu.jpg";
import alexUzbekistanImage from "~/assets/about/alex-uzbekistan.jpg";
import melaPeruImage from "~/assets/about/mela-peru.JPG";
import melaEdiImage from "~/assets/about/mela-edi.JPG";
import peCreastaOg from "~/assets/about/pe-creasta-og.png";

const feed = await getEnFeed();

const sections: SectionLink[] = [
  { id: "passport", label: en.about.sections.passport, icon: "plane" },
  { id: "journal", label: en.about.sections.journal, icon: "directions" },
  { id: "sister", label: en.about.sections.sister, icon: "map" },
];

const facts = [
  { label: en.about.facts.basedIn, value: en.about.facts.basedInValue },
  { label: en.about.facts.since, value: "2012" },
  { label: en.about.facts.countries, value: en.about.facts.countriesValue },
  { label: en.about.facts.copilot, value: en.about.facts.copilotValue },
];

const prints = [
  { image: melaImage, alt: en.about.melaAlt, place: "Bruges, Belgium" },
  { image: alexImage, alt: en.about.alexAlt, place: "Dolomites, Italy" },
  {
    image: alexIguazuImage,
    alt: "Alex with arms open facing Iguazu Falls",
    place: "Iguazu Falls, Brazil",
  },
  {
    image: alexUzbekistanImage,
    alt: "Alex standing in a blue-tiled alcove in Uzbekistan",
    place: "Khiva, Uzbekistan",
  },
  {
    image: melaPeruImage,
    alt: "Mela with alpacas in Peru",
    place: "Cusco, Peru",
  },
  {
    image: melaEdiImage,
    alt: "Mela carrying Edi overlooking a coastal lagoon",
    place: "Crete, Greece",
  },
  { image: coverImage, alt: en.about.melaAlexAlt, place: "Romania" },
];

/** One card per note type, fronted by its newest photo (newest first feed). */
const noteTypes = [
  { ...en.about.notes.stories, kind: "story" as const },
  { ...en.about.notes.itineraries, kind: "itinerary" as const },
  { ...en.about.notes.spotlights, kind: "spotlight" as const },
].flatMap((note) => {
  const ofKind = feed.filter((a) => a.kind === note.kind);
  const latest = ofKind[0];
  return latest
    ? [
        {
          ...note,
          count: ofKind.length,
          image: latest.data.hero,
          alt: latest.data.title,
        },
      ]
    : [];
});
---

<BaseLayout
  title={`${en.about.title} · ${en.siteName}`}
  description={en.description}
>
  <Hero
    image={heroImage}
    alt="Our shadows projected on a rock during sunset on Tenerife island"
    kicker={en.about.kicker}
    title={en.about.heroTitle}
    meta={en.about.heroSummary}
    location="Tenerife, Spain"
    sections={sections}
    transitionName="hero-about"
  />

  <section id="us" class="section section-y-lg scroll-mt-20">
    <figure class="about-note motion-reveal shadow-rest">
      <span class="about-note__mark" aria-hidden="true">“</span>

      <div class="about-note__portrait">
        <div class="about-note__clip">
          <CoverImage
            src={alexMelaImage}
            alt={en.home.about.portraitAlt}
            widths={[160, 240, 320]}
            sizes="9rem"
            format="avif"
            quality={82}
            placeholder="blur"
            wrapperClass="absolute inset-0"
            class="h-full w-full object-cover object-[center_28%]"
          />
        </div>
      </div>

      <div class="about-note__body">
        <p class="stamp about-note__kicker">{en.region.editorialKicker}</p>
        <blockquote class="about-note__text">
          <p>
            Hi there, fellow travelers! We are Mela and Alex, the two people
            behind House Moldovan. We are based in Romania and we've been
            travelling together since 2012.
          </p>
          <p>
            We visited over 40 countries and are eager to share our experiences
            with you. 👶 Edi is our little travel companion and he's been part
            of our travels since 2024.
          </p>
          <p>
            We started this site to keep our travel writing and photography in
            one place: honest impressions from the trips we took, organized so
            you can <a href="/explore">browse by region</a> or follow along in
            <a href="/journal">the journal</a>.
          </p>
        </blockquote>

        <dl class="about-facts">
          {
            facts.map((fact) => (
              <div class="about-facts__item">
                <dt class="micro about-facts__label">{fact.label}</dt>
                <dd class="display about-facts__value">{fact.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </figure>

    <div class="about-sheet">
      <AboutContactSheet prints={prints} label={en.about.contactSheetLabel} />
    </div>
  </section>

  <PassportPages />

  <section id="journal" class="section section-y-lg scroll-mt-20">
    <header class="section-header">
      <p class="stamp text-accent-ink">{en.about.notesKicker}</p>
      <h2 class="display section-heading mt-2">{en.about.journalHeading}</h2>
    </header>

    <ul class="about-notes">
      {
        noteTypes.map((note) => (
          <li>
            <ArticleCard
              href={note.href}
              title={note.title}
              kicker={en.about.noteCount(note.count, note.kind)}
              meta={note.description}
              image={note.image}
              imageAlt={note.alt}
            />
          </li>
        ))
      }
    </ul>
  </section>

  <section id="sister" class="section section-y-lg scroll-mt-20">
    <div class="about-sister motion-reveal shadow-rest">
      <div class="about-sister__copy">
        <p class="stamp about-sister__kicker text-accent-ink">Sister website</p>
        <h2 class="display section-heading mt-2">Pe creste</h2>
        <p class="mt-3 max-w-prose leading-relaxed text-ink-dim">
          When we are not abroad, we hike the Romanian Carpathians. Our sister
          site, written in Romanian, collects routes, elevation profiles, and
          notes from those days on the ridge.
        </p>
        <a
          href={SISTER_SITE_URL}
          class="link-more link-accent link-accent--dim mt-5 inline-block"
          target="_blank"
          rel="noopener noreferrer"
        >
          Visit pecreste.ro →
        </a>
      </div>
      <a
        href={SISTER_SITE_URL}
        class="about-sister__preview group"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Open Pe creastă"
      >
        <div class="about-sister__shell">
          <CoverImage
            src={peCreastaOg}
            alt="Pe creastă — hiking journal for the Romanian Carpathians"
            widths={[640, 960, 1200]}
            sizes="(min-width: 1024px) 40vw, 92vw"
            format="png"
            quality={90}
            loading="lazy"
            placeholder="blur"
            wrapperClass="absolute inset-0"
            class="h-full w-full object-cover"
          />
        </div>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  /* Same card as the region page's "A note from us". */
  .about-note {
    --note-bg: var(--color-surface-2);
    position: relative;
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
    margin: 0;
    overflow: hidden;
    padding: clamp(1.5rem, 4vw, 3.25rem);
    border-radius: 8px;
    border-left: 4px solid var(--color-accent);
    background: var(--note-bg);

    @media (width >= 768px) {
      gap: 2.25rem;
    }
  }

  :global(html[data-theme="light"]) .about-note {
    border: 1px solid var(--color-line);
    border-left: 4px solid var(--color-accent);
  }

  .about-note__mark {
    position: absolute;
    top: clamp(1rem, 2.5vw, 2rem);
    right: clamp(1.25rem, 3vw, 2.5rem);
    font-family: var(--font-display);
    font-size: clamp(7rem, 12vw, 11rem);
    line-height: 0.62;
    color: var(--color-accent);
    pointer-events: none;
  }

  .about-note__portrait {
    position: relative;
    flex: none;
    width: 4.5rem;
    aspect-ratio: 1;
    border-radius: 50%;
    box-shadow:
      0 0 0 4px var(--note-bg),
      0 0 0 5px var(--color-line-strong);

    @media (width >= 768px) {
      width: 7rem;
    }
  }

  .about-note__clip {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: 50%;
  }

  .about-note__body {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-width: 0;
  }

  .about-note__kicker {
    margin: 0;
    color: var(--color-accent-ink);
  }

  .about-note__text {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 80ch;
    margin: 0;
    font-family: var(--font-body);
    font-size: clamp(1.05rem, 0.95rem + 0.35vw, 1.25rem);
    line-height: 1.6;
    color: var(--color-ink);
    text-wrap: pretty;
  }

  .about-note__text p {
    margin: 0;
  }

  .about-note__text a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }

  .about-note__signature {
    font-size: 0.9rem;
    color: var(--color-ink);
  }

  .about-facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    max-width: 80ch;
    margin: 0.5rem 0 0;
    border-top: 1px solid var(--color-line);

    @media (width >= 768px) {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .about-facts__item {
    padding-block: 1rem 0.25rem;
  }

  .about-facts__label {
    color: var(--color-accent-ink);
  }

  .about-facts__value {
    margin: 0.45rem 0 0;
    font-size: clamp(1.5rem, 1.25rem + 0.8vw, 2rem);
    line-height: 0.95;
    letter-spacing: -0.03em;
  }

  .about-sheet {
    margin-top: clamp(3rem, 6vw, 5.5rem);
  }

  .about-notes {
    display: grid;
    gap: var(--grid-gap-compact);
    margin: 0;
    padding: 0;
    list-style: none;

    @media (width >= 768px) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* Full-width card: copy padded on the left, the site preview bleeding to the
     top, right and bottom edges. Stacks with the preview bleeding below. */
  .about-sister {
    display: grid;
    overflow: hidden;
    border-radius: 8px;
    background: var(--color-surface-2);

    @media (width >= 768px) {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
      align-items: stretch;
    }
  }

  :global(html[data-theme="light"]) .about-sister {
    border: 1px solid var(--color-line);
  }

  .about-sister__copy {
    padding: clamp(1.5rem, 3.5vw, 2.5rem);
  }

  .about-sister__copy :global(.section-heading) {
    font-size: clamp(2rem, 1.4rem + 1.6vw, 2.75rem);
  }

  .about-sister__preview {
    display: block;
    min-height: 14rem;
    margin-left: clamp(1.5rem, 3.5vw, 2.5rem);

    @media (width < 768px) {
      margin-left: 0;
    }
  }

  .about-sister__shell {
    position: relative;
    height: 100%;
    overflow: hidden;
  }

  .about-sister__shell :global(img) {
    height: 100%;
    width: 100%;
    object-fit: cover;
    object-position: left center;
  }

  /* Below sm the portrait sits in the facts footer, as on the country card. */
  @media (width < 640px) {
    .about-note {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      column-gap: 0.75rem;
      row-gap: 1rem;
      align-items: start;
    }

    .about-note__body {
      display: contents;
    }

    .about-note__kicker,
    .about-note__text {
      grid-column: 1 / -1;
    }

    .about-note__kicker {
      order: 1;
    }

    .about-note__text {
      order: 2;
    }

    .about-note__portrait {
      order: 3;
      grid-column: 1;
      width: 3.5rem;
      align-self: center;
      box-shadow:
        0 0 0 3px var(--note-bg),
        0 0 0 4px var(--color-line-strong);
    }

    .about-facts {
      position: relative;
      order: 4;
      grid-column: 2;
      align-self: start;
      margin: 0;
      border-top: 0;
    }

    /* The rule above the facts continues across the portrait column. */
    .about-facts::before {
      content: "";
      position: absolute;
      top: 0;
      right: 0;
      left: calc(-1 * (3.5rem + 0.75rem));
      border-top: 1px solid var(--color-line);
    }
  }
</style>
