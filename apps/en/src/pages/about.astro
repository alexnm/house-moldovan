---
import Hero from "@shared/components/article/Hero.astro";
import CoverImage from "@shared/components/media/CoverImage.astro";
import type { SectionLink } from "@shared/components/article/SectionNavigation.astro";
import BaseLayout from "~/layouts/BaseLayout.astro";
import ArticleCard from "~/components/home/ArticleCard.astro";
import AboutContactSheet from "~/components/about/AboutContactSheet.astro";
import AboutIntro from "~/components/about/AboutIntro.astro";
import NoteFromUs from "~/components/NoteFromUs.astro";
import PassportPages from "~/components/about/PassportPages.astro";
import { en } from "~/i18n/en";
import { getEnFeed } from "~/lib/content";
import { homeNoteStamps } from "~/lib/noteStamps";
import { SISTER_SITE_URL } from "~/lib/site";
import heroImage from "~/assets/about/hero.JPG";
import coverImage from "~/assets/about/cover.jpg";
import melaImage from "~/assets/about/mela.JPG";
import alexImage from "~/assets/about/alex.jpg";
import alexIguazuImage from "~/assets/about/alex-iguazu.jpg";
import alexUzbekistanImage from "~/assets/about/alex-uzbekistan.jpg";
import melaPeruImage from "~/assets/about/mela-peru.JPG";
import melaEdiImage from "~/assets/about/mela-edi.JPG";
import peCreastaOg from "~/assets/about/pe-creasta-og.png";

const [feed, stamps] = await Promise.all([getEnFeed(), homeNoteStamps()]);

const sections: SectionLink[] = [
  { id: "passport", label: en.about.sections.passport, icon: "plane" },
  { id: "journal", label: en.about.sections.journal, icon: "directions" },
  { id: "sister", label: en.about.sections.sister, icon: "map" },
];

const prints = [
  { image: melaImage, alt: en.about.melaAlt, place: "Bruges, Belgium" },
  { image: alexImage, alt: en.about.alexAlt, place: "Dolomites, Italy" },
  {
    image: alexIguazuImage,
    alt: "Alex with arms open facing Iguazu Falls",
    place: "Iguazu Falls, Brazil",
  },
  {
    image: alexUzbekistanImage,
    alt: "Alex standing in a blue-tiled alcove in Uzbekistan",
    place: "Khiva, Uzbekistan",
  },
  {
    image: melaPeruImage,
    alt: "Mela with alpacas in Peru",
    place: "Cusco, Peru",
  },
  {
    image: melaEdiImage,
    alt: "Mela carrying Edi overlooking a coastal lagoon",
    place: "Crete, Greece",
  },
  { image: coverImage, alt: en.about.melaAlexAlt, place: "Romania" },
];

/** One card per note type, fronted by its newest photo (newest first feed). */
const noteTypes = [
  { ...en.about.notes.stories, kind: "story" as const },
  { ...en.about.notes.itineraries, kind: "itinerary" as const },
  { ...en.about.notes.spotlights, kind: "spotlight" as const },
].flatMap((note) => {
  const ofKind = feed.filter((a) => a.kind === note.kind);
  const latest = ofKind[0];
  return latest
    ? [
        {
          ...note,
          count: ofKind.length,
          image: latest.data.hero,
          alt: latest.data.title,
        },
      ]
    : [];
});
---

<BaseLayout
  title={`${en.about.title} · ${en.siteName}`}
  description={en.description}
>
  <Hero
    image={heroImage}
    alt="Our shadows projected on a rock during sunset on Tenerife island"
    kicker={en.about.kicker}
    title={en.about.heroTitle}
    meta={en.about.heroSummary}
    location="Tenerife, Spain"
    sections={sections}
    transitionName="hero-about"
  />

  <section id="us" class="section section-y-lg scroll-mt-20">
    <NoteFromUs kicker={en.region.editorialKicker} stamps={stamps}>
      <AboutIntro />
    </NoteFromUs>

    <div class="about-sheet">
      <AboutContactSheet prints={prints} label={en.about.contactSheetLabel} />
    </div>
  </section>

  <PassportPages />

  <section id="journal" class="section section-y-lg scroll-mt-20">
    <header class="section-header">
      <p class="stamp text-accent-ink">{en.about.notesKicker}</p>
      <h2 class="display section-heading mt-2">{en.about.journalHeading}</h2>
    </header>

    <ul class="about-notes">
      {
        noteTypes.map((note) => (
          <li>
            <ArticleCard
              href={note.href}
              title={note.title}
              kicker={en.about.noteCount(note.count, note.kind)}
              meta={note.description}
              image={note.image}
              imageAlt={note.alt}
            />
          </li>
        ))
      }
    </ul>
  </section>

  <section id="sister" class="section section-y-lg scroll-mt-20">
    <div class="about-sister motion-reveal shadow-rest">
      <div class="about-sister__copy">
        <p class="stamp about-sister__kicker text-accent-ink">Sister website</p>
        <h2 class="display section-heading mt-2">Pe creste</h2>
        <p class="mt-3 max-w-prose leading-relaxed text-ink-dim">
          When we are not abroad, we hike the Romanian Carpathians. Our sister
          site, written in Romanian, collects routes, elevation profiles, and
          notes from those days on the ridge.
        </p>
        <a
          href={SISTER_SITE_URL}
          class="link-more link-accent link-accent--dim mt-5 inline-block"
          target="_blank"
          rel="noopener noreferrer"
        >
          Visit pecreste.ro →
        </a>
      </div>
      <a
        href={SISTER_SITE_URL}
        class="about-sister__preview group"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Open Pe creastă"
      >
        <div class="about-sister__shell">
          <CoverImage
            src={peCreastaOg}
            alt="Pe creastă — hiking journal for the Romanian Carpathians"
            widths={[640, 960, 1200]}
            sizes="(min-width: 1024px) 40vw, 92vw"
            format="png"
            quality={90}
            loading="lazy"
            placeholder="blur"
            wrapperClass="absolute inset-0"
            class="h-full w-full object-cover"
          />
        </div>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .about-sheet {
    margin-top: clamp(3rem, 6vw, 5.5rem);
  }

  .about-notes {
    display: grid;
    gap: var(--grid-gap-compact);
    margin: 0;
    padding: 0;
    list-style: none;

    @media (width >= 768px) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* Full-width card: copy padded on the left, the site preview bleeding to the
     top, right and bottom edges. Stacks with the preview bleeding below. */
  .about-sister {
    display: grid;
    overflow: hidden;
    border-radius: 4px;
    background: var(--color-surface-2);

    @media (width >= 768px) {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
      align-items: stretch;
    }
  }

  :global(html[data-theme="light"]) .about-sister {
    border: 1px solid var(--color-line);
  }

  .about-sister__copy {
    padding: clamp(1.5rem, 3.5vw, 2.5rem);
  }

  .about-sister__copy :global(.section-heading) {
    font-size: clamp(2rem, 1.4rem + 1.6vw, 2.75rem);
  }

  .about-sister__preview {
    display: block;
    min-height: 14rem;
    margin-left: clamp(1.5rem, 3.5vw, 2.5rem);

    @media (width < 768px) {
      margin-left: 0;
    }
  }

  .about-sister__shell {
    position: relative;
    height: 100%;
    overflow: hidden;
  }

  .about-sister__shell :global(img) {
    height: 100%;
    width: 100%;
    object-fit: cover;
    object-position: left center;
  }
</style>
