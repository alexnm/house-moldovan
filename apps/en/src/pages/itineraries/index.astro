---
import BaseLayout from "~/layouts/BaseLayout.astro";
import JournalIndexHeader from "~/components/journal/JournalIndexHeader.astro";
import RhythmGrid from "~/components/home/RhythmGrid.astro";
import { en } from "~/i18n/en";
import { getItineraries, type AnyEnArticle } from "~/lib/content";

const raw = await getItineraries();
const articles: AnyEnArticle[] = raw.map((e) => ({
  ...e,
  kind: "itinerary" as const,
}));
---

<BaseLayout
  title={`${en.itinerariesIndex.metaTitle} · ${en.siteName}`}
  description={en.itinerariesIndex.intro}
>
  <JournalIndexHeader
    title={en.nav.itineraries}
    summary={en.itinerariesIndex.intro}
    kind="itinerary"
  />
  {
    articles.length > 0 ? (
      <section class="section section-y-tight">
        <RhythmGrid articles={articles} />
      </section>
    ) : (
      <p class="pad-canvas mx-auto max-w-canvas py-16 text-ink-dim">
        {en.journal.empty}
      </p>
    )
  }
</BaseLayout>
