---
import type { GetStaticPaths } from "astro";
import { render } from "astro:content";
import BaseLayout from "~/layouts/BaseLayout.astro";
import RegionHero from "~/components/home/RegionHero.astro";
import RegionGuide from "~/components/region/RegionGuide.astro";
import RegionMapHub from "~/components/region/RegionMapHub.astro";
import ArticleCard from "~/components/home/ArticleCard.astro";
import { en } from "~/i18n/en";
import { getAllRegions } from "~/lib/regions";
import { loadRegionPage } from "~/lib/regionPage";
import { regionOgPath } from "~/lib/ogPaths";

export const getStaticPaths = (async () => {
  const regions = await getAllRegions();
  return regions.map((region) => ({ params: { slug: region.id } }));
}) satisfies GetStaticPaths;

const page = await loadRegionPage(Astro.params.slug!);
if (!page) {
  return Astro.redirect("/explore");
}

const {
  region,
  name,
  tagline,
  accent,
  order,
  images,
  countries,
  dossier,
  notes,
  locationPins,
  atlas,
} = page;

const { Content } = await render(region);
---

<BaseLayout
  title={`${name} · ${en.siteName}`}
  description={tagline}
  ogImage={regionOgPath(page.region.id)}
>
  <RegionHero
    name={name}
    tagline={tagline}
    order={order}
    accent={accent}
    images={images}
  />

  <div class="accent-scope" data-accent={accent}>
    <RegionGuide dossier={dossier} accent={accent}>
      <Content />
    </RegionGuide>

    {
      atlas && countries.length > 0 && (
        <RegionMapHub
          countries={countries}
          locationPins={locationPins}
          atlas={atlas}
          regionAccent={accent}
        />
      )
    }
  </div>

  {
    notes.length > 0 && (
      <section class="section section-y">
        <header class="section-header">
          <h2 class="display section-heading">
            {en.region.storiesHeading(name)}
          </h2>
        </header>
        <ul class="grid-cards">
          {notes.map((item) => (
            <li>
              <ArticleCard
                href={item.href}
                title={item.a.data.title}
                kicker={item.kicker}
                meta={item.countryMeta}
                image={item.a.data.hero}
                imageAlt={item.a.data.title}
                size="md"
                accent={item.accent}
                regionLabel={name}
                transitionName={`hero-${item.a.id}`}
              />
            </li>
          ))}
        </ul>
      </section>
    )
  }
</BaseLayout>
