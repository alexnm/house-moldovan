---
import type { GetStaticPaths } from "astro";
import BaseLayout from "~/layouts/BaseLayout.astro";
import RegionMapHero from "~/components/region/RegionMapHero.astro";
import RegionGuide from "~/components/region/RegionGuide.astro";
import NoteFromUs from "~/components/NoteFromUs.astro";
import RegionMapHub from "~/components/region/RegionMapHub.astro";
import ArticleCard from "~/components/home/ArticleCard.astro";
import { en } from "~/i18n/en";
import { getAllRegions } from "~/lib/regions";
import { loadRegionPage } from "~/lib/regionPage";
import { regionNoteStamps } from "~/lib/noteStamps";
import { regionOgPath } from "~/lib/ogPaths";

export const getStaticPaths = (async () => {
  const regions = await getAllRegions();
  return regions.map((region) => ({ params: { slug: region.id } }));
}) satisfies GetStaticPaths;

const page = await loadRegionPage(Astro.params.slug!);
if (!page) {
  return Astro.redirect("/explore");
}

const {
  name,
  tagline,
  accent,
  countries,
  dossier,
  featuredStory,
  editorial,
  notes,
  locationPins,
  atlas,
} = page;

const noteStamps = regionNoteStamps(countries.map((c) => c.country));

const allRegions = await getAllRegions();
const here = allRegions.findIndex((r) => r.id === page.region.id);
const nextRegion =
  allRegions.length > 1
    ? allRegions[(here + 1) % allRegions.length]
    : undefined;
---

<BaseLayout
  title={`${name} · ${en.siteName}`}
  description={tagline}
  ogImage={regionOgPath(page.region.id)}
>
  <div class="place-rhythm">
    <RegionMapHero
      regionId={page.region.id}
      name={name}
      tagline={tagline}
      accent={accent}
      highlights={page.region.data.highlights ?? []}
      heroShift={page.region.data.heroShift}
      heroShiftY={page.region.data.heroShiftY}
      next={nextRegion
        ? {
            href: `/explore/region/${nextRegion.id}`,
            name: nextRegion.data.name,
          }
        : undefined}
    />

    <div class="accent-scope" data-accent={accent}>
      <RegionGuide
        heading={en.region.guideTitle(name)}
        dossier={dossier}
        featuredStory={featuredStory}
        accent={accent}
      />
      {
        editorial.length > 0 && (
          <section class="section">
            <NoteFromUs kicker={en.region.editorialKicker} stamps={noteStamps}>
              {editorial.map((html) => (
                <Fragment set:html={html} />
              ))}
            </NoteFromUs>
          </section>
        )
      }

      {
        atlas && countries.length > 0 && (
          <RegionMapHub
            countries={countries}
            locationPins={locationPins}
            atlas={atlas}
            regionAccent={accent}
          />
        )
      }
    </div>

    {
      notes.length > 0 && (
        <section class="section">
          <header class="section-header">
            <h2 class="display section-heading">
              {en.region.storiesHeading(name)}
            </h2>
          </header>
          <ul class="grid-cards">
            {notes.map((item) => (
              <li>
                <ArticleCard
                  href={item.href}
                  title={item.a.data.title}
                  kicker={item.kicker}
                  meta={item.countryMeta}
                  image={item.a.data.hero}
                  imageAlt={item.a.data.title}
                  size="md"
                  accent={item.accent}
                  regionLabel={name}
                  transitionName={`hero-${item.a.id}`}
                />
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</BaseLayout>
