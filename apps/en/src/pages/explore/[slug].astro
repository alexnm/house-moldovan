---
import type { GetStaticPaths } from "astro";
import BaseLayout from "~/layouts/BaseLayout.astro";
import ArticleCard from "~/components/home/ArticleCard.astro";
import CountryGlance from "~/components/country/CountryGlance.astro";
import { countryFacts } from "~/lib/countryFacts";
import {
  afterFirstParagraph,
  renderMarkdownFragment,
} from "~/lib/markdownFragment";
import CountryHighlights from "~/components/country/CountryHighlights.astro";
import CountryMapHub from "~/components/country/CountryMapHub.astro";
import Breadcrumbs from "@shared/components/article/Breadcrumbs.astro";
import Hero from "@shared/components/article/Hero.astro";
import { en } from "~/i18n/en";
import {
  countryMapFitMaxZoom,
  countryMapFitZoomOffset,
  loadCountryPage,
  showCountryHighlights,
  showCountryIntro,
  showCountryMap,
} from "~/lib/countryPage";
import { getAllPlaces, getPlace } from "~/lib/content";
import { placeCoverLocationLabel } from "~/lib/locations";
import { placeOgPath } from "~/lib/ogPaths";
import type { SectionLink } from "@shared/components/article/SectionNavigation.astro";

export const getStaticPaths = (async () => {
  const places = await getAllPlaces();
  return places.map((country) => ({ params: { slug: country.id } }));
}) satisfies GetStaticPaths;

const slug = Astro.params.slug!;
const country = await getPlace(slug);
if (!country) {
  return Astro.redirect("/explore");
}

const {
  region,
  entries,
  locationPins,
  locations,
  snapshots,
  accent,
  cover,
  shape,
  atlas,
  atlasFocus,
} = await loadCountryPage(country);
const glanceHtml = await renderMarkdownFragment(
  afterFirstParagraph(country.body),
);
const coverLocation = await placeCoverLocationLabel(country);
const showIntro = showCountryIntro(country);
const showHighlights = showCountryHighlights(snapshots);
const showMap = showCountryMap(country, locations) && locationPins.length > 0;

const breadcrumbs = [
  { label: "Explore", href: "/explore" },
  { label: region.data.name, href: `/explore/region/${region.id}` },
  { label: country.data.name },
];

const sections: SectionLink[] = [
  ...(showIntro
    ? [{ id: "intro", label: "Info", icon: "message" as const }]
    : []),
  ...(showMap ? [{ id: "map", label: "Map", icon: "map" as const }] : []),
  { id: "stories", label: "Guides", icon: "directions" as const },
];
---

<BaseLayout
  title={`${country.data.name} · ${en.siteName}`}
  description={country.data.tagline}
  ogImage={placeOgPath(country.id)}
>
  <article class="accent-scope place-rhythm" data-accent={accent}>
    <Hero
      image={cover}
      alt={`${country.data.name}: ${country.data.tagline}`}
      title={country.data.name}
      titleFlag={country.data.flag}
      meta={country.data.tagline}
      location={coverLocation}
      sections={sections}
      accent={accent}
    >
      <a
        href={`/explore/region/${region.id}`}
        class="stamp-badge stamp-badge--accent accent-scope duration-ui transition-opacity ease-cinema hover:opacity-90"
        data-accent={region.data.accent}
        slot="kicker"
      >
        {region.data.name}
      </a>
    </Hero>

    {
      showIntro && (
        <CountryGlance
          country={country.data.name}
          localName={country.data.localName}
          forceLocalName={country.data.stampLocalName}
          headline={country.data.headline}
          facts={countryFacts(country.data.facts, region.data.name)}
          visits={country.data.visits}
          stopCount={showMap ? locations.length : 0}
          articleCount={entries.length}
        >
          <Fragment set:html={glanceHtml} />
        </CountryGlance>
      )
    }

    {
      showHighlights && (
        <CountryHighlights photos={snapshots} countryName={country.data.name} />
      )
    }

    {
      showMap && (
        <CountryMapHub
          countryName={country.data.name}
          accent={accent}
          locations={locations}
          locationPins={locationPins}
          shape={shape}
          fitMaxZoom={countryMapFitMaxZoom(country.id)}
          fitZoomOffset={countryMapFitZoomOffset(country.id)}
          atlas={atlas}
          atlasFocus={atlasFocus}
        />
      )
    }

    <section id="stories" class="section scroll-mt-28">
      <header class="section-header">
        <h2 class="display section-heading">
          {en.places.storiesHeading(country.data.name)}
        </h2>
      </header>

      {
        entries.length > 0 ? (
          <ul class="grid-cards">
            {entries.map(
              ({ article, href, kicker, countryMeta, accent, regionLabel }) => (
                <li>
                  <ArticleCard
                    href={href}
                    title={article.data.title}
                    kicker={kicker}
                    meta={countryMeta}
                    image={article.data.hero}
                    imageAlt={article.data.title}
                    size="md"
                    accent={accent}
                    regionLabel={regionLabel}
                    transitionName={`hero-${article.id}`}
                  />
                </li>
              ),
            )}
          </ul>
        ) : (
          <div class="space-y-4 py-12">
            <p class="text-ink-dim">{en.places.noStoriesYet}</p>
            <p>
              <a href="/explore" class="link-more link-accent link-accent--dim">
                ← {en.places.backToExplore}
              </a>
            </p>
          </div>
        )
      }
    </section>
  </article>
</BaseLayout>
