---
/**
 * Look 2 — "The Atlas". Same fonts, same film-night canvas, but the map becomes
 * the spine: it takes the fold, the chapter tiles become an atlas index, and the
 * journal feed becomes a friendly trail of stories. Chapter colour survives as
 * ink and pin, not as fill.
 */
import type { CollectionEntry } from "astro:content";
import BaseLayout from "~/layouts/BaseLayout.astro";
import AboutIntro from "~/components/home/AboutIntro.astro";
import DevLookBar from "~/components/dev/DevLookBar.astro";
import MapHero from "~/components/dev/look2/MapHero.astro";
import ChapterIndex from "~/components/dev/look2/ChapterIndex.astro";
import RouteLog from "~/components/dev/look2/RouteLog.astro";
import { articleHref, articleKicker } from "~/lib/articles";
import { countryLine, placeShortName } from "~/lib/articlePlaces";
import {
  countriesForRegion,
  getAllPlaces,
  getEnFeed,
  getHomeRecentFeed,
  getPlace,
  primaryCountryFromArticle,
} from "~/lib/content";
import { buildArticleMapPins } from "~/lib/mapPinData";
import { getAllRegions, regionIdFromPlace, regionMapById } from "~/lib/regions";
import { en } from "~/i18n/en";

const [feed, regions, places, pins] = await Promise.all([
  getEnFeed(),
  getAllRegions(),
  getAllPlaces(),
  buildArticleMapPins(),
]);

const recent = getHomeRecentFeed(feed, 6);
const regionsById = regionMapById(regions);

const legendChapters = regions.map((r) => ({
  name: r.data.name,
  accent: r.data.accent,
  href: `/explore/region/${r.id}`,
}));

const indexChapters = regions.map((r) => ({
  id: r.id,
  name: r.data.name,
  tagline: r.data.tagline,
  accent: r.data.accent,
  countries: countriesForRegion(places, r.id).map((p) => ({
    id: p.id,
    name: placeShortName(p),
    flag: p.data.flag,
  })),
  frames: r.data.images,
}));

const logEntries = await Promise.all(
  recent.map(async (a) => {
    const primary = await getPlace(primaryCountryFromArticle(a));
    const regionId = primary ? regionIdFromPlace(primary) : undefined;
    const region = regionId ? regionsById.get(regionId) : undefined;
    const countries = (
      await Promise.all(a.data.country.map((ref) => getPlace(ref)))
    ).filter((p): p is CollectionEntry<"places"> => Boolean(p));

    return {
      href: articleHref(a),
      title: a.data.title,
      kind: a.kind,
      kicker: articleKicker(a),
      countryMeta: countryLine(countries),
      summary: a.data.summary,
      accent: primary?.data.accent ?? region?.data.accent,
      image: a.data.hero,
    };
  }),
);
---

<BaseLayout
  title="Look 2 · The Atlas"
  description="Prototype: the map as the spine of the journal."
  noindex
>
  <DevLookBar current={2} />

  <MapHero
    pins={pins}
    kicker={en.home.kicker}
    title={en.siteName}
    summary={en.description}
    chapters={legendChapters}
  />

  <section class="section section-y">
    <header
      class="section-header flex flex-wrap items-baseline justify-between gap-4"
    >
      <div>
        <h2 class="display section-heading">Choose a part of the world</h2>
        <p class="mt-3 max-w-[54ch] text-ink-dim">
          Follow the photographs, pick a country that calls to you, and see what
          we found along the way.
        </p>
      </div>
      <a
        href="/explore"
        class="link-more link-accent link-accent--dim hidden shrink-0 sm:inline"
      >
        {en.home.exploreCta} →
      </a>
    </header>

    <ChapterIndex chapters={indexChapters} />
  </section>

  <AboutIntro />

  <section class="section section-y">
    <header
      class="section-header flex flex-wrap items-baseline justify-between gap-4"
    >
      <h2 class="display section-heading">Stories from the road</h2>
      <a
        href="/journal"
        class="link-more link-accent link-accent--dim hidden shrink-0 sm:inline"
      >
        {en.home.seeAll} →
      </a>
    </header>

    <RouteLog entries={logEntries} />

    <a
      href="/journal"
      class="link-more link-accent link-accent--dim mt-(--space-block) inline-block sm:hidden"
    >
      {en.home.seeAll} →
    </a>
  </section>
</BaseLayout>
