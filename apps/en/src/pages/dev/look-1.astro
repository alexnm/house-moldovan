---
/**
 * Look 1 — "Field Notes". Kodachrome Expedition kept intact; cartographic and
 * journey signal added where it costs least: the article map gets a home and
 * kind glyphs travel with the darker, more legible article cards. The familiar
 * region cards and the rest of the homepage rhythm stay intact.
 */
import type { CollectionEntry } from "astro:content";
import CoverImage from "@shared/components/media/CoverImage.astro";
import BaseLayout from "~/layouts/BaseLayout.astro";
import AboutIntro from "~/components/home/AboutIntro.astro";
import FeaturedCountries from "~/components/home/FeaturedCountries.astro";
import RegionStrip from "~/components/home/RegionStrip.astro";
import DevLookBar from "~/components/dev/DevLookBar.astro";
import KindGlyph from "~/components/dev/KindGlyph.astro";
import MapLegend from "~/components/dev/MapLegend.astro";
import LocationsMap from "~/components/map/LocationsMap.astro";
import NoteCard from "~/components/dev/look1/NoteCard.astro";
import { articleHref, articleKicker } from "~/lib/articles";
import { countryLine } from "~/lib/articlePlaces";
import {
  getEnFeed,
  getHomeRecentFeed,
  getPlace,
  primaryCountryFromArticle,
} from "~/lib/content";
import { buildLocationMapPins } from "~/lib/mapPinData";
import { getAllRegions, regionIdFromPlace, regionMapById } from "~/lib/regions";
import { en } from "~/i18n/en";
import heroImage from "~/assets/peru/salkantay-cover.jpg";

const [feed, regions, pins] = await Promise.all([
  getEnFeed(),
  getAllRegions(),
  buildLocationMapPins(),
]);

const recent = getHomeRecentFeed(feed, 6);
const regionsById = regionMapById(regions);

const legendChapters = regions.map((r) => ({
  name: r.data.name,
  accent: r.data.accent,
  href: `/explore/region/${r.id}`,
}));

const notes = await Promise.all(
  recent.map(async (a) => {
    const primary = await getPlace(primaryCountryFromArticle(a));
    const regionId = primary ? regionIdFromPlace(primary) : undefined;
    const region = regionId ? regionsById.get(regionId) : undefined;
    const countries = (
      await Promise.all(a.data.country.map((ref) => getPlace(ref)))
    ).filter((p): p is CollectionEntry<"places"> => Boolean(p));

    return {
      article: a,
      accent: primary?.data.accent ?? region?.data.accent,
      regionLabel: region?.data.name,
      countryMeta: countryLine(countries),
    };
  }),
);

---

<BaseLayout
  title="Look 1 · Field Notes"
  description="Prototype: Kodachrome Expedition with cartographic signal added."
  noindex
>
  <DevLookBar current={1} />

  <section class="relative isolate overflow-clip">
    <div
      class="relative aspect-[16/9] max-h-dvh min-h-svh w-full overflow-clip"
      data-nav-hero
    >
      <div class="motion-parallax absolute inset-0 -top-[8%] -bottom-[8%]">
        <CoverImage
          src={heroImage}
          alt="Salkantay trek in the Peruvian Andes"
          widths={[1080, 1440, 1920, 2560]}
          sizes="100vw"
          priority
          placeholder="blur"
          format="avif"
          quality={84}
          wrapperClass="h-full w-full"
          class="h-full w-full object-cover"
        />
      </div>
      <div class="hero-overlay" aria-hidden="true"></div>

      <div
        class="pad-canvas hero-bottom absolute inset-x-0 bottom-0 z-10 mx-auto flex max-w-canvas flex-col items-start gap-4 md:gap-5"
      >
        <p class="stamp-badge stamp-badge--accent animate-cinema-fade">
          {en.home.kicker}
        </p>
        <h1
          class="display page-title hero-on-photo max-w-[14ch] animate-cinema-rise drop-shadow-[0_2px_24px_oklch(0.1_0.02_55/0.55)]"
        >
          {en.siteName}
        </h1>
        <p
          class="hero-on-photo-dim hero-summary motion-stagger animate-cinema-fade text-balance"
        >
          {en.description}
        </p>
        <p class="stamp hero-place motion-stagger-2 animate-cinema-fade">
          <KindGlyph kind="itinerary" size="1em" class="hero-place__pin" />
          Salkantay pass, Peru
        </p>
      </div>
    </div>
  </section>

  <RegionStrip />

  <section class="section section-y">
    <header
      class="section-header flex flex-wrap items-baseline justify-between gap-4"
    >
      <div>
        <h2 class="display section-heading">Places behind the stories</h2>
        <p class="mt-3 max-w-[52ch] text-ink-dim">
          Wander through the places we have written about. Open any pin to meet
          the story, itinerary, or photo essay that began there.
        </p>
      </div>
    </header>

    <LocationsMap
      pins={pins}
      basemap="film"
      fullBleed
      height="clamp(22rem, 62svh, 38rem)"
      locationLabelStyle="title"
      neutralLocationStamp
    />

    <MapLegend chapters={legendChapters} class="mt-4" />
  </section>

  <FeaturedCountries feed={feed} />

  <AboutIntro />

  <section class="section section-y-tight">
    <header
      class="section-header flex flex-wrap items-baseline justify-between gap-4"
    >
      <h2 class="display section-heading">{en.home.recentHeading}</h2>
      <a
        href="/journal"
        class="link-more link-accent link-accent--dim hidden shrink-0 sm:inline"
      >
        {en.home.seeAll} →
      </a>
    </header>

    <div class="grid-cards">
      {
        notes.map((note) => (
          <NoteCard
            href={articleHref(note.article)}
            title={note.article.data.title}
            kicker={articleKicker(note.article)}
            meta={note.countryMeta}
            image={note.article.data.hero}
            imageAlt={note.article.data.title}
            accent={note.accent}
            regionLabel={note.regionLabel}
          />
        ))
      }
    </div>

    <a
      href="/journal"
      class="link-more link-accent link-accent--dim mt-(--space-block) inline-block sm:hidden"
    >
      {en.home.seeAll} →
    </a>
  </section>
</BaseLayout>

<style>
  .hero-place {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    color: color-mix(in oklch, var(--color-photo-ink) 76%, transparent);
  }

  /* Sit the pin on the caps: flex centring uses the full line box, which hangs
     the glyph below the uppercase text. */
  .hero-place :global(.hero-place__pin) {
    transform: translateY(-0.06em);
  }
</style>
