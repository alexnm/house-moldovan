---
import LocationsMap from "~/components/map/LocationsMap.astro";
import type { CountryLocation } from "~/lib/countryPage";
import type { CountryShape } from "~/lib/countryShape";
import type { LocationMapPin } from "~/lib/mapPinData";

export interface Props {
  locations: CountryLocation[];
  locationPins: LocationMapPin[];
  shape?: CountryShape;
  locationsHeading: string;
  fitZoomOffset?: number;
}

const {
  locations,
  locationPins,
  shape,
  locationsHeading,
  fitZoomOffset = 0,
} = Astro.props;
---

<section id="map" class="section country-map-hub" data-country-hub>
  <div class="country-map-hub__map motion-reveal-media">
    <LocationsMap
      pins={locationPins}
      basemap="adaptive"
      fullBleed
      scrollZoom={false}
      fitMaxZoom={8}
      fitZoomOffset={fitZoomOffset}
      height="clamp(28rem, 68svh, 44rem)"
      highlight={shape}
      fitHighlight={Boolean(shape)}
      labelMode="name"
      locationLabelStyle="title"
      neutralLocationStamp
      locationOnlyPopup
      focusLocations
    />
  </div>

  <div class="country-map-hub__places-wrap motion-reveal-media">
    <h2 class="display section-heading">{locationsHeading}</h2>
    <ol class="country-map-hub__places" aria-label={locationsHeading}>
      {
        locations.map((location, index) => (
          <li>
            <button
              type="button"
              class="country-map-hub__place"
              data-focus-location={location.qualifiedId}
            >
              <span>{String(index + 1).padStart(2, "0")}</span>
              <span>{location.name}</span>
            </button>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .country-map-hub {
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
    padding-block: clamp(3.5rem, 7vw, 7rem);

    @media (width >= 900px) {
      grid-template-columns: 3fr 2fr;
      gap: clamp(2rem, 5vw, 5rem);
      align-items: start;
    }
  }

  .country-map-hub__map {
    overflow: clip;
    border-radius: 8px;
  }

  .country-map-hub__places-wrap {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .country-map-hub__places {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-line);
  }

  .country-map-hub__places li {
    border-bottom: 1px solid var(--color-line);
  }

  .country-map-hub__place {
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: 0.5rem;
    width: 100%;
    padding-block: 0.55rem;
    border: 0;
    background: transparent;
    color: var(--color-ink-dim);
    font-family: var(--font-sans);
    font-size: 1rem;
    text-align: start;
    cursor: pointer;
    transition: color var(--duration-ui) var(--ease-cinema);
  }

  .country-map-hub__place:hover,
  .country-map-hub__place.is-active {
    color: var(--color-accent-ink);
  }

  .country-map-hub__place span {
    color: var(--color-accent-ink);
    font-family: var(--font-sans);
    font-size: 1rem;
  }
</style>

<script>
  function initCountryHubLinks(root: ParentNode = document): void {
    root
      .querySelectorAll<HTMLElement>("[data-country-hub]:not([data-linked])")
      .forEach((hub) => {
        hub.dataset.linked = "1";

        const mapShell = hub.querySelector<HTMLElement>("[data-locations-map]");
        if (!mapShell) return;

        const placeButtons = [
          ...hub.querySelectorAll<HTMLButtonElement>("[data-focus-location]"),
        ];

        const setActivePlace = (id: string | null): void => {
          for (const button of placeButtons) {
            button.classList.toggle(
              "is-active",
              id !== null && button.dataset.focusLocation === id,
            );
          }
        };

        mapShell.addEventListener("locations-map:focused", ((
          event: CustomEvent<{ id: string | null }>,
        ) => {
          setActivePlace(event.detail.id);
        }) as EventListener);

        for (const button of placeButtons) {
          button.addEventListener("click", () => {
            const id = button.dataset.focusLocation;
            if (!id) return;
            setActivePlace(id);
            mapShell.dispatchEvent(
              new CustomEvent("locations-map:focus", { detail: { id } }),
            );
          });
        }
      });
  }

  initCountryHubLinks();
  document.addEventListener("astro:page-load", () => initCountryHubLinks());
</script>
