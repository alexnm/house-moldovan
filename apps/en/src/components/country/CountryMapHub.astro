---
import CoverImage from "@shared/components/media/CoverImage.astro";
import type { Accent } from "@shared/lib/accent";
import LocationsMap from "~/components/map/LocationsMap.astro";
import { en } from "~/i18n/en";
import {
  COUNTRY_MAP_FIT_MAX_ZOOM,
  type CountryLocation,
} from "~/lib/countryPage";
import type { CountryShape } from "~/lib/countryShape";
import type { LocationMapPin } from "~/lib/mapPinData";
import type { RouteAtlas } from "~/lib/routeMap";

export interface Props {
  countryName: string;
  accent: Accent;
  locations: CountryLocation[];
  locationPins: LocationMapPin[];
  shape?: CountryShape;
  fitMaxZoom?: number;
  fitZoomOffset?: number;
  atlas?: RouteAtlas;
  atlasFocus?: string;
}

const {
  countryName,
  accent,
  locations,
  locationPins,
  shape,
  fitMaxZoom = COUNTRY_MAP_FIT_MAX_ZOOM,
  fitZoomOffset = 0,
  atlas,
  atlasFocus,
} = Astro.props;

const pinnedIds = new Set(locationPins.map((pin) => pin.locationId));
const places = locations.filter((loc) => pinnedIds.has(loc.qualifiedId));
const heading = en.places.mapHeading(countryName);
const PIN_GLYPH =
  "M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z";
---

<section id="map" class="section country-hub" data-country-hub>
  <div class="country-hub__stage map-hub-stage" data-hub-stage>
    <div class="country-hub__sidebar">
      <div class="country-hub__overview" data-hub-overview>
        <header class="map-hub-head">
          <h2 class="display map-hub-title">{heading}</h2>
        </header>
        <ul class="map-hub-list" aria-label={heading}>
          {
            places.map((place) => (
              <li>
                <button
                  type="button"
                  class="map-hub-item"
                  data-select-place={place.qualifiedId}
                >
                  <span class="map-hub-item-name">
                    <span class="map-hub-item-label">{place.name}</span>
                  </span>
                  <span class="map-hub-item-arrow" aria-hidden="true">
                    →
                  </span>
                </button>
              </li>
            ))
          }
        </ul>
      </div>

      {
        places.map((place, index) => {
          const next = places[(index + 1) % places.length]!;
          return (
            <aside
              class="country-hub__detail"
              data-place-panel={place.qualifiedId}
              aria-label={place.name}
              hidden
            >
              {place.cover ? (
                <div class="country-hub__cover text-photo-ink">
                  <CoverImage
                    src={place.cover}
                    alt={place.name}
                    widths={[480, 720, 960]}
                    sizes="(min-width: 720px) 28rem, 100vw"
                    format="avif"
                    quality={80}
                    wrapperClass="absolute inset-0"
                    class="h-full w-full object-cover"
                  />
                  <div
                    class="photo-scrim pointer-events-none absolute inset-0"
                    aria-hidden="true"
                  />
                  <div class="country-hub__cover-copy">
                    <h3 class="display photo-title-shadow country-hub__name">
                      {place.name}
                    </h3>
                    <p class="stamp country-hub__cover-location">
                      <svg
                        viewBox="0 0 24 24"
                        fill="currentColor"
                        aria-hidden="true"
                        class="country-hub__pin"
                      >
                        <path d={PIN_GLYPH} />
                      </svg>
                      {countryName}
                    </p>
                  </div>
                </div>
              ) : null}

              <div class="country-hub__body">
                {!place.cover && (
                  <h3 class="display country-hub__name">{place.name}</h3>
                )}
                {place.summary && (
                  <p class="country-hub__summary">{place.summary}</p>
                )}

                {place.articles.length > 0 ? (
                  <ul class="country-hub__articles">
                    {place.articles.map((article) => (
                      <li>
                        <a href={article.href} class="country-hub__article">
                          <img
                            src={article.thumb}
                            alt=""
                            width="56"
                            height="40"
                            loading="lazy"
                            decoding="async"
                            class="country-hub__article-thumb"
                          />
                          <span class="country-hub__article-copy">
                            <span class="micro">{article.kicker}</span>
                            <span class="country-hub__article-title">
                              {article.title}
                            </span>
                          </span>
                          <span
                            class="country-hub__row-arrow"
                            aria-hidden="true"
                          >
                            →
                          </span>
                        </a>
                      </li>
                    ))}
                  </ul>
                ) : (
                  <p class="country-hub__empty">
                    <span>{en.places.noGuideYet(place.name)}</span>
                    <a href="#stories" class="stamp country-hub__empty-link">
                      {en.places.allStories}
                    </a>
                  </p>
                )}

                <div class="country-hub__actions">
                  <button type="button" class="country-hub__back" data-hub-back>
                    {en.places.back}
                  </button>
                  {places.length > 1 && (
                    <button
                      type="button"
                      class="country-hub__next"
                      data-select-place={next.qualifiedId}
                    >
                      {en.places.nextPlace(next.name)}
                    </button>
                  )}
                </div>
              </div>
            </aside>
          );
        })
      }
    </div>

    <div class="country-hub__map">
      <LocationsMap
        pins={locationPins}
        fullBleed
        scrollZoom={false}
        fitMaxZoom={fitMaxZoom}
        fitZoomOffset={fitZoomOffset}
        height="100%"
        highlight={shape}
        fitHighlight={Boolean(shape)}
        atlas={atlas}
        atlasFocus={atlasFocus}
        labelMode="name"
        locationLabelStyle="title"
        neutralLocationStamp
        popups={false}
        focusLocations="zoom"
        countryHub
        countryAccent={accent}
      />
    </div>
  </div>
</section>

<style>
  @import "../map/mapHubIndex.css";

  .country-hub {
    scroll-margin-top: 7rem;
  }

  .country-hub__sidebar {
    position: relative;
    height: 100%;
    min-width: 0;
    min-height: 0;
    border-inline-end: 1px solid var(--color-line);
  }

  .country-hub__overview:not([hidden]),
  .country-hub__detail:not([hidden]) {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
  }

  .country-hub__overview:not([hidden]) {
    overflow: hidden;
  }

  .country-hub__detail:not([hidden]) {
    overflow-y: auto;
  }

  .country-hub__row-arrow {
    color: var(--color-ink-faint);
    font-family: var(--font-sans);
    font-size: 1.05rem;
    line-height: 1;
    transition:
      transform var(--duration-ui) var(--ease-cinema),
      color var(--duration-ui) var(--ease-cinema);
  }

  .country-hub__article:hover .country-hub__row-arrow {
    color: var(--color-ink-dim);
    transform: translateX(0.28rem);
  }

  .country-hub__cover {
    position: relative;
    flex-shrink: 0;
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }

  .country-hub__cover-copy {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    padding: clamp(1rem, 2.5vw, 1.35rem);
  }

  .country-hub__name {
    margin: 0;
    font-size: clamp(2.35rem, 3vw, 2.75rem);
    line-height: 0.9;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .country-hub__cover-location {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin: 0;
    color: color-mix(in oklch, var(--color-photo-ink) 76%, transparent);
  }

  .country-hub__pin {
    flex-shrink: 0;
    width: 1em;
    height: 1em;
    transform: translateY(-0.06em);
  }

  .country-hub__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 1rem;
    padding: clamp(1.1rem, 2.5vw, 1.5rem) clamp(1.25rem, 2.5vw, 1.65rem);
  }

  .country-hub__summary {
    margin: 0;
    color: var(--color-ink-dim);
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.6;
    text-wrap: pretty;
  }

  .country-hub__articles {
    margin: 0;
    padding: 0;
    list-style: none;
    border-block: 1px solid var(--color-line);
  }

  .country-hub__articles li + li {
    border-top: 1px solid var(--color-line);
  }

  .country-hub__article {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.75rem;
    padding-block: 0.6rem;
    color: var(--color-ink);
    text-decoration: none;
  }

  .country-hub__article-thumb {
    width: 3.5rem;
    height: 2.5rem;
    border-radius: 4px;
    object-fit: cover;
  }

  .country-hub__article-copy {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }

  .country-hub__article-title {
    font-family: var(--font-sans);
    font-size: 0.98rem;
    font-weight: 500;
    line-height: 1.25;
    transition: color var(--duration-ui) var(--ease-cinema);
  }

  .country-hub__article:hover .country-hub__article-title {
    color: var(--color-accent-ink);
  }

  .country-hub__empty {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin: 0;
    padding-block: 0.8rem;
    border-block: 1px solid var(--color-line);
    color: var(--color-ink-faint);
    font-family: var(--font-body);
    font-size: 0.92rem;
  }

  .country-hub__empty-link {
    color: var(--color-ink-dim);
    text-decoration: none;
  }

  .country-hub__empty-link:hover {
    color: var(--color-ink);
  }

  .country-hub__actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: auto;
  }

  .country-hub__back,
  .country-hub__next {
    padding: 0.5rem 0;
    border: 0;
    background: transparent;
    color: var(--color-ink-dim);
    cursor: pointer;
    font-family: var(--font-sans);
    font-size: 0.92rem;
    font-weight: 500;
    transition: color var(--duration-ui) var(--ease-cinema);
  }

  .country-hub__back:hover,
  .country-hub__next:hover {
    color: var(--color-ink);
  }

  .country-hub__map {
    height: 100%;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
  }

  @media (width < 720px) {
    .country-hub__map {
      display: none;
    }

    .country-hub__sidebar {
      border-inline-end: 0;
    }

    .country-hub__overview:not([hidden]),
    .country-hub__detail:not([hidden]) {
      position: static;
      overflow: visible;
    }
  }
</style>

<script>
  function initCountryHub(root: ParentNode = document): void {
    root
      .querySelectorAll<HTMLElement>("[data-country-hub]:not([data-linked])")
      .forEach((hub) => {
        hub.dataset.linked = "1";

        const mapShell = hub.querySelector<HTMLElement>("[data-locations-map]");
        const overview = hub.querySelector<HTMLElement>("[data-hub-overview]");
        if (!mapShell || !overview) return;

        const panels = new Map(
          [...hub.querySelectorAll<HTMLElement>("[data-place-panel]")].map(
            (panel) => [panel.dataset.placePanel!, panel] as const,
          ),
        );
        let selected: string | null = null;

        const select = (id: string | null): void => {
          if (id === selected) return;
          if (id && !panels.has(id)) return;
          selected = id;

          overview.toggleAttribute("hidden", id !== null);
          for (const [panelId, panel] of panels) {
            panel.toggleAttribute("hidden", panelId !== id);
          }

          if (id) {
            panels.get(id)!.scrollTop = 0;
            mapShell.dispatchEvent(
              new CustomEvent("locations-map:focus", { detail: { id } }),
            );
          } else {
            mapShell.dispatchEvent(new CustomEvent("locations-map:reset"));
          }
        };

        mapShell.addEventListener("locations-map:ready", () => {
          if (!selected) return;
          mapShell.dispatchEvent(
            new CustomEvent("locations-map:focus", { detail: { id: selected } }),
          );
        });

        hub.addEventListener("click", (event) => {
          const target = event.target as HTMLElement;
          const placeButton = target.closest<HTMLElement>(
            "[data-select-place]",
          );
          if (placeButton) {
            select(placeButton.dataset.selectPlace ?? null);
            return;
          }
          if (target.closest("[data-hub-back]")) select(null);
        });

        mapShell.addEventListener("locations-map:select", ((
          event: CustomEvent<{ id: string }>,
        ) => {
          select(event.detail.id);
        }) as EventListener);
      });
  }

  initCountryHub();
  document.addEventListener("astro:page-load", () => initCountryHub());
</script>
