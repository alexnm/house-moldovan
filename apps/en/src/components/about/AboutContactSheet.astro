---
/**
 * Portraits in an irregular photo grid: one 12-column grid on the default
 * gap, each photo placed with its own span so lengths and aspect ratios vary.
 * Two columns on narrow screens, wide shots spanning both.
 */
import type { ImageMetadata } from "astro";
import CoverImage from "@shared/components/media/CoverImage.astro";

export interface Print {
  image: ImageMetadata;
  alt: string;
  /** Where it was taken, e.g. "Bruges, Belgium". */
  place: string;
}

export interface Props {
  prints: Print[];
  label: string;
}

const { prints, label } = Astro.props;

const PIN_GLYPH =
  "M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z";

/**
 * Desktop placement on a 12 × 7 grid: column, column span, row, row span.
 * `wide` shots span both columns on mobile.
 */
const slots = [
  { c: 1, cs: 3, r: 1, rs: 5, wide: false },
  { c: 4, cs: 3, r: 4, rs: 4, wide: false },
  { c: 4, cs: 6, r: 1, rs: 3, wide: true },
  { c: 10, cs: 3, r: 1, rs: 4, wide: false },
  { c: 7, cs: 3, r: 4, rs: 4, wide: false },
  { c: 1, cs: 3, r: 6, rs: 2, wide: true },
  { c: 10, cs: 3, r: 5, rs: 3, wide: false },
] as const;
---

<ul class="photo-grid" aria-label={label}>
  {
    prints.slice(0, slots.length).map((print, i) => {
      const slot = slots[i]!;
      return (
        <li
          class:list={[
            "photo-grid__item motion-reveal-media",
            { "photo-grid__item--wide": slot.wide },
          ]}
          style={`--c:${slot.c};--cs:${slot.cs};--r:${slot.r};--rs:${slot.rs}`}
        >
          <figure class="photo-grid__frame shadow-rest">
            <CoverImage
              src={print.image}
              alt={print.alt}
              widths={[320, 480, 640, 960, 1280]}
              sizes="(min-width: 900px) 50vw, 100vw"
              format="avif"
              quality={80}
              loading="lazy"
              placeholder="shell"
              wrapperClass="absolute inset-0"
              class="h-full w-full object-cover"
            />
            <div class="photo-grid__scrim" aria-hidden="true" />
            <figcaption class="photo-grid__location">
              <svg
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
                class="photo-grid__pin"
              >
                <path d={PIN_GLYPH} />
              </svg>
              {print.place}
            </figcaption>
          </figure>
        </li>
      );
    })
  }
</ul>

<style>
  .photo-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--grid-gap-compact);
    margin: 0;
    padding: 0;
    list-style: none;

    @media (width >= 900px) {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      grid-template-rows: repeat(7, clamp(3.5rem, 5.5vw, 5.25rem));
    }
  }

  .photo-grid__item {
    min-width: 0;
    aspect-ratio: 4 / 5;

    @media (width >= 900px) {
      aspect-ratio: auto;
      grid-column: var(--c) / span var(--cs);
      grid-row: var(--r) / span var(--rs);
    }
  }

  .photo-grid__item--wide {
    grid-column: 1 / -1;
    aspect-ratio: 16 / 10;

    @media (width >= 900px) {
      aspect-ratio: auto;
      grid-column: var(--c) / span var(--cs);
    }
  }

  .photo-grid__frame {
    position: relative;
    height: 100%;
    margin: 0;
    overflow: hidden;
    border-radius: 2px;
  }

  .photo-grid__frame :global(img) {
    height: 100%;
    width: 100%;
    object-fit: cover;
  }

  /* Location caption: same treatment as the country highlights. */
  .photo-grid__scrim {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    z-index: 1;
    height: 30%;
    background: linear-gradient(
      to top,
      color-mix(in oklch, var(--color-photo-scrim) 70%, transparent),
      color-mix(in oklch, var(--color-photo-scrim) 40%, transparent),
      transparent
    );
    pointer-events: none;
  }

  .photo-grid__location {
    position: absolute;
    left: 0.75rem;
    bottom: 0.65rem;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 0.35rem;
    max-width: calc(100% - 1.5rem);
    color: var(--color-photo-ink);
    font-family: var(--font-sans);
    font-size: 0.7rem;
    letter-spacing: var(--tracking-microcaps);
    line-height: 1.35;
    text-transform: uppercase;
    text-shadow: 0 1px 10px
      color-mix(in oklch, var(--color-photo-scrim) 55%, transparent);
  }

  .photo-grid__pin {
    flex-shrink: 0;
    width: 1em;
    height: 1em;
    transform: translateY(-0.06em);
  }
</style>
