---
import type { ImageMetadata } from "astro";
import CoverImage from "@shared/components/media/CoverImage.astro";
import type { Accent } from "@shared/lib/accent";
import { cardAccentStyle } from "@shared/lib/accent";

export interface Props {
  href: string;
  title: string;
  kicker?: string;
  /** Subtitle under title, e.g. countries (flags + names). */
  meta?: string;
  image: ImageMetadata;
  imageAlt: string;
  size?: "md" | "lg";
  /** Override the default aspect-ratio class (e.g. "aspect-[16/9]"). */
  aspectClass?: string;
  /** Named regional accent from app.css (jade, saffron, …) */
  accent?: Accent;
  /** Line above title: continent (EN journal) or masiv name (RO hike cards). */
  regionLabel?: string;
  /** Tehnic difficulty — doubled accent tick */
  tehnic?: boolean;
  transitionName?: string;
}

const {
  href,
  title,
  kicker,
  meta,
  image,
  imageAlt,
  size = "md",
  aspectClass,
  accent,
  regionLabel,
  tehnic = false,
  transitionName,
} = Astro.props;

const aspect =
  aspectClass ??
  (size === "lg"
    ? "aspect-square md:aspect-[16/9]"
    : "aspect-square md:aspect-[3/4]");
const titleSize = "text-2xl md:text-2xl lg:text-[1.75rem]";
---

<a
  href={href}
  class:list={[
    "article-card group motion-reveal-media block h-full",
    tehnic && "article-card--tehnic",
  ]}
  style={accent ? cardAccentStyle(accent) : undefined}
>
  <figure class:list={["relative overflow-clip rounded-sm", aspect]}>
    <CoverImage
      src={image}
      alt={imageAlt}
      widths={[480, 720, 960, 1280]}
      sizes="(min-width: 1024px) 50vw, 100vw"
      format="avif"
      quality={80}
      wrapperClass="motion-hover-media absolute inset-0"
      transitionName={transitionName}
      class="absolute inset-0 h-full w-full object-cover"
    />
    <!-- Base read layer (film scrim tokens — never pure black) -->
    <div
      class="photo-scrim pointer-events-none absolute inset-0"
      aria-hidden="true"
    >
    </div>
    <!-- Region color wash (reads --card-accent from .article-card) -->
    <div
      class="article-card__tint pointer-events-none absolute inset-0"
      aria-hidden="true"
    >
    </div>
    {
      kicker && (
        <span class="stamp-badge absolute top-3 left-3 z-10 md:top-4 md:left-4">
          {kicker}
        </span>
      )
    }
    <div
      class="absolute inset-x-0 bottom-0 z-10 flex flex-col justify-end px-4 pt-20 pb-4 md:px-5 md:pb-5"
    >
      <div
        class="article-card__tick h-1 w-12 opacity-100"
        style="background: var(--card-accent, var(--color-accent))"
        aria-hidden="true"
      >
      </div>
      {
        regionLabel && (
          <p class="stamp mt-3 text-photo-ink/80">{regionLabel}</p>
        )
      }
      <h3
        class:list={[
          "display photo-title-shadow mt-2 leading-[0.94] tracking-[-0.03em] text-balance text-photo-ink normal-case",
          titleSize,
        ]}
      >
        {title}
      </h3>
      {meta && <p class="mt-2.5 text-balance text-photo-ink/80">{meta}</p>}
    </div>
  </figure>
</a>

<style>
  .article-card {
    --card-accent: var(--color-accent);
  }
  /* Beat Astro's unlayered `[data-astro-image]{height:auto}` (replaced elements
     ignore inset-stretching, so object-cover needs an explicit height). */
  .article-card figure img {
    height: 100%;
    width: 100%;
    object-fit: cover;
  }
  .article-card__tint {
    background: linear-gradient(
      to top,
      color-mix(in oklch, var(--card-accent) 42%, var(--color-photo-scrim)) 0%,
      transparent 58%
    );
    opacity: 0.6;
    /* Mask channel keywords (not painted UI color) */
    mask-image: linear-gradient(to top, black 0%, transparent 48%);
  }
</style>
