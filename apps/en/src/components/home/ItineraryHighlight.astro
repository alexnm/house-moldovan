---
import type { ImageMetadata } from "astro";
import CoverImage from "@shared/components/media/CoverImage.astro";
import { en } from "~/i18n/en";
import type { Accent } from "@shared/lib/accent";
import { cardAccentStyle } from "@shared/lib/accent";

export interface Props {
  href: string;
  title: string;
  hero: ImageMetadata;
  days: number;
  countries: { name: string; flag: string }[];
  /** Named regional accent for the photo color wash. */
  accent?: Accent;
}

const { href, title, hero, days, countries, accent } = Astro.props;
const countryLine = countries.map((c) => `${c.flag} ${c.name}`).join(" · ");
---

<li class="motion-reveal-media">
  <a
    href={href}
    class="itinerary-card group relative flex aspect-square flex-col overflow-clip rounded text-photo-ink md:aspect-[6/5] xl:aspect-[8/5]"
    style={accent ? cardAccentStyle(accent) : undefined}
  >
    <CoverImage
      src={hero}
      alt={title}
      widths={[480, 640, 800, 1024]}
      sizes="(min-width: 1024px) 50vw, 100vw"
      format="avif"
      quality={82}
      wrapperClass="motion-hover-media absolute inset-0"
      class="absolute inset-0 h-full w-full object-cover"
    />
    <div
      class="photo-scrim pointer-events-none absolute inset-0"
      aria-hidden="true"
    >
    </div>

    <div class="relative z-10 mt-auto p-4 md:p-6">
      <p class="micro text-photo-ink">{en.article.days(days)}</p>
      <h3
        class="display photo-title-shadow mt-2 text-2xl leading-[1.06] text-balance md:text-3xl"
      >
        {title}
      </h3>
      <p
        class="mt-3 max-w-[32ch] text-[0.95rem] leading-snug text-pretty text-photo-ink"
      >
        {countryLine}
      </p>
    </div>
  </a>
</li>

<style>
  .itinerary-card {
    --card-accent: var(--color-accent);
  }
</style>
