---
import CoverImage from "@shared/components/media/CoverImage.astro";
import { en } from "~/i18n/en";
import { getAllRegions } from "~/lib/regions";

const regions = await getAllRegions();
---

<section class="section section-y-lg">
  <header class="section-header flex items-baseline justify-between gap-4">
    <h2 class="display section-heading">{en.home.regionsHeading}</h2>
    <a
      href="/explore"
      class="link-more link-accent link-accent--dim hidden shrink-0 sm:inline"
    >
      {en.home.exploreCta} →
    </a>
  </header>

  <ul class="grid grid-cols-1 gap-(--grid-gap) sm:grid-cols-2 lg:grid-cols-4">
    {
      regions.map((r) => {
        const cover = r.data.images[0];
        return (
          <li class="motion-reveal-media">
            <a
              href={`/explore/region/${r.id}`}
              class="accent-scope accent-drenched region-tile motion-hover-lift-strong group relative flex aspect-square flex-col gap-16 overflow-clip rounded-sm p-5 md:aspect-4/5 md:p-6"
              data-accent={r.data.accent}
            >
              {cover && (
                <>
                  <div class="region-tile__photo" aria-hidden="true">
                    <CoverImage
                      src={cover}
                      alt=""
                      widths={[320, 480, 640]}
                      sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw"
                      format="avif"
                      quality={70}
                      placeholder="shell"
                      wrapperClass="h-full w-full"
                      class="h-full w-full object-cover"
                    />
                  </div>
                </>
              )}
              <span
                class="display pointer-events-none absolute -top-3 -right-1 z-10 text-[clamp(6rem,14vw,9rem)] leading-none opacity-[0.14] select-none"
                aria-hidden="true"
              >
                0{r.data.order}
              </span>
              <p class="stamp relative z-10 opacity-70">
                {en.region.chapter(r.data.order)}
              </p>
              <div class="relative z-10">
                <h3 class="display region-name text-[clamp(2.4rem,3.5vw,3.25rem)] leading-[0.9] tracking-[-0.035em] text-balance">
                  {r.data.name}
                </h3>
                <p class="mt-4 max-w-[26ch] font-sans text-base leading-snug text-pretty opacity-90">
                  {r.data.tagline}
                </p>
              </div>
              <div />
            </a>
          </li>
        );
      })
    }
  </ul>

  <a
    href="/explore"
    class="link-more link-accent link-accent--dim mt-(--space-block) inline-block sm:hidden"
  >
    {en.home.exploreCta} →
  </a>
</section>

<style>
  .region-tile__photo {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    z-index: 0;
    height: 56%;
    /* Fade the photo out so the tile background shows through — avoids a hard
       color seam on iOS where gradient overlays fail to match accent-drenched. */
    -webkit-mask-image: linear-gradient(to top, black 0%, transparent 80%);
    mask-image: linear-gradient(to top, black 0%, transparent 80%);
  }

  .region-tile__photo :global(.cover-image-shell),
  .region-tile__photo :global(.cover-image-shell > *) {
    height: 100%;
    width: 100%;
  }

  .region-tile__photo :global(img) {
    height: 100%;
    width: 100%;
    object-fit: cover;
  }
</style>
