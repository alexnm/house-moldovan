---
import CoverImage from "@shared/components/media/CoverImage.astro";
import { en } from "~/i18n/en";
import { getAllRegions } from "~/lib/regions";
import { regionSilhouette } from "~/lib/regionSilhouette";

const regions = await getAllRegions();
---

<section class="section section-y-lg">
  <header class="section-header flex items-baseline justify-between gap-4">
    <h2 class="display section-heading">{en.home.regionsHeading}</h2>
    <a
      href="/explore"
      class="link-more link-accent link-accent--dim hidden shrink-0 sm:inline"
    >
      {en.home.exploreCta} →
    </a>
  </header>

  <ul class="grid-tiles">
    {
      regions.map((r) => {
        const cover = r.data.cardImage;
        const shape = regionSilhouette(r.id);
        return (
          <li class="motion-reveal-media">
            <a
              href={`/explore/region/${r.id}`}
              class="accent-scope accent-drenched region-tile group relative flex aspect-square flex-col justify-end gap-4 overflow-hidden rounded-sm p-4 shadow-rest md:aspect-4/5 md:p-5"
              data-accent={r.data.accent}
            >
              {cover && (
                <>
                  <div class="region-tile__photo" aria-hidden="true">
                    <CoverImage
                      src={cover}
                      alt=""
                      widths={[320, 480, 640]}
                      sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw"
                      format="avif"
                      quality={70}
                      placeholder="shell"
                      wrapperClass="motion-hover-media h-full w-full"
                      class="h-full w-full object-cover"
                    />
                  </div>
                </>
              )}
              {shape && (
                <svg
                  class="region-tile__shape"
                  viewBox={shape.viewBox}
                  preserveAspectRatio="xMaxYMax meet"
                  aria-hidden="true"
                  focusable="false"
                >
                  {/* Opacity on the path itself so it holds even before the stylesheet loads. */}
                  <path d={shape.land} fill="currentColor" fill-opacity="0.2" />
                </svg>
              )}
              <div class="relative z-10">
                <h3 class="display region-name text-[clamp(2.4rem,3.5vw,3.25rem)] leading-[0.9] tracking-[-0.035em] text-balance">
                  {r.data.name}
                </h3>
                <p class="mt-3 max-w-[32ch] font-sans text-sm leading-snug font-medium tracking-[-0.005em] text-balance opacity-90">
                  {r.data.tagline}
                </p>
              </div>
            </a>
          </li>
        );
      })
    }
  </ul>

  <a
    href="/explore"
    class="link-more link-accent link-accent--dim mt-(--space-block) inline-block sm:hidden"
  >
    {en.home.exploreCta} →
  </a>
</section>

<style>
  /* The continent's outline as a faint watermark in the bottom-right corner,
     behind the copy. */
  .region-tile__shape {
    position: absolute;
    bottom: 0.75rem;
    right: 0.25rem;
    z-index: 1;
    width: 58%;
    max-height: 42%;
    pointer-events: none;
    fill: currentColor;
  }

  .region-tile__photo {
    position: absolute;
    inset-inline: 0;
    top: 0;
    z-index: 0;
    height: 62%;
    overflow: hidden;
    /* Photo on top, fading down into the strong colour where the copy sits.
       A mask (not an overlay) so there's no colour seam on iOS where gradient
       overlays fail to match accent-drenched. */
    -webkit-mask-image: linear-gradient(to bottom, black 45%, transparent 100%);
    mask-image: linear-gradient(to bottom, black 45%, transparent 100%);
  }

  .region-tile__photo :global(.cover-image-shell),
  .region-tile__photo :global(.cover-image-shell > *) {
    height: 100%;
    width: 100%;
  }

  .region-tile__photo :global(img) {
    height: 100%;
    width: 100%;
    object-fit: cover;
  }
</style>
