---
/**
 * Home "The family travel journal": the authors' note as the same card the
 * region and about pages use, with four passport stamps (one per region, the
 * latest visit) hinting at the country pages and the about-page passport.
 */
import CoverImage from "@shared/components/media/CoverImage.astro";
import { accentInkVar, type Accent } from "@shared/lib/accent";
import PassportStamp from "~/components/country/PassportStamp.astro";
import { en } from "~/i18n/en";
import { getPublishedPlaces } from "~/lib/content";
import { getAllRegions, regionIdFromPlace } from "~/lib/regions";
import portrait from "~/assets/about/alex-mela.JPG";

const VARIANTS = ["round", "rect", "oval", "rect"] as const;
const TILTS = [-9, 6, -4, 10] as const;

const [places, regions] = await Promise.all([
  getPublishedPlaces(),
  getAllRegions(),
]);

/** Per region: the country visited most recently (ties broken by name). */
const stamps = [...regions]
  .sort((a, b) => a.data.order - b.data.order)
  .flatMap((region) => {
    const latest = places
      .filter((p) => regionIdFromPlace(p) === region.id)
      .flatMap((p) => p.data.visits.map((visit) => ({ place: p, visit })))
      .sort(
        (a, b) =>
          b.visit.year - a.visit.year ||
          a.place.data.name.localeCompare(b.place.data.name),
      )[0];
    if (!latest) return [];
    const accent: Accent = latest.place.data.accent ?? region.data.accent;
    return [{ ...latest, accent }];
  })
  .slice(0, 4)
  .map((stamp, i) => ({
    ...stamp,
    variant: VARIANTS[i % VARIANTS.length]!,
    rotate: TILTS[i % TILTS.length]!,
  }));
---

<section id="note" class="section section-y scroll-mt-20">
  <figure class="home-note motion-reveal shadow-rest">
    <span class="home-note__mark" aria-hidden="true">“</span>

    <div class="home-note__portrait">
      <div class="home-note__clip">
        <CoverImage
          src={portrait}
          alt={en.home.about.portraitAlt}
          widths={[160, 240, 320]}
          sizes="9rem"
          format="avif"
          quality={82}
          placeholder="blur"
          wrapperClass="absolute inset-0"
          class="h-full w-full object-cover object-[center_28%]"
        />
      </div>
    </div>

    <div class="home-note__body">
      <p class="stamp home-note__kicker">{en.home.about.editorialKicker}</p>
      <h2 class="display section-heading">{en.home.about.heading}</h2>
      <blockquote class="home-note__text">
        <p>
          Hi there, fellow travelers! We are Mela and Alex, the two people
          behind House Moldovan. We are based in Romania and we've been
          travelling together since 2012.
        </p>
        <p>
          We visited over 40 countries and are eager to share our experiences
          with you. 👶 Edi is our little travel companion and he's been part of
          our travels since 2024.
        </p>
        <p>
          We started this site to keep our travel writing and photography in one
          place: honest impressions from the trips we took, organized so you can <a
            href="/explore">browse by region</a
          > or follow along in
          <a href="/journal">the journal</a>.
        </p>
      </blockquote>
      <figcaption class="home-note__caption">
        <span>— {en.authorNote.signature}</span>
        <a
          href="/about#passport"
          class="link-more link-accent link-accent--dim"
        >
          {en.home.about.passportCta} →
        </a>
      </figcaption>
    </div>

    {
      stamps.length > 0 && (
        <ul class="home-note__stamps" aria-hidden="true">
          {stamps.map((stamp, i) => (
            <li
              class="home-note__stamp"
              style={`color: ${accentInkVar(stamp.accent)}`}
            >
              <PassportStamp
                id={`home-${stamp.place.id}-${stamp.visit.year}`}
                variant={stamp.variant}
                country={stamp.place.data.name}
                localName={stamp.place.data.localName}
                forceLocalName={stamp.place.data.stampLocalName}
                year={stamp.visit.year}
                label={stamp.visit.label}
                rotate={stamp.rotate}
                seed={11 + i * 13}
              />
            </li>
          ))}
        </ul>
      )
    }
  </figure>
</section>

<style>
  /* Same card as the region and about pages' "A note from us". */
  .home-note {
    --note-bg: var(--color-surface-2);
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1.25rem;
    align-items: start;
    margin: 0;
    overflow: hidden;
    padding: clamp(1.5rem, 4vw, 3.25rem);
    border-radius: 8px;
    border-left: 4px solid var(--color-accent);
    background: var(--note-bg);

    @media (width >= 768px) {
      gap: 2.25rem;
    }

    @media (width >= 1100px) {
      grid-template-columns: auto minmax(0, 1fr) minmax(16rem, 22rem);
    }
  }

  :global(html[data-theme="light"]) .home-note {
    border: 1px solid var(--color-line);
    border-left: 4px solid var(--color-accent);
  }

  .home-note__mark {
    position: absolute;
    top: clamp(1rem, 2.5vw, 2rem);
    right: clamp(1.25rem, 3vw, 2.5rem);
    font-family: var(--font-display);
    font-size: clamp(7rem, 12vw, 11rem);
    line-height: 0.62;
    color: var(--color-accent);
    opacity: 0.5;
    pointer-events: none;
  }

  .home-note__portrait {
    position: relative;
    width: 4.5rem;
    aspect-ratio: 1;
    border-radius: 50%;
    box-shadow:
      0 0 0 4px var(--note-bg),
      0 0 0 5px var(--color-line-strong);

    @media (width >= 768px) {
      width: 7rem;
    }
  }

  .home-note__clip {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: 50%;
  }

  .home-note__body {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-width: 0;
  }

  .home-note__kicker {
    margin: 0;
    color: var(--color-accent-ink);
  }

  .home-note__body :global(.section-heading) {
    margin: 0;
  }

  .home-note__text {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 68ch;
    margin: 0;
    font-family: var(--font-body);
    font-size: clamp(1.05rem, 0.95rem + 0.35vw, 1.25rem);
    line-height: 1.6;
    color: var(--color-ink);
    text-wrap: pretty;
  }

  .home-note__text p {
    margin: 0;
  }

  .home-note__text a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }

  /* Signature left, passport link flush with the paragraphs' right edge. */
  .home-note__caption {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    color: var(--color-ink);
  }

  /* Four stamps scattered beside the note; below it on narrower screens. */
  .home-note__stamps {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
    pointer-events: none;

    @media (width >= 1100px) {
      grid-column: 3;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      /* Centred on the card's height. The even stamps drop 1.5rem with a
         transform (outside layout), so reserve that space at the bottom to
         keep the visible group centred. */
      align-self: center;
      justify-items: center;
      gap: 1.75rem 0.5rem;
      padding-bottom: 1.5rem;
    }
  }

  .home-note__stamp:nth-child(even) {
    @media (width >= 1100px) {
      transform: translateY(1.5rem);
    }
  }

  /* Below sm the portrait joins the signature row, as on the country card. */
  @media (width < 640px) {
    .home-note {
      grid-template-columns: auto minmax(0, 1fr);
      column-gap: 0.75rem;
      row-gap: 1rem;
      align-items: center;
    }

    .home-note__body {
      display: contents;
    }

    .home-note__kicker,
    .home-note__body :global(.section-heading),
    .home-note__text {
      grid-column: 1 / -1;
    }

    .home-note__kicker {
      order: 1;
    }

    .home-note__body :global(.section-heading) {
      order: 2;
    }

    .home-note__text {
      order: 3;
    }

    .home-note__portrait {
      order: 4;
      width: 3.5rem;
      align-self: center;
      box-shadow:
        0 0 0 3px var(--note-bg),
        0 0 0 4px var(--color-line-strong);
    }

    .home-note__caption {
      order: 5;
      align-self: center;
      align-items: center;
    }

    .home-note__stamps {
      order: 6;
      align-self: stretch;
    }
  }
</style>
