---
import type { ImageMetadata } from "astro";
import CoverImage from "@shared/components/media/CoverImage.astro";
import type { Accent } from "@shared/lib/accent";
import { cardAccentStyle } from "@shared/lib/accent";

export interface Props {
  href: string;
  name: string;
  flag: string;
  tagline: string;
  image?: ImageMetadata;
  imageAlt?: string;
  /** Named regional accent for the photo color wash. */
  accent?: Accent;
}

const { href, name, flag, tagline, image, imageAlt, accent } = Astro.props;
const alt = imageAlt ?? `Scenes from ${name}`;
const onPhoto = image != null;
---

<li class="motion-reveal-media">
  <a
    href={href}
    class:list={[
      "country-card group relative flex aspect-square flex-col overflow-clip rounded-sm md:aspect-4/5",
      onPhoto ? "text-photo-ink" : "bg-surface-2 text-ink",
    ]}
    style={accent ? cardAccentStyle(accent) : undefined}
  >
    {
      image && (
        <>
          <CoverImage
            src={image}
            alt={alt}
            widths={[320, 480, 640, 800]}
            sizes="(min-width: 1280px) 25vw, (min-width: 768px) 33vw, (min-width: 640px) 50vw, 100vw"
            format="avif"
            quality={82}
            wrapperClass="motion-hover-media absolute inset-0"
            class="absolute inset-0 h-full w-full object-cover"
          />
          <div
            class="photo-scrim pointer-events-none absolute inset-0"
            aria-hidden="true"
          />
          {accent && (
            <div
              class="country-card__tint pointer-events-none absolute inset-0"
              aria-hidden="true"
            />
          )}
        </>
      )
    }

    <div class="relative z-10 mt-auto px-4 pb-4 md:px-5 md:pb-5">
      <h3
        class="display photo-title-shadow flex flex-wrap items-baseline gap-x-2 text-[clamp(2.35rem,3vw,2.75rem)] leading-[0.9] tracking-[-0.035em] text-balance"
        class:list={[!onPhoto && "text-ink"]}
      >
        <span aria-hidden="true">{flag}</span>
        <span>{name}</span>
      </h3>
      <p
        class="mt-3 max-w-[26ch] font-sans text-[0.95rem] leading-snug text-pretty"
        class:list={[onPhoto ? "text-photo-ink/85" : "text-ink-dim"]}
      >
        {tagline}
      </p>
    </div>
  </a>
</li>

<style>
  .country-card {
    --card-accent: var(--color-accent);
  }
  /* Beat Astro's unlayered `[data-astro-image]{height:auto}` (replaced elements
     ignore inset-stretching, so object-cover needs an explicit height). */
  .country-card img {
    height: 100%;
    width: 100%;
    object-fit: cover;
  }
  .country-card__tint {
    background: linear-gradient(
      to top,
      color-mix(in oklch, var(--card-accent) 38%, var(--color-photo-scrim)) 0%,
      transparent 58%
    );
    opacity: 0.55;
    mask-image: linear-gradient(to top, black 0%, transparent 50%);
  }
</style>
