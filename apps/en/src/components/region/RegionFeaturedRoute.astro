---
import type { ImageMetadata } from "astro";
import CoverImage from "@shared/components/media/CoverImage.astro";
import { en } from "~/i18n/en";
import type { Accent } from "@shared/lib/accent";
import { cardAccentStyle } from "@shared/lib/accent";

export interface Props {
  href: string;
  title: string;
  summary: string;
  hero: ImageMetadata;
  days: number;
  countries: { name: string; flag: string }[];
  accent: Accent;
  /** Full-viewport cinematic vs contained landscape. */
  size?: "hero" | "plate";
}

const {
  href,
  title,
  summary,
  hero,
  days,
  countries,
  accent,
  size = "hero",
} = Astro.props;

const countryLine = countries.map((c) => `${c.flag} ${c.name}`).join(" · ");
const kicker = `${en.article.itinerary} · ${en.article.days(days)}`;
---

<a
  href={href}
  class:list={[
    "region-route group relative flex flex-col overflow-clip text-photo-ink",
    size === "hero" ? "region-route--hero" : "region-route--plate rounded-sm",
  ]}
  style={cardAccentStyle(accent)}
>
  <CoverImage
    src={hero}
    alt={title}
    widths={size === "hero" ? [960, 1280, 1600, 1920] : [720, 960, 1280, 1600]}
    sizes={size === "hero" ? "100vw" : "(min-width: 900px) 60vw, 100vw"}
    format="avif"
    quality={82}
    wrapperClass="motion-hover-media absolute inset-0"
    class="absolute inset-0 h-full w-full object-cover"
  />
  <div
    class="photo-scrim pointer-events-none absolute inset-0"
    aria-hidden="true"
  >
  </div>
  <div class="region-route__copy">
    <span class="stamp-badge">{kicker}</span>
    <h3 class="region-route__title display">{title}</h3>
    <p class="region-route__summary">{summary}</p>
    <p class="region-route__countries">{countryLine}</p>
  </div>
</a>

<style>
  .region-route {
    isolation: isolate;
    min-height: clamp(28rem, 78svh, 46rem);
    text-decoration: none;
    color: inherit;
  }

  .region-route--plate {
    min-height: clamp(20rem, 48svh, 30rem);
  }

  .region-route__copy {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    margin-top: auto;
    padding: 1.5rem 1.25rem 1.75rem;
    width: 100%;
  }

  .region-route--hero .region-route__copy {
    max-width: var(--container-wide);
    margin-inline: auto;

    @media (width >= 768px) {
      padding: 2.5rem 1.5rem 2.75rem;
    }

    @media (width >= 1536px) {
      max-width: var(--width-canvas);
    }
  }

  .region-route--plate .region-route__copy {
    padding: 1.15rem 1.15rem 1.35rem;

    @media (width >= 768px) {
      padding: 1.35rem 1.35rem 1.5rem;
    }
  }

  .region-route__title {
    margin-top: 0.85rem;
    max-width: 30ch;
    font-size: clamp(2.4rem, 6vw, 5.25rem);
    line-height: 0.88;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  .region-route--plate .region-route__title {
    font-size: clamp(1.85rem, 2.6vw, 3.15rem);
  }

  .region-route__summary {
    margin-top: 1rem;
    max-width: 46ch;
    font-family: var(--font-body);
    font-size: clamp(1.05rem, 0.95rem + 0.35vw, 1.2rem);
    line-height: 1.45;
    text-wrap: pretty;
    color: var(--color-photo-ink);
    opacity: 0.92;
  }

  .region-route--plate .region-route__summary {
    margin-top: 0.7rem;
    max-width: 38ch;
    font-size: 1rem;
    line-height: 1.4;
  }

  .region-route__countries {
    margin-top: 0.85rem;
    max-width: 42ch;
    font-family: var(--font-sans);
    font-size: 0.95rem;
    line-height: 1.4;
    color: var(--color-photo-ink);
    opacity: 0.85;
  }

  .region-route--plate .region-route__countries {
    margin-top: 0.65rem;
    font-size: 0.9rem;
  }

  .region-route img {
    height: 100%;
    width: 100%;
    object-fit: cover;
  }
</style>
