---
import { getImage } from "astro:assets";
import LocationsMap from "~/components/map/LocationsMap.astro";
import { en } from "~/i18n/en";
import {
  countryMapFitMaxZoom,
  countryMapFitZoomOffset,
  MAP_FIXED_LOCATION_POPUP,
  placeHasBody,
} from "~/lib/countryPage";
import type { LocationMapPin } from "~/lib/mapPinData";
import { placeCoverLocationLabel } from "~/lib/locations";
import { firstParagraph, renderMarkdownFragment } from "~/lib/markdownFragment";
import type { Accent } from "@shared/lib/accent";
import type { RegionCountry } from "~/lib/regionPage";
import type { RouteAtlas } from "~/lib/routeMap";
import { placeShortName } from "~/lib/articlePlaces";

export interface Props {
  countries: RegionCountry[];
  locationPins: LocationMapPin[];
  atlas?: RouteAtlas;
  regionAccent: Accent;
}

const { countries, locationPins, atlas, regionAccent } = Astro.props;

const heading = en.region.countriesHeading;
const regionCountryNames = countries.map((country) => country.name);

const countryCopy = await Promise.all(
  countries.map(async (country) => {
    const hasBody = placeHasBody(country.country);
    if (hasBody) {
      const bodyHtml = await renderMarkdownFragment(
        firstParagraph(country.country.body),
      );
      return {
        id: country.id,
        hasBody: Boolean(bodyHtml),
        tagline: country.tagline,
        bodyHtml,
      };
    }
    return {
      id: country.id,
      hasBody: false,
      tagline: country.tagline,
      bodyHtml: "",
    };
  }),
);

const hubPayload = await Promise.all(
  countries.map(async (country) => {
    const hero = country.cover ?? country.thumbnail;
    let coverSrc: string | undefined;
    let coverSrcSet: string | undefined;
    if (hero) {
      const w480 = await getImage({ src: hero, width: 480, format: "avif" });
      const w720 = await getImage({ src: hero, width: 720, format: "avif" });
      const w960 = await getImage({ src: hero, width: 960, format: "avif" });
      coverSrc = w720.src;
      coverSrcSet = `${w480.src} 480w, ${w720.src} 720w, ${w960.src} 960w`;
    }
    return {
      id: country.id,
      name: country.name,
      flag: country.flag,
      href: country.href,
      exploreLabel: en.region.exploreCountry(placeShortName(country.country)),
      coverLocation: await placeCoverLocationLabel(country.country),
      coverSrc,
      coverSrcSet,
      rings: country.rings,
      pinIds: country.pinIds,
      maxZoom: countryMapFitMaxZoom(country.id),
      zoomOffset: countryMapFitZoomOffset(country.id),
      accent: country.accent,
    };
  }),
);

const regionCountryAccents = Object.fromEntries(
  countries.map((country) => [country.name, country.accent]),
);
---

<section id="map" class="section region-map-hub" data-region-hub>
  <div class="region-map-hub__stage">
    <div class="region-map-hub__sidebar">
      <div class="region-map-hub__overview" data-hub-overview>
        <header class="region-map-hub__panel-head">
          <h2 class="display region-map-hub__panel-title">{heading}</h2>
          <p class="region-map-hub__hint">{en.region.mapHint}</p>
        </header>
        <ul class="map-hub-list region-map-hub__list" aria-label={heading}>
          {
            countries.map((country) => (
              <li>
                <button
                  type="button"
                  class="map-hub-item region-map-hub__country"
                  data-focus-country={country.id}
                >
                  <span class="map-hub-item-name region-map-hub__list-name">
                    <span class="region-map-hub__list-flag" aria-hidden="true">
                      {country.flag}
                    </span>
                    {country.name}
                  </span>
                  <span class="region-map-hub__row-arrow" aria-hidden="true">
                    →
                  </span>
                </button>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="region-map-hub__detail" data-hub-detail hidden>
        <aside class="region-map-hub__card" aria-live="polite">
          <div
            class="region-map-hub__cover text-photo-ink"
            data-hub-cover-wrap
            hidden
          >
            <img
              class="region-map-hub__cover-img"
              data-hub-cover
              alt=""
              width="960"
              height="600"
            />
            <div
              class="photo-scrim pointer-events-none absolute inset-0"
              aria-hidden="true"
            >
            </div>
            <div class="region-map-hub__cover-copy">
              <h3
                class="display photo-title-shadow region-map-hub__cover-name"
                data-hub-title
              >
              </h3>
              <p
                class="stamp region-map-hub__cover-location"
                data-hub-cover-location
                hidden
              >
                <svg
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  aria-hidden="true"
                  class="region-map-hub__cover-pin"
                >
                  <path
                    d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"
                  ></path>
                </svg>
                <span data-hub-cover-location-text></span>
              </p>
            </div>
          </div>
          <div class="region-map-hub__card-body">
            <h3
              class="region-map-hub__card-name display"
              data-hub-title-fallback
              hidden
            >
            </h3>
            <div class="region-map-hub__copy" data-hub-copy-mount></div>
            <div class="region-map-hub__actions">
              <button type="button" class="region-map-hub__back" data-hub-back>
                <span aria-hidden="true">←</span>
                <span>{en.region.allCountries}</span>
              </button>
              <a class="region-map-hub__explore" data-hub-explore href="#">
                <span data-hub-explore-label></span>
                <span aria-hidden="true">→</span>
              </a>
            </div>
          </div>
        </aside>
      </div>
    </div>

    <div class="region-map-hub__map shadow-rest">
      <LocationsMap
        pins={locationPins}
        fullBleed
        scrollZoom={false}
        fitMaxZoom={7}
        height="clamp(28rem, 68svh, 44rem)"
        labelMode="full"
        locationLabelStyle="title"
        neutralLocationStamp
        locationOnlyPopup
        focusLocations={MAP_FIXED_LOCATION_POPUP ? "popup" : "zoom"}
        atlas={atlas}
        regionHub
        regionCountryNames={regionCountryNames}
        regionCountryAccents={regionCountryAccents}
        regionAccent={regionAccent}
      />
    </div>
  </div>

  <div data-hub-body-sources hidden>
    {
      countryCopy.map(({ id, hasBody, tagline, bodyHtml }) => (
        <div data-hub-body-source={id} hidden>
          {hasBody && bodyHtml ? (
            <div class="prose-body region-map-hub__prose" set:html={bodyHtml} />
          ) : (
            <div class="prose-body region-map-hub__prose">
              <p>{tagline}</p>
            </div>
          )}
        </div>
      ))
    }
  </div>

  <script
    type="application/json"
    data-hub-payload
    is:inline
    set:html={JSON.stringify(hubPayload)}
  />
</section>

<style>
  @import "../map/mapHubIndex.css";

  .region-map-hub {
    scroll-margin-top: 7rem;
  }

  .region-map-hub__panel-head {
    display: flex;
    flex-shrink: 0;
    flex-direction: column;
    gap: 0.45rem;
    padding: clamp(1.25rem, 2.5vw, 1.65rem);
    padding-block-end: clamp(0.85rem, 2vw, 1.1rem);
    border-bottom: 1px solid var(--color-line);
  }

  .region-map-hub__panel-title {
    margin: 0;
    font-size: clamp(2rem, 1.35rem + 2.2vw, 2.75rem);
    line-height: 0.95;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .region-map-hub__stage[data-has-selection="1"] .region-map-hub__hint {
    display: none;
  }

  .region-map-hub__hint {
    max-width: 42ch;
    margin: 0;
    color: var(--color-ink-dim);
    font-family: var(--font-body);
    font-size: 0.95rem;
    line-height: 1.5;
    text-wrap: pretty;
  }

  .region-map-hub__stage {
    display: grid;
    grid-template-columns: minmax(25rem, 34%) minmax(0, 1fr);
    align-items: stretch;
    width: 100%;
    min-height: clamp(28rem, 68svh, 44rem);
    border-radius: 4px;
    overflow: hidden;
    background: var(--color-surface-2);
    box-shadow: var(--shadow-rest);
  }

  /* Neutral outline only on the paper canvas; dark mode relies on tonal lift. */
  :global(html[data-theme="light"]) .region-map-hub__stage {
    border: 1px solid var(--color-line);
  }

  .region-map-hub__sidebar {
    display: flex;
    flex-direction: column;
    min-height: 0;
    overflow: hidden;
    border-inline-end: 1px solid var(--color-line);
  }

  .region-map-hub__overview:not([hidden]),
  .region-map-hub__detail:not([hidden]) {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-height: 0;
    overflow-y: auto;
  }

  .region-map-hub__list {
    margin: 0;
    border-top: 0;
  }

  .region-map-hub__country {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.75rem;
    padding-inline: clamp(1.25rem, 2.5vw, 1.65rem);
    padding-block: 0.85rem;
    transition:
      background-color var(--duration-ui) var(--ease-cinema),
      color var(--duration-ui) var(--ease-cinema);
  }

  .region-map-hub__country:hover {
    background: color-mix(in oklch, var(--color-ink) 5%, transparent);
  }

  .region-map-hub__list-name {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    min-width: 0;
  }

  .region-map-hub__list-flag {
    flex-shrink: 0;
    font-size: 1.05rem;
    line-height: 1;
  }

  .region-map-hub__row-arrow {
    color: var(--color-ink-faint);
    font-family: var(--font-sans);
    font-size: 1.05rem;
    font-weight: 400;
    line-height: 1;
    transform: translateX(0);
    transition:
      transform var(--duration-ui) var(--ease-cinema),
      color var(--duration-ui) var(--ease-cinema);
  }

  .region-map-hub__country:hover .region-map-hub__row-arrow,
  .region-map-hub__country.is-active .region-map-hub__row-arrow {
    color: var(--color-ink-dim);
    transform: translateX(0.28rem);
  }

  .region-map-hub__country.is-active {
    color: var(--color-ink);
    background: color-mix(in oklch, var(--color-ink) 6%, transparent);
  }

  .region-map-hub__card {
    display: flex;
    flex: 1;
    flex-direction: column;
    width: 100%;
    min-height: 0;
  }

  .region-map-hub__cover {
    position: relative;
    flex-shrink: 0;
    overflow: hidden;
  }

  .region-map-hub__cover[hidden] {
    display: none;
  }

  .region-map-hub__cover-img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    filter: var(--image-filter);
  }

  .region-map-hub__cover-copy {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    padding: clamp(1rem, 2.5vw, 1.35rem);
  }

  .region-map-hub__cover-name {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
    margin: 0;
    font-size: clamp(2.35rem, 3vw, 2.75rem);
    line-height: 0.9;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .region-map-hub__cover-location {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin: 0;
    color: color-mix(in oklch, var(--color-photo-ink) 76%, transparent);
  }

  .region-map-hub__cover-pin {
    flex-shrink: 0;
    width: 1em;
    height: 1em;
    transform: translateY(-0.06em);
  }

  .region-map-hub__card-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.85rem;
    min-height: 0;
    padding: clamp(1.1rem, 2.5vw, 1.65rem);
  }

  .region-map-hub__copy {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-height: 0;
    overflow-y: auto;
  }

  .region-map-hub__prose {
    max-width: none;
    font-size: 1rem;
  }

  .region-map-hub__prose :where(p:first-child) {
    margin-top: 0;
  }

  .region-map-hub__prose :where(p:last-child) {
    margin-bottom: 0;
  }

  .region-map-hub__card-name {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
    margin: 0;
    font-size: clamp(2.35rem, 3vw, 2.75rem);
    line-height: 0.9;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .region-map-hub__flag {
    flex-shrink: 0;
    font-size: 0.72em;
    line-height: 1;
  }

  .region-map-hub__actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: auto;
  }

  .region-map-hub__explore {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    flex-shrink: 0;
    padding: 0.7rem 1.15rem;
    border-radius: 6px;
    background: var(--color-accent);
    color: var(--accent-ink);
    font-family: var(--font-sans);
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.2;
    text-decoration: none;
    transition: filter var(--duration-ui) var(--ease-cinema);
  }

  .region-map-hub__explore:hover {
    filter: brightness(1.06);
  }

  .region-map-hub__back {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0;
    border: 0;
    background: transparent;
    color: var(--color-ink-faint);
    cursor: pointer;
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    line-height: 1.3;
    text-transform: uppercase;
    transition: color var(--duration-ui) var(--ease-cinema);
  }

  .region-map-hub__back:hover {
    color: var(--color-ink);
  }

  .region-map-hub__map {
    overflow: hidden;
    min-height: 0;
    min-width: 0;
    border-radius: 0;
    box-shadow: none;
  }

  .locations-map-shell .locations-map--region-hub {
    cursor: grab;
  }

  .locations-map-shell .locations-map--region-hub.leaflet-dragging {
    cursor: grabbing;
  }

  @media (width < 720px) {
    .region-map-hub__stage {
      display: block;
      min-height: 0;
    }

    .region-map-hub__hint {
      display: none;
    }

    .region-map-hub__map {
      display: none;
    }

    .region-map-hub__sidebar {
      display: block;
      max-height: none;
      overflow: visible;
      border-inline-end: 0;
    }

    .region-map-hub__overview:not([hidden]),
    .region-map-hub__detail:not([hidden]) {
      flex: none;
      min-height: auto;
      overflow: visible;
    }

    .region-map-hub__card,
    .region-map-hub__copy {
      flex: none;
      min-height: auto;
      overflow: visible;
    }
  }
</style>

<script>
  type HubCountry = {
    id: string;
    name: string;
    flag: string;
    href: string;
    exploreLabel: string;
    coverLocation?: string;
    coverSrc?: string;
    coverSrcSet?: string;
    rings: [number, number][][];
    pinIds: string[];
    maxZoom: number;
    zoomOffset: number;
  };

  function initRegionHub(root: ParentNode = document): void {
    root
      .querySelectorAll<HTMLElement>("[data-region-hub]:not([data-linked])")
      .forEach((hub) => {
        hub.dataset.linked = "1";

        const mapShell = hub.querySelector<HTMLElement>("[data-locations-map]");
        const stage = hub.querySelector<HTMLElement>(".region-map-hub__stage");
        const overview = hub.querySelector<HTMLElement>("[data-hub-overview]");
        const detail = hub.querySelector<HTMLElement>("[data-hub-detail]");
        const coverWrap = hub.querySelector<HTMLElement>(
          "[data-hub-cover-wrap]",
        );
        const coverImg =
          hub.querySelector<HTMLImageElement>("[data-hub-cover]");
        const titleEl = hub.querySelector<HTMLElement>("[data-hub-title]");
        const titleFallback = hub.querySelector<HTMLElement>(
          "[data-hub-title-fallback]",
        );
        const coverLocationRow = hub.querySelector<HTMLElement>(
          "[data-hub-cover-location]",
        );
        const coverLocationText = hub.querySelector<HTMLElement>(
          "[data-hub-cover-location-text]",
        );
        const copyMount = hub.querySelector<HTMLElement>(
          "[data-hub-copy-mount]",
        );
        const bodySources = hub.querySelector<HTMLElement>(
          "[data-hub-body-sources]",
        );
        const exploreLink =
          hub.querySelector<HTMLAnchorElement>("[data-hub-explore]");
        const exploreLabel = hub.querySelector<HTMLElement>(
          "[data-hub-explore-label]",
        );
        const payloadEl =
          hub.querySelector<HTMLScriptElement>("[data-hub-payload]");
        if (
          !mapShell ||
          !payloadEl?.textContent ||
          !stage ||
          !overview ||
          !detail ||
          !coverWrap ||
          !coverImg ||
          !titleEl ||
          !titleFallback ||
          !coverLocationRow ||
          !coverLocationText ||
          !copyMount ||
          !bodySources ||
          !exploreLink ||
          !exploreLabel
        )
          return;

        const countries = JSON.parse(payloadEl.textContent) as HubCountry[];
        const countryById = new Map(
          countries.map((country) => [country.id, country]),
        );
        const countryByName = new Map(
          countries.map((country) => [country.name, country]),
        );
        const countryButtons = [
          ...hub.querySelectorAll<HTMLButtonElement>("[data-focus-country]"),
        ];
        const backButton =
          hub.querySelector<HTMLButtonElement>("[data-hub-back]");

        let selected: string | null = null;

        const setActiveListItem = (id: string | null): void => {
          for (const button of countryButtons) {
            button.classList.toggle(
              "is-active",
              id !== null && button.dataset.focusCountry === id,
            );
          }
        };

        const fillTitle = (el: HTMLElement, country: HubCountry): void => {
          el.textContent = "";
          const flag = document.createElement("span");
          flag.className = "region-map-hub__flag";
          flag.setAttribute("aria-hidden", "true");
          flag.textContent = country.flag;
          el.append(flag, document.createTextNode(country.name));
        };

        const fillCopy = (id: string): void => {
          const source = bodySources.querySelector<HTMLElement>(
            `[data-hub-body-source="${id}"]`,
          );
          copyMount.replaceChildren();
          if (!source) return;
          for (const node of source.childNodes) {
            copyMount.append(node.cloneNode(true));
          }
        };

        const fillDetail = (country: HubCountry): void => {
          fillTitle(titleEl, country);
          fillTitle(titleFallback, country);
          fillCopy(country.id);

          exploreLink.href = country.href;
          exploreLabel.textContent = country.exploreLabel;

          if (country.coverLocation) {
            coverLocationText.textContent = country.coverLocation;
            coverLocationRow.removeAttribute("hidden");
          } else {
            coverLocationText.textContent = "";
            coverLocationRow.setAttribute("hidden", "");
          }

          if (country.coverSrc) {
            coverImg.src = country.coverSrc;
            if (country.coverSrcSet) {
              coverImg.srcset = country.coverSrcSet;
            } else {
              coverImg.removeAttribute("srcset");
            }
            coverWrap.removeAttribute("hidden");
            titleFallback.setAttribute("hidden", "");
          } else {
            coverImg.removeAttribute("src");
            coverImg.removeAttribute("srcset");
            coverWrap.setAttribute("hidden", "");
            titleFallback.removeAttribute("hidden");
          }
        };

        const showOverview = (): void => {
          overview.removeAttribute("hidden");
          detail.setAttribute("hidden", "");
          stage.dataset.hasSelection = "";
          setActiveListItem(null);
        };

        const showDetail = (country: HubCountry): void => {
          fillDetail(country);
          overview.setAttribute("hidden", "");
          detail.removeAttribute("hidden");
          stage.dataset.hasSelection = "1";
          setActiveListItem(country.id);
        };

        const highlightCountry = (
          country: HubCountry | undefined,
          fit: boolean,
        ): void => {
          mapShell.dispatchEvent(
            new CustomEvent("locations-map:highlight", {
              detail: {
                rings: country?.rings ?? [],
                ids: country?.pinIds ?? [],
                fit,
                maxZoom: country?.maxZoom,
                zoomOffset: country?.zoomOffset ?? 0,
                focus: country?.name ?? null,
              },
            }),
          );
        };

        const previewCountry = (country: HubCountry | null): void => {
          mapShell.dispatchEvent(
            new CustomEvent("locations-map:preview", {
              detail: { focus: country?.name ?? null },
            }),
          );
        };

        mapShell.addEventListener("locations-map:ready", () => {
          if (!selected) return;
          const country = countryById.get(selected);
          if (country) highlightCountry(country, true);
        });

        const selectCountry = (id: string | null): void => {
          if (id && id === selected) return;

          selected = id;

          if (!id) {
            previewCountry(null);
            showOverview();
            mapShell.dispatchEvent(new CustomEvent("locations-map:reset"));
            return;
          }

          const country = countryById.get(id);
          if (!country) return;

          showDetail(country);
          highlightCountry(country, true);
        };

        mapShell.addEventListener("locations-map:country-select", ((
          event: CustomEvent<{ name: string }>,
        ) => {
          const country = countryByName.get(event.detail.name);
          if (!country) return;
          selectCountry(country.id);
        }) as EventListener);

        for (const button of countryButtons) {
          button.addEventListener("click", () => {
            selectCountry(button.dataset.focusCountry ?? null);
          });
          button.addEventListener("mouseenter", () => {
            if (selected) return;
            const country = countryById.get(button.dataset.focusCountry ?? "");
            if (country) previewCountry(country);
          });
          button.addEventListener("mouseleave", () => {
            if (selected) return;
            previewCountry(null);
          });
        }

        backButton?.addEventListener("click", () => selectCountry(null));
      });
  }

  initRegionHub();
  document.addEventListener("astro:page-load", () => initRegionHub());
</script>
