---
import type { Accent } from "@shared/lib/accent";
import { en } from "~/i18n/en";
import type { RegionDossierItem } from "~/lib/regionPage";
import RegionDossier from "./RegionDossier.astro";

export interface Props {
  dossier: RegionDossierItem[];
  accent: Accent;
}

const { dossier } = Astro.props;
const hasDossier = dossier.length > 0;
---

<section
  id="guide"
  class:list={[
    "section",
    "region-guide",
    { "region-guide--prose-only": !hasDossier },
  ]}
>
  <h2 class="display section-heading region-guide__heading">
    {en.region.guideHeading}
  </h2>

  <div class="region-guide__grid">
    <div class="region-guide__prose motion-reveal">
      <div class="prose-body">
        <slot />
      </div>
    </div>

    {
      hasDossier && (
        <div id="routes" class="region-guide__routes">
          <div class="region-guide__dossier">
            {dossier.map((item) => (
              <RegionDossier
                href={item.href}
                title={item.title}
                summary={item.summary}
                hero={item.hero}
                kicker={item.kicker}
                meta={item.meta}
              />
            ))}
          </div>
        </div>
      )
    }
  </div>
</section>

<style>
  .region-guide {
    padding-block: clamp(3.5rem, 7vw, 7rem);
  }

  .region-guide__heading {
    margin-bottom: var(--space-header);
  }

  .region-guide__grid {
    display: grid;
    gap: clamp(2.25rem, 4vw, 3.5rem);

    @media (width >= 900px) {
      grid-template-columns: 1fr 1fr;
      gap: clamp(2rem, 5vw, 5rem);
      align-items: start;
    }
  }

  .region-guide__routes {
    min-width: 0;
  }

  .region-guide__prose .prose-body {
    max-width: 70ch;
  }

  .region-guide--prose-only .region-guide__grid {
    @media (width >= 900px) {
      grid-template-columns: 1fr;
    }
  }

  .region-guide--prose-only .region-guide__prose .prose-body {
    max-width: none;
  }

  .region-guide__dossier {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
</style>
