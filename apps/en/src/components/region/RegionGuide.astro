---
import type { Accent } from "@shared/lib/accent";
import { en } from "~/i18n/en";
import type {
  RegionDossierItem,
  RegionFeaturedStory as FeaturedStoryData,
} from "~/lib/regionPage";
import RegionDossier from "./RegionDossier.astro";
import RegionFeaturedStory from "./RegionFeaturedStory.astro";

export interface Props {
  dossier: RegionDossierItem[];
  featuredStory?: FeaturedStoryData;
  accent: Accent;
}

const { dossier, featuredStory } = Astro.props;
const hasDossier = dossier.length > 0;
const isSingle = !hasDossier || !featuredStory;
---

<section
  id="guide"
  class:list={["section", "region-guide", { "region-guide--single": isSingle }]}
>
  <h2 class="sr-only">
    {en.region.guideHeading}
  </h2>

  <div class="region-guide__grid">
    {
      featuredStory && (
        <div class="region-guide__featured motion-reveal-media">
          <RegionFeaturedStory
            href={featuredStory.href}
            title={featuredStory.title}
            summary={featuredStory.summary}
            hero={featuredStory.hero}
            countryMeta={featuredStory.countryMeta}
            accent={featuredStory.accent}
            transitionName={`hero-${featuredStory.a.id}`}
          />
        </div>
      )
    }

    {
      hasDossier && (
        <div id="routes" class="region-guide__routes">
          <div class="region-guide__dossier">
            {dossier.map((item) => (
              <RegionDossier
                href={item.href}
                title={item.title}
                summary={item.summary}
                hero={item.hero}
                kicker={item.kicker}
                meta={item.meta}
              />
            ))}
          </div>
        </div>
      )
    }
  </div>
</section>

<style>
  .region-guide__grid {
    display: grid;
    gap: var(--grid-gap-compact);

    @media (width >= 900px) {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      /* Featured card stretches to the combined height of the dossier column. */
      align-items: stretch;
    }
  }

  .region-guide__featured,
  .region-guide__routes {
    min-width: 0;
  }

  .region-guide--single .region-guide__grid {
    @media (width >= 900px) {
      grid-template-columns: 1fr;
    }
  }

  .region-guide--single .region-guide__featured {
    @media (width >= 900px) {
      aspect-ratio: 16 / 7;
    }
  }

  .region-guide__dossier {
    display: flex;
    flex-direction: column;
    gap: var(--grid-gap-compact);
  }
</style>
