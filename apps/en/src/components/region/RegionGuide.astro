---
import type { Accent } from "@shared/lib/accent";
import { en } from "~/i18n/en";
import type { RegionItinerary } from "~/lib/regionPage";
import RegionDossier from "./RegionDossier.astro";

export interface Props {
  itineraries: RegionItinerary[];
  accent: Accent;
}

const { itineraries } = Astro.props;
const hasItineraries = itineraries.length > 0;
---

<section
  id="guide"
  class:list={[
    "section",
    "region-guide",
    { "region-guide--prose-only": !hasItineraries },
  ]}
>
  <h2 class="display section-heading region-guide__heading">
    {en.region.guideHeading}
  </h2>

  <div class="region-guide__grid">
    <div class="region-guide__prose motion-reveal">
      <div class="prose-body">
        <slot />
      </div>
    </div>

    {
      hasItineraries && (
        <div id="routes" class="region-guide__routes">
          <div class="region-guide__dossier">
            {itineraries.map((itinerary) => (
              <RegionDossier
                href={itinerary.href}
                title={itinerary.title}
                summary={itinerary.summary}
                hero={itinerary.hero}
                days={itinerary.days}
                countries={itinerary.countries}
              />
            ))}
          </div>
        </div>
      )
    }
  </div>
</section>

<style>
  .region-guide {
    padding-block: clamp(3.5rem, 7vw, 7rem);
  }

  .region-guide__heading {
    margin-bottom: var(--space-header);
  }

  .region-guide__grid {
    display: grid;
    gap: clamp(2.25rem, 4vw, 3.5rem);

    @media (width >= 900px) {
      grid-template-columns: 1fr 1fr;
      gap: clamp(2rem, 5vw, 5rem);
      align-items: start;
    }
  }

  .region-guide__routes {
    min-width: 0;
  }

  .region-guide__prose .prose-body {
    max-width: 70ch;
  }

  .region-guide--prose-only .region-guide__grid {
    @media (width >= 900px) {
      grid-template-columns: 1fr;
    }
  }

  .region-guide--prose-only .region-guide__prose .prose-body {
    max-width: none;
  }

  .region-guide__dossier :global(.region-dossier:first-of-type) {
    padding-top: 0;
  }
</style>
