---
import type { CollectionEntry } from "astro:content";
import CoverImage from "@shared/components/media/CoverImage.astro";
import PassportStamp from "~/components/country/PassportStamp.astro";
import { en } from "~/i18n/en";
import portrait from "~/assets/about/alex-mela.JPG";

export interface Props {
  /** Rendered HTML paragraphs (first is the lede). */
  paragraphs: string[];
  /** The region's countries; their latest visits become the stamps. */
  countries?: CollectionEntry<"places">[];
}

const { paragraphs, countries = [] } = Astro.props;
const [lede, ...rest] = paragraphs;

const STAMP_COUNT = 3;
const VARIANTS = ["round", "rect", "oval"] as const;
const TILTS = [-8, 7, -3] as const;

/** Three most recent trips in the region, one stamp per country. */
const stamps = countries
  .flatMap((place) => {
    const latest = [...place.data.visits].sort((a, b) => b.year - a.year)[0];
    return latest ? [{ place, visit: latest }] : [];
  })
  .sort(
    (a, b) =>
      b.visit.year - a.visit.year ||
      a.place.data.name.localeCompare(b.place.data.name),
  )
  .slice(0, STAMP_COUNT)
  .map((stamp, i) => ({
    ...stamp,
    variant: VARIANTS[i % VARIANTS.length]!,
    rotate: TILTS[i % TILTS.length]!,
  }));
---

<section class="section">
  <figure class="region-editorial motion-reveal shadow-rest">
    <span class="region-editorial__mark" aria-hidden="true"> “ </span>

    <div class="region-editorial__author">
      <div class="region-editorial__portrait">
        <div class="region-editorial__clip">
          <CoverImage
            src={portrait}
            alt={en.authorNote.portraitAlt}
            widths={[160, 240, 320]}
            sizes="9rem"
            format="avif"
            quality={82}
            placeholder="blur"
            wrapperClass="absolute inset-0"
            class="h-full w-full object-cover object-[center_28%]"
          />
        </div>
      </div>
    </div>

    <div class="region-editorial__body">
      <p class="stamp region-editorial__kicker">
        {en.region.editorialKicker}
      </p>
      <blockquote class="region-editorial__text">
        {lede && <div class="region-editorial__lede" set:html={lede} />}
        {
          rest.map((html) => (
            <div class="region-editorial__rest" set:html={html} />
          ))
        }
      </blockquote>
      <figcaption class="region-editorial__caption">
        <span class="region-editorial__signature">
          — {en.authorNote.signature}
        </span>
        <a href="/about" class="region-editorial__link">
          {en.authorNote.aboutCta}
        </a>
      </figcaption>
    </div>

    {
      stamps.length > 0 && (
        <ul class="region-editorial__stamps" aria-hidden="true">
          {stamps.map((stamp, i) => (
            <li class="region-editorial__stamp">
              <PassportStamp
                id={`region-note-${stamp.place.id}-${stamp.visit.year}`}
                variant={stamp.variant}
                country={stamp.place.data.name}
                localName={stamp.place.data.localName}
                forceLocalName={stamp.place.data.stampLocalName}
                year={stamp.visit.year}
                label={stamp.visit.label}
                rotate={stamp.rotate}
                seed={17 + i * 11}
              />
            </li>
          ))}
        </ul>
      )
    }
  </figure>
</section>

<style>
  .region-editorial {
    position: relative;
    margin: 0;
    overflow: hidden;
    border-radius: 8px;
  }

  .region-editorial__portrait {
    position: relative;
    flex: none;
    width: 4.5rem;
    aspect-ratio: 1;
    border-radius: 50%;
    box-shadow:
      0 0 0 4px var(--editorial-bg),
      0 0 0 5px var(--editorial-ring);

    @media (width >= 768px) {
      width: 7rem;
    }
  }

  .region-editorial__clip {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: 50%;
  }

  .region-editorial__body {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-width: 0;
  }

  .region-editorial__kicker {
    margin: 0;
  }

  .region-editorial__text {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    text-wrap: pretty;
  }

  .region-editorial__text :global(p) {
    margin: 0;
  }

  .region-editorial__text :global(a) {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }

  .region-editorial__caption {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.1rem;
  }

  .region-editorial__link {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
    transition: opacity var(--duration-ui) var(--ease-cinema);
  }

  .region-editorial__link:hover {
    opacity: 0.8;
  }

  .region-editorial {
    --editorial-bg: var(--color-surface-2);
    --editorial-ring: var(--color-line-strong);
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1.25rem;
    align-items: start;
    padding: clamp(1.5rem, 4vw, 3.25rem);
    background: var(--editorial-bg);
    border-left: 4px solid var(--color-accent);

    @media (width >= 768px) {
      gap: 2.25rem;
    }

    @media (width >= 1100px) {
      grid-template-columns: auto minmax(0, 1fr) minmax(14rem, 19rem);
    }
  }

  /* Three stamps beside the note, centred on the card's height: two side by
     side, the third tucked under them. Below the note on narrower screens. */
  .region-editorial__stamps {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--color-accent-ink);
    pointer-events: none;

    @media (width >= 1100px) {
      grid-column: 3;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-self: center;
      justify-items: center;
      gap: 0.5rem;
    }
  }

  .region-editorial__stamp:nth-child(3) {
    @media (width >= 1100px) {
      grid-column: 1 / -1;
      margin-top: -0.75rem;
    }
  }

  /* Neutral outline only on the paper canvas; the accent stripe stays in both themes. */
  :global(html[data-theme="light"]) .region-editorial {
    border: 1px solid var(--color-line);
    border-left: 4px solid var(--color-accent);
  }

  .region-editorial__mark {
    position: absolute;
    top: clamp(1rem, 2.5vw, 2rem);
    right: clamp(1.25rem, 3vw, 2.5rem);
    font-family: var(--font-display);
    font-size: clamp(7rem, 12vw, 11rem);
    line-height: 0.62;
    color: var(--color-accent);
    pointer-events: none;
  }

  .region-editorial .region-editorial__kicker {
    color: var(--color-accent-ink);
  }

  .region-editorial .region-editorial__text {
    max-width: 80ch;
    font-family: var(--font-body);
    font-size: clamp(1.05rem, 0.95rem + 0.35vw, 1.25rem);
    line-height: 1.6;
    color: var(--color-ink);
  }

  .region-editorial .region-editorial__caption {
    color: var(--color-ink);
  }
</style>
