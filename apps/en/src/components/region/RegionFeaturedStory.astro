---
import type { ImageMetadata } from "astro";
import CoverImage from "@shared/components/media/CoverImage.astro";
import type { Accent } from "@shared/lib/accent";
import { cardAccentStyle } from "@shared/lib/accent";

export interface Props {
  href: string;
  title: string;
  summary: string;
  hero: ImageMetadata;
  kicker: string;
  countryMeta: string;
  accent: Accent;
  transitionName?: string;
}

const {
  href,
  title,
  summary,
  hero,
  kicker,
  countryMeta,
  accent,
  transitionName,
} = Astro.props;
---

<section class="section region-story">
  <a
    href={href}
    class="region-story__card group relative flex w-full flex-col overflow-clip rounded-sm text-photo-ink"
    style={cardAccentStyle(accent)}
  >
    <CoverImage
      src={hero}
      alt={title}
      widths={[720, 960, 1280, 1600]}
      sizes="(min-width: 1536px) 92rem, (min-width: 768px) 84rem, 100vw"
      format="avif"
      quality={82}
      wrapperClass="motion-hover-media absolute inset-0"
      transitionName={transitionName}
      class="absolute inset-0 h-full w-full object-cover"
    />
    <div
      class="photo-scrim pointer-events-none absolute inset-0"
      aria-hidden="true"
    >
    </div>
    <div class="region-story__copy px-4 pt-20 pb-4 md:px-5 md:pb-5">
      <span class="stamp-badge stamp-badge--accent">{kicker}</span>
      <h3 class="region-story__title display">{title}</h3>
      <p class="region-story__summary">{summary}</p>
      <p class="region-story__countries">{countryMeta}</p>
    </div>
  </a>
</section>

<style>
  .region-story {
    padding-block: clamp(2rem, 4vw, 3.5rem);
  }

  .region-story__card {
    isolation: isolate;
    display: flex;
    flex-direction: column;
    aspect-ratio: 16 / 7;
    text-decoration: none;
    color: inherit;
  }

  .region-story__copy {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-end;
    margin-top: auto;
    width: 100%;
  }

  .region-story__title {
    margin-top: 0.85rem;
    max-width: 30ch;
    color: var(--color-photo-ink);
    font-size: clamp(2.4rem, 6vw, 5.25rem);
    line-height: 0.88;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  .region-story__summary {
    margin-top: 1rem;
    max-width: 46ch;
    font-family: var(--font-body);
    font-size: clamp(1.05rem, 0.95rem + 0.35vw, 1.2rem);
    line-height: 1.45;
    text-wrap: pretty;
    color: var(--color-photo-ink);
    opacity: 0.92;
  }

  .region-story__countries {
    margin-top: 0.85rem;
    max-width: 42ch;
    font-family: var(--font-sans);
    font-size: 0.95rem;
    line-height: 1.4;
    color: var(--color-photo-ink);
    opacity: 0.85;
  }

  .region-story__card img {
    height: 100%;
    width: 100%;
    object-fit: cover;
  }
</style>
