---
import type { ImageMetadata } from "astro";
import CoverImage from "@shared/components/media/CoverImage.astro";
import type { Accent } from "@shared/lib/accent";
import { cardAccentStyle } from "@shared/lib/accent";
import { en } from "~/i18n/en";

export interface Props {
  href: string;
  title: string;
  summary: string;
  hero: ImageMetadata;
  countryMeta: string;
  accent: Accent;
  transitionName?: string;
}

const { href, title, summary, hero, countryMeta, accent, transitionName } =
  Astro.props;
---

<a
  href={href}
  class="featured-story group shadow-rest"
  style={cardAccentStyle(accent)}
>
  <div class="featured-story__photo">
    <CoverImage
      src={hero}
      alt={title}
      widths={[640, 960, 1280, 1600]}
      sizes="(min-width: 900px) 46vw, 100vw"
      format="avif"
      quality={82}
      wrapperClass="motion-hover-media absolute inset-0"
      transitionName={transitionName}
      class="absolute inset-0 h-full w-full object-cover"
    />
    <div
      class="photo-scrim pointer-events-none absolute inset-0 z-1"
      aria-hidden="true"
    >
    </div>
  </div>

  <div class="featured-story__copy">
    <span class="stamp-badge stamp-badge--accent featured-story__badge">
      {en.region.featuredStory}
    </span>
    <h3 class="display photo-title-shadow featured-story__title">{title}</h3>
    <p class="featured-story__summary">{summary}</p>
    <p class="featured-story__meta">{countryMeta}</p>
  </div>
</a>

<style>
  .featured-story {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    height: 100%;
    min-height: 26rem;
    overflow: hidden;
    border-radius: 8px;
    background: var(--color-surface-2);
    text-decoration: none;
    color: var(--color-photo-ink);
  }

  /* Photo fills the whole card; copy sits on the standard bottom scrim. */
  .featured-story__photo {
    position: absolute;
    inset: 0;
    overflow: hidden;
    isolation: isolate;
  }

  .featured-story__badge {
    align-self: flex-start;
    margin-bottom: 0.4rem;
  }

  .featured-story__copy {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    padding: clamp(1rem, 2vw, 1.4rem);
  }

  .featured-story__title {
    margin: 0;
    max-width: 40ch;
    color: var(--color-photo-ink);
    font-size: clamp(1.75rem, 1.2rem + 1.5vw, 2.6rem);
    line-height: 0.95;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .featured-story__summary {
    margin: 0;
    max-width: 52ch;
    color: var(--color-photo-ink);
    font-family: var(--font-body);
    font-size: 0.98rem;
    line-height: 1.5;
    text-wrap: pretty;
    opacity: 0.92;
  }

  .featured-story__meta {
    margin: 0.15rem 0 0;
    color: var(--color-photo-ink);
    font-family: var(--font-sans);
    font-size: 0.88rem;
    line-height: 1.4;
    opacity: 0.85;
  }
</style>
