---
import type { ImageMetadata } from "astro";
import CoverImage from "@shared/components/media/CoverImage.astro";
export interface Props {
  href: string;
  title: string;
  summary: string;
  hero: ImageMetadata;
  kicker: string;
  meta: string;
}

const { href, title, summary, hero, kicker, meta } = Astro.props;
---

<a href={href} class="region-dossier group shadow-rest">
  <div class="region-dossier__photo">
    <CoverImage
      src={hero}
      alt={title}
      widths={[320, 480, 640, 800]}
      sizes="(min-width: 768px) 11rem, 7rem"
      format="avif"
      quality={78}
      wrapperClass="region-dossier__cover motion-hover-media"
      class="cover-image h-full w-full object-cover"
    />
  </div>
  <div class="region-dossier__copy">
    <p class="stamp region-dossier__kicker">{kicker}</p>
    <h3 class="region-dossier__title display">{title}</h3>
    <p class="region-dossier__summary">{summary}</p>
    <p class="region-dossier__countries">{meta}</p>
  </div>
</a>

<style>
  .region-dossier {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    column-gap: 1rem;
    align-items: stretch;
    overflow: hidden;
    border-radius: 4px;
    background: var(--color-surface-2);
    text-decoration: none;
    color: inherit;

    @media (width >= 768px) {
      grid-template-columns: 11rem minmax(0, 1fr);
      column-gap: 1.25rem;
    }
  }

  /* Neutral outline only on the paper canvas; dark mode relies on tonal lift. */
  :global(html[data-theme="light"]) .region-dossier {
    border: 1px solid var(--color-line);
  }

  .region-dossier__photo {
    position: relative;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    isolation: isolate;
  }

  .region-dossier__photo :global(.region-dossier__cover) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .region-dossier__copy {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    min-width: 0;
    padding: 0.85rem 0.85rem 0.85rem 0;

    @media (width >= 768px) {
      padding: 1rem 1rem 1rem 0;
    }
  }

  .region-dossier__kicker {
    margin: 0;
    color: var(--color-ink-faint);
  }

  .region-dossier__title {
    margin: 0;
    max-width: 40ch;
    font-size: clamp(1.35rem, 1rem + 1vw, 1.75rem);
    line-height: 0.98;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .region-dossier__summary {
    margin: 0;
    max-width: 52ch;
    color: var(--color-ink-dim);
    font-family: var(--font-body);
    font-size: 0.92rem;
    line-height: 1.48;
    text-wrap: pretty;

    /* Keep the row from growing with a long blurb on a phone. */
    @media (width < 640px) {
      display: -webkit-box;
      overflow: hidden;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 3;
      line-clamp: 3;
      text-wrap: wrap;
    }
  }

  .region-dossier__countries {
    margin: 0.15rem 0 0;
    color: var(--color-ink-faint);
    font-family: var(--font-sans);
    font-size: 0.88rem;
    line-height: 1.4;
  }

  .region-dossier:hover .region-dossier__title {
    color: var(--color-accent-ink);
  }
</style>
