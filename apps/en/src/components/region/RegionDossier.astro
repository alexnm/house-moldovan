---
import type { ImageMetadata } from "astro";
import CoverImage from "@shared/components/media/CoverImage.astro";
import { en } from "~/i18n/en";

export interface Props {
  href: string;
  title: string;
  summary: string;
  hero: ImageMetadata;
  days: number;
  countries: { name: string; flag: string }[];
}

const { href, title, summary, hero, days, countries } = Astro.props;
const countryLine = countries.map((c) => `${c.flag} ${c.name}`).join(" · ");
---

<a href={href} class="region-dossier group">
  <div class="region-dossier__photo overflow-clip rounded-sm">
    <CoverImage
      src={hero}
      alt={title}
      widths={[320, 480, 640, 800]}
      sizes="(min-width: 768px) 14rem, 7.5rem"
      format="avif"
      quality={78}
      wrapperClass="motion-hover-media h-full w-full"
      class="h-full w-full object-cover"
    />
  </div>
  <div class="region-dossier__copy">
    <p class="stamp text-ink-faint">
      {en.article.itinerary} · {en.article.days(days)}
    </p>
    <h3 class="region-dossier__title display">{title}</h3>
    <p class="region-dossier__summary">{summary}</p>
    <p class="region-dossier__countries">{countryLine}</p>
  </div>
</a>

<style>
  .region-dossier {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: 1rem;
    align-items: center;
    padding-block: 1.15rem;
    text-decoration: none;
    color: inherit;

    @media (width >= 768px) {
      grid-template-columns: 14rem minmax(0, 1fr);
      gap: 1.75rem;
      padding-block: 1.5rem;
    }
  }

  .region-dossier:not(:first-of-type) {
    border-top: 1px solid var(--color-line);
  }

  .region-dossier__photo {
    aspect-ratio: 5 / 4;
    min-height: 0;
  }

  .region-dossier__photo :global(img) {
    height: 100%;
    width: 100%;
    object-fit: cover;
  }

  .region-dossier__title {
    margin-top: 0.35rem;
    max-width: 30ch;
    font-size: clamp(1.55rem, 1.2rem + 1.2vw, 2.15rem);
    line-height: 0.96;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .region-dossier__summary {
    display: none;
    margin-top: 0.55rem;
    max-width: 52ch;
    color: var(--color-ink-dim);
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.5;
    text-wrap: pretty;

    @media (width >= 768px) {
      display: block;
    }
  }

  .region-dossier__countries {
    margin-top: 0.5rem;
    color: var(--color-ink);
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1.4;
  }

  .region-dossier:hover .region-dossier__title {
    color: var(--color-accent-ink);
  }
</style>
