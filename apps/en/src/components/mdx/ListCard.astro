---
import { en } from "~/i18n/en";

type ListType = "places" | "learn" | "pack";

type Props = {
  /** places: things to see and do · learn: books and films · pack: what to bring */
  type: ListType;
  /** Overrides the type's default label. */
  label?: string;
};

const defaultLabels: Record<ListType, string> = {
  places: en.article.listCard.places,
  learn: en.article.listCard.learn,
  pack: en.article.listCard.pack,
};

const { type, label = defaultLabels[type] } = Astro.props;
---

<aside class:list={["list-card", `list-card--${type}`, "surface-card rounded-sm shadow-rest"]}>
  <div class="list-card__header">
    <span class="list-card__icon" aria-hidden="true">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        {
          type === "places" && (
            <>
              <path d="M3 6l6-3 6 3 6-3v15l-6 3-6-3-6 3z" />
              <path d="M9 3v15" />
              <path d="M15 6v15" />
            </>
          )
        }
        {
          type === "learn" && (
            <>
              <path d="M2 4h6a4 4 0 0 1 4 4v12a3 3 0 0 0-3-3H2z" />
              <path d="M22 4h-6a4 4 0 0 0-4 4v12a3 3 0 0 1 3-3h7z" />
            </>
          )
        }
        {
          type === "pack" && (
            <>
              <path d="M4 10a4 4 0 0 1 4-4h8a4 4 0 0 1 4 4v10a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2z" />
              <path d="M9 6V4a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2" />
              <path d="M8 22v-6a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v6" />
              <path d="M8 10h8" />
            </>
          )
        }
      </svg>
    </span>
    <span class="list-card__label micro">{label}</span>
  </div>
  <div class="list-card__content">
    <slot />
  </div>
</aside>
