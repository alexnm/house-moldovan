---
import CoverImage from "@shared/components/media/CoverImage.astro";
import { loadAssetImage } from "~/lib/assetImages";

type Props = {
  path: string;
  alt: string;
  class?: string;
  sizes?: string;
};

const { path, alt, class: className, sizes } = Astro.props;
const src = await loadAssetImage(path);
const cls = className ?? "h-auto w-full rounded-md shadow-rest";
---

<CoverImage
  src={src}
  alt={alt}
  class={cls}
  sizes={sizes ?? "(min-width: 768px) 42rem, 100vw"}
  widths={[640, 960, 1280, 1600]}
  format="avif"
  quality={80}
  loading="lazy"
  placeholder={false}
/>
