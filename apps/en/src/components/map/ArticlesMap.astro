---
import "leaflet/dist/leaflet.css";
import {
  ARTICLE_PIN_THUMB_SIZE,
  type ArticleMapPin,
} from "~/lib/mapPinData";

export interface Props {
  pins: ArticleMapPin[];
  /** Height utility for the map frame. */
  heightClass?: string;
  /** Edge-to-edge: no card framing. */
  fullBleed?: boolean;
}

const {
  pins,
  heightClass = "h-[70svh] max-h-[40rem] lg:h-[min(85vh,52rem)] lg:max-h-none",
  fullBleed = false,
} = Astro.props;

const payload = {
  pins,
  thumbSize: ARTICLE_PIN_THUMB_SIZE,
};
---

<div class="articles-map-shell flex h-full min-h-0 flex-col" data-articles-map>
  <div
    class:list={[
      "articles-map isolate z-0 w-full overflow-hidden",
      !fullBleed && "rounded-lg border border-line",
      heightClass,
    ]}
    role="presentation"
  >
  </div>

  <script
    type="application/json"
    data-articles-map-payload
    is:inline
    set:html={JSON.stringify(payload)}
  />
</div>

<style>
  /* Float controls and popups over light topo tiles with the film palette. */
  .articles-map {
    background: var(--color-map-paper, oklch(0.97 0.007 95));
    font-family: var(--font-body);
    font-size: 11px;

    --color-ink: oklch(0.96 0.012 75);
    --color-ink-dim: oklch(0.8 0.012 75);
    --color-ink-faint: oklch(0.7 0.014 75);
    --color-surface-2: oklch(0.18 0.016 55);
    --color-surface-3: oklch(0.22 0.016 55);
    --color-line: oklch(0.28 0.014 55);
    --color-line-strong: oklch(0.4 0.016 55);
    --color-map-paper: oklch(0.97 0.007 95);
    color-scheme: dark;
  }

  .articles-map :global(.leaflet-control-attribution) {
    background: color-mix(in oklch, var(--color-surface-2) 88%, transparent);
    color: var(--color-ink-faint);
    padding: 2px 6px;
    font-size: 10px;
  }

  .articles-map :global(.leaflet-control-attribution a) {
    color: var(--color-ink-dim);
  }

  .articles-map :global(.leaflet-bar) {
    border: 1px solid var(--color-line);
    box-shadow: none;
  }

  .articles-map :global(.leaflet-bar a) {
    background: var(--color-surface-2);
    color: var(--color-ink-dim);
    border-bottom-color: var(--color-line);
  }

  .articles-map :global(.leaflet-bar a:hover) {
    background: var(--color-surface-3);
    color: var(--color-ink);
  }

  .articles-map :global(.leaflet-control-scale-line) {
    background: color-mix(in oklch, var(--color-surface-2) 88%, transparent);
    border-color: var(--color-line-strong);
    color: var(--color-ink-dim);
  }

  .articles-map :global(.leaflet-div-icon) {
    background: transparent;
    border: 0;
  }

  .articles-map :global(.article-pin) {
    width: 0;
    height: 0;
  }

  .articles-map :global(.article-pin__badge) {
    position: absolute;
    display: grid;
    place-items: center;
    box-sizing: border-box;
    width: 22px;
    height: 22px;
    left: -11px;
    top: -11px;
    border-radius: 999px;
    border: 2px solid var(--color-map-paper);
    background: var(--pin-color, #c0552c);
    color: var(--color-map-paper);
    box-shadow: 0 1px 3px oklch(0 0 0 / 0.28);
    transition: scale var(--duration-micro) var(--ease-cinema-fast);
  }

  .articles-map :global(.article-pin__badge svg) {
    width: 58%;
    height: 58%;
  }

  .articles-map :global(.article-pin.is-hover .article-pin__badge),
  .articles-map :global(.article-pin:hover .article-pin__badge),
  .articles-map :global(.article-pin:focus-visible .article-pin__badge) {
    scale: 1.18;
  }

  .articles-map :global(.article-pin:focus-visible) {
    outline: none;
  }

  .articles-map :global(.article-pin:focus-visible .article-pin__badge) {
    box-shadow: 0 0 0 2px oklch(0 0 0 / 0.6);
  }

  .articles-map :global(.leaflet-popup-content-wrapper) {
    background: var(--color-surface-2);
    color: var(--color-ink);
    border: 1px solid var(--color-line);
    border-radius: 0.5rem;
    box-shadow: none;
    overflow: hidden;
    padding: 0;
  }

  .articles-map :global(.leaflet-popup-tip) {
    background: var(--color-surface-2);
  }

  .articles-map :global(.leaflet-popup-content) {
    margin: 0;
    font-family: var(--font-body);
    line-height: 1.35;
  }

  .articles-map :global(a.leaflet-popup-close-button) {
    background: var(--color-surface-2);
    color: var(--color-ink-dim);
    font-family: var(--font-body);
    font-size: 14px;
    border-bottom-left-radius: 0.4rem;
  }

  .articles-map :global(a.leaflet-popup-close-button:hover) {
    color: var(--color-ink);
  }

  .articles-map :global(.article-pop__link) {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .articles-map :global(.article-pop__figure) {
    position: relative;
    margin: 0;
  }

  .articles-map :global(.article-pop__media) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    background: var(--color-surface-3);
    border-bottom: 1px solid var(--color-line);
  }

  /* Stamp over the hero, matching the site's photo-scrim kicker badges. */
  .articles-map :global(.article-pop__meta) {
    position: absolute;
    top: 0.5rem;
    left: 0.5rem;
    margin: 0;
    padding: 0.25rem 0.4rem;
    border-radius: 2px;
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.1em;
    line-height: 1.4;
    text-transform: uppercase;
    background: color-mix(in oklch, var(--color-photo-scrim) 55%, transparent);
    color: var(--color-photo-ink);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
  }

  .articles-map :global(.article-pop__body) {
    padding: 0.6rem 0.8rem 0.7rem;
  }

  .articles-map :global(.article-pop__title) {
    margin: 0;
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 600;
    line-height: 1.15;
    color: var(--color-ink);
  }

  .articles-map :global(.article-pop__link:hover .article-pop__title) {
    color: var(--article-accent, var(--color-ink));
  }

  .articles-map :global(.article-pop__place) {
    margin: 0.3rem 0 0;
    font-family: var(--font-sans);
    font-size: 13px;
    line-height: 1.35;
    color: var(--color-ink-dim);
  }

  .articles-map :global(.article-pop__place-label) {
    color: var(--article-accent, var(--color-ink));
  }
</style>

<script>
  import L from "leaflet";
  import { MAP_TILES } from "~/lib/mapStyles";
  import type { ArticleMapPin } from "~/lib/mapPinData";

  type Payload = {
    pins: ArticleMapPin[];
    thumbSize: { width: number; height: number };
  };

  /** Material glyphs on a 24×24 grid, one per article kind. */
  const KIND_GLYPH: Record<ArticleMapPin["kind"], string> = {
    story:
      '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zm17.71-10.21a1 1 0 0 0 0-1.41l-2.34-2.34a1 1 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/></svg>',
    spotlight:
      '<svg viewBox="0 0 24 24" fill="currentColor" fill-rule="evenodd" aria-hidden="true"><path d="M9 3h6l1.8 2H20a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h3.2L9 3Zm3 5.4a4.1 4.1 0 1 0 0 8.2 4.1 4.1 0 0 0 0-8.2Z"/></svg>',
    itinerary:
      '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>',
  };

  function escapeHtml(s: string): string {
    return s
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;");
  }

  function popupHtml(pin: ArticleMapPin, thumbSize: Payload["thumbSize"]): string {
    const country = `${pin.countryFlag ? `${escapeHtml(pin.countryFlag)} ` : ""}${escapeHtml(pin.countryName)}`;
    const place =
      pin.placeLabel && pin.placeLabel !== pin.countryName
        ? `<span class="article-pop__place-label">${escapeHtml(pin.placeLabel)}</span> · ${country}`
        : country;

    return `<article class="article-pop" style="--article-accent: ${escapeHtml(pin.accentVar)}">
  <a class="article-pop__link" href="${escapeHtml(pin.href)}">
    <figure class="article-pop__figure">
      <img class="article-pop__media" src="${escapeHtml(pin.thumb)}" width="${thumbSize.width}" height="${thumbSize.height}" alt="" loading="lazy" decoding="async" />
      <figcaption class="article-pop__meta">${escapeHtml(pin.meta)}</figcaption>
    </figure>
    <div class="article-pop__body">
      <h3 class="article-pop__title">${escapeHtml(pin.title)}</h3>
      <p class="article-pop__place">${place}</p>
    </div>
  </a>
</article>`;
  }

  function initArticleMaps(root: ParentNode = document): void {
    root
      .querySelectorAll<HTMLElement>("[data-articles-map]:not([data-mounted])")
      .forEach((shell) => {
        const payloadEl = shell.querySelector<HTMLScriptElement>(
          "[data-articles-map-payload]",
        );
        const mapEl = shell.querySelector<HTMLElement>(".articles-map");
        if (!payloadEl?.textContent || !mapEl) return;

        shell.dataset.mounted = "1";

        const payload = JSON.parse(payloadEl.textContent) as Payload;
        const map = L.map(mapEl, {
          scrollWheelZoom: true,
          attributionControl: true,
          maxZoom: MAP_TILES.maxZoom,
        });

        L.tileLayer(MAP_TILES.url, {
          attribution: MAP_TILES.attribution,
          maxZoom: MAP_TILES.maxZoom,
          crossOrigin: true,
        }).addTo(map);

        L.control.scale({ imperial: false, maxWidth: 120 }).addTo(map);

        const popupOptions: L.PopupOptions = {
          minWidth: 232,
          maxWidth: 232,
          autoPanPadding: [24, 24],
        };

        const bounds = L.latLngBounds([]);

        const articleKeyOf = (pin: ArticleMapPin): string =>
          `${pin.kind}:${pin.articleId}`;

        // Preserve frontmatter order so multi-stop articles read as a route.
        const pinsByArticle = new Map<string, ArticleMapPin[]>();
        for (const pin of payload.pins) {
          const articlePins = pinsByArticle.get(articleKeyOf(pin));
          if (articlePins) articlePins.push(pin);
          else pinsByArticle.set(articleKeyOf(pin), [pin]);
        }

        // Routes stay off the map until one of their pins is opened: 70-odd
        // articles drawn at once would bury the pins under their own lines.
        const routeByArticle = new Map<string, L.Polyline>();
        for (const [articleKey, articlePins] of pinsByArticle) {
          if (articlePins.length < 2) continue;

          routeByArticle.set(
            articleKey,
            L.polyline(
              articlePins.map((pin) => [pin.lat, pin.lng]),
              {
                color: articlePins[0]!.pinColor,
                weight: 2,
                opacity: 0.8,
                dashArray: "6 7",
                lineCap: "round",
                lineJoin: "round",
                interactive: false,
              },
            ),
          );
        }

        // An open popup pins its route; hovering only previews one, so moving
        // off a pin returns to whatever the open popup was showing.
        let openedKey: string | null = null;
        let hoveredKey: string | null = null;
        let shownRoute: L.Polyline | null = null;

        const paintRoute = (): void => {
          const key = openedKey ?? hoveredKey;
          const route = key ? (routeByArticle.get(key) ?? null) : null;
          if (route === shownRoute) return;
          if (shownRoute) map.removeLayer(shownRoute);
          shownRoute = route;
          // Behind the pins, so a stop never hides under its own route.
          if (route) route.addTo(map).bringToBack();
        };

        for (const pin of payload.pins) {
          const latlng: L.LatLngExpression = [pin.lat, pin.lng];
          bounds.extend(latlng);

          const marker = L.marker(latlng, {
            title: pin.title,
            alt: pin.title,
            keyboard: true,
            icon: L.divIcon({
              className: "article-pin",
              html: `<span class="article-pin__badge" style="--pin-color: ${pin.pinColor}">${KIND_GLYPH[pin.kind]}</span>`,
              iconSize: [0, 0],
              iconAnchor: [0, 0],
              popupAnchor: [0, -14],
            }),
          }).addTo(map);

          marker.bindPopup(popupHtml(pin, payload.thumbSize), popupOptions);

          marker.on("mouseover", () => {
            marker.getElement()?.classList.add("is-hover");
            hoveredKey = articleKeyOf(pin);
            paintRoute();
          });
          marker.on("mouseout", () => {
            marker.getElement()?.classList.remove("is-hover");
            if (hoveredKey === articleKeyOf(pin)) hoveredKey = null;
            paintRoute();
          });

          marker.on("popupopen", () => {
            openedKey = articleKeyOf(pin);
            paintRoute();
          });
          marker.on("popupclose", () => {
            if (openedKey === articleKeyOf(pin)) openedKey = null;
            paintRoute();
          });
        }

        if (bounds.isValid()) {
          map.fitBounds(bounds.pad(0.12), { maxZoom: 6 });
        } else {
          map.setView([20, 10], 2);
        }
      });
  }

  initArticleMaps();
  document.addEventListener("astro:page-load", () => initArticleMaps());
</script>
