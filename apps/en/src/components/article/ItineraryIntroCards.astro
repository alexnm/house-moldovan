---
import { en } from "~/i18n/en";

export interface Props {
  highlights: string[];
  travelTips: string[];
}

const { highlights, travelTips } = Astro.props;

const cardClass = "rounded border border-line bg-accent/8 p-6 md:p-7";
const headingClass = "micro mb-4 border-b border-line pb-3 text-accent-ink";
const itemClass =
  "flex gap-2.5 text-balance before:mt-[0.6em] before:h-1.5 before:w-1.5 before:shrink-0 before:rounded-full before:bg-accent before:content-['']";
---

<div
  class="motion-reveal grid gap-[var(--grid-gap)] md:grid-cols-2"
  aria-label="Itinerary overview"
>
  <div class={cardClass}>
    <p class={headingClass}>
      {en.article.itineraryHighlights}
    </p>
    <ul class="list-none space-y-3 text-base leading-relaxed text-ink">
      {highlights.map((line) => <li class={itemClass}>{line}</li>)}
    </ul>
  </div>
  <div class={cardClass}>
    <p class={headingClass}>
      {en.article.itineraryTravelTips}
    </p>
    <ul class="list-none space-y-3 text-base leading-relaxed text-ink">
      {travelTips.map((line) => <li class={itemClass}>{line}</li>)}
    </ul>
  </div>
</div>
