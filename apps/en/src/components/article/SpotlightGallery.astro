---
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";
import CoverImage from "@shared/components/media/CoverImage.astro";
import { en } from "~/i18n/en";

export interface Props {
  title: string;
  photos: { image: ImageMetadata; caption: string; tagline: string }[];
}

const { title, photos } = Astro.props;

/* Masonry keeps every photo at its own shape; only the first couple sit near
   the fold, so the rest load lazily. */
const EAGER = 2;

const slides = await Promise.all(
  photos.map(async (p) => {
    const full = await getImage({
      src: p.image,
      width: Math.min(p.image.width, 2400),
      format: "avif",
      quality: 82,
    });
    const thumb = await getImage({
      src: p.image,
      width: 160,
      format: "avif",
      quality: 70,
    });
    return {
      src: full.src,
      thumb: thumb.src,
      tagline: p.tagline,
      caption: p.caption,
    };
  }),
);
---

<section
  class="spotlight-gallery min-w-0"
  aria-label={en.article.photoCount(photos.length)}
  data-spotlight-gallery
>
  <ul class="m-0 list-none columns-1 gap-2.5 p-0 sm:columns-2">
    {
      photos.map((p, i) => (
        <li class="motion-reveal-media mb-2.5 break-inside-avoid">
          <button
            type="button"
            class="gallery-item group relative block w-full cursor-zoom-in overflow-hidden rounded-sm p-0"
            style={`aspect-ratio: ${p.image.width} / ${p.image.height}`}
            data-index={i}
            aria-label={en.article.openPhoto(p.tagline)}
          >
            <CoverImage
              src={p.image}
              alt={p.caption}
              widths={[480, 720, 960, 1280]}
              sizes="(min-width: 1024px) 30vw, (min-width: 640px) 50vw, 100vw"
              loading={i < EAGER ? "eager" : "lazy"}
              format="avif"
              quality={82}
              wrapperClass="absolute inset-0"
              class="absolute inset-0 h-full w-full object-cover"
            />
            <span class="stamp-badge absolute top-3 left-3 z-10 md:top-4 md:left-4">
              {p.tagline}
            </span>
          </button>
        </li>
      ))
    }
  </ul>

  <dialog class="lightbox" aria-label={title} data-lightbox>
    <div class="lightbox__top">
      <p class="micro m-0 text-ink-faint">
        {title} · <span data-lb-count></span>
      </p>
      <button
        type="button"
        class="lightbox__btn"
        aria-label={en.article.closePhoto}
        data-lb-close
      >
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg
        >
      </button>
    </div>
    <figure class="lightbox__figure">
      <img class="lightbox__img" alt="" data-lb-img />
      <figcaption class="lightbox__caption">
        <p class="lightbox__tagline" data-lb-tagline></p>
      </figcaption>
    </figure>
    <button
      type="button"
      class="lightbox__btn lightbox__prev"
      aria-label={en.article.previousPhoto}
      data-lb-prev
    >
      <svg
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"><path d="M15 6l-6 6 6 6"></path></svg
      >
    </button>
    <button
      type="button"
      class="lightbox__btn lightbox__next"
      aria-label={en.article.nextPhoto}
      data-lb-next
    >
      <svg
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg
      >
    </button>
    <div class="lightbox__strip">
      {
        slides.map((s, i) => (
          <button
            type="button"
            class="lightbox__thumb"
            data-lb-thumb={i}
            aria-label={en.article.openPhoto(s.tagline)}
          >
            <img src={s.thumb} alt="" loading="lazy" decoding="async" />
          </button>
        ))
      }
    </div>
    <script
      is:inline
      type="application/json"
      data-lb-data
      set:html={JSON.stringify(slides)}
    />
  </dialog>
</section>

<style>
  /* Beat Astro's unlayered `[data-astro-image]{height:auto}` so object-cover fills. */
  .spotlight-gallery .gallery-item :global(img) {
    height: 100%;
    width: 100%;
    object-fit: cover;
  }
  .gallery-item {
    border: 0;
    background: var(--color-surface-2);
  }
  .gallery-item:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .lightbox {
    position: fixed;
    inset: 0;
    width: 100vw;
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;
    padding: 0;
    border: 0;
    background: oklch(0.1 0.01 55);
    color: var(--color-ink);
    overflow: hidden;
  }
  .lightbox::backdrop {
    background: oklch(0.1 0.01 55 / 0.9);
  }
  .lightbox[open] {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
  }
  .lightbox__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.5rem;
  }
  .lightbox__figure {
    margin: 0;
    min-height: 0;
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    gap: 1rem;
    padding: 0 clamp(1rem, 6vw, 6rem);
  }
  .lightbox__img {
    width: 100%;
    height: 100%;
    min-height: 0;
    object-fit: contain;
  }
  .lightbox__caption {
    display: flex;
    justify-content: center;
    text-align: center;
  }
  .lightbox__tagline {
    margin: 0;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 1.15rem;
    white-space: nowrap;
  }
  .lightbox__tagline::before {
    content: "";
    display: inline-block;
    width: 0.875rem;
    height: 3px;
    margin: -3px 0.6rem 0 0;
    border-radius: 1px;
    background: var(--color-accent);
    vertical-align: middle;
  }
  .lightbox__btn {
    display: inline-flex;
    width: 2.75rem;
    height: 2.75rem;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--color-line-strong);
    border-radius: 9999px;
    background: color-mix(in oklch, var(--color-surface) 70%, transparent);
    color: var(--color-ink);
    cursor: pointer;
  }
  .lightbox__btn:focus-visible,
  .lightbox__thumb:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  .lightbox__prev,
  .lightbox__next {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
  }
  .lightbox__prev {
    left: 1rem;
  }
  .lightbox__next {
    right: 1rem;
  }
  .lightbox__strip {
    display: flex;
    gap: 0.375rem;
    justify-content: safe center;
    overflow-x: auto;
    padding: 1rem 1.5rem 1.25rem;
  }
  .lightbox__thumb {
    flex: none;
    width: 4rem;
    height: 3rem;
    padding: 0;
    border: 0;
    border-radius: 2px;
    overflow: hidden;
    opacity: 0.45;
    cursor: pointer;
    background: var(--color-surface-2);
    transition: opacity var(--duration-ui) var(--ease-cinema);
  }
  .lightbox__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .lightbox__thumb[aria-current="true"] {
    opacity: 1;
    outline: 2px solid var(--color-accent);
    outline-offset: 1px;
  }
  @media (max-width: 40rem) {
    .lightbox__prev,
    .lightbox__next {
      top: auto;
      bottom: 5.5rem;
      transform: none;
    }
    .lightbox__strip {
      display: none;
    }
  }
</style>

<script>
  type Slide = { src: string; thumb: string; tagline: string; caption: string };

  function initSpotlightGalleries() {
    document
      .querySelectorAll<HTMLElement>("[data-spotlight-gallery]")
      .forEach((root) => {
        if (root.dataset.galleryReady) return;
        root.dataset.galleryReady = "true";

        const dialog = root.querySelector<HTMLDialogElement>("[data-lightbox]");
        const dataEl = root.querySelector("[data-lb-data]");
        if (!dialog || !dataEl) return;
        const slides = JSON.parse(dataEl.textContent ?? "[]") as Slide[];
        if (slides.length === 0) return;

        const img = dialog.querySelector<HTMLImageElement>("[data-lb-img]")!;
        const tagline = dialog.querySelector<HTMLElement>("[data-lb-tagline]")!;
        const count = dialog.querySelector<HTMLElement>("[data-lb-count]")!;
        const thumbs = Array.from(
          dialog.querySelectorAll<HTMLButtonElement>("[data-lb-thumb]"),
        );
        let current = 0;
        let opener: HTMLElement | null = null;

        const show = (index: number) => {
          current = (index + slides.length) % slides.length;
          const s = slides[current]!;
          img.src = s.src;
          img.alt = s.caption;
          tagline.textContent = s.tagline;
          count.textContent = `${current + 1} / ${slides.length}`;
          thumbs.forEach((t, i) =>
            t.setAttribute("aria-current", String(i === current)),
          );
          thumbs[current]?.scrollIntoView({
            block: "nearest",
            inline: "center",
          });
          // Warm the neighbours so next/previous feel instant.
          for (const n of [current + 1, current - 1]) {
            const neighbour = slides[(n + slides.length) % slides.length];
            if (neighbour) new Image().src = neighbour.src;
          }
        };

        root
          .querySelectorAll<HTMLButtonElement>(".gallery-item[data-index]")
          .forEach((button) => {
            button.addEventListener("click", () => {
              opener = button;
              show(Number(button.dataset.index));
              dialog.showModal();
            });
          });

        dialog
          .querySelector("[data-lb-prev]")
          ?.addEventListener("click", () => show(current - 1));
        dialog
          .querySelector("[data-lb-next]")
          ?.addEventListener("click", () => show(current + 1));
        dialog
          .querySelector("[data-lb-close]")
          ?.addEventListener("click", () => dialog.close());
        thumbs.forEach((t) =>
          t.addEventListener("click", () => show(Number(t.dataset.lbThumb))),
        );

        dialog.addEventListener("keydown", (event) => {
          if (event.key === "ArrowRight") show(current + 1);
          else if (event.key === "ArrowLeft") show(current - 1);
        });
        // Clicking the dark area around the photo closes the viewer.
        dialog.addEventListener("click", (event) => {
          if (event.target === dialog) dialog.close();
        });
        dialog.addEventListener("close", () => opener?.focus());
      });
  }

  initSpotlightGalleries();
  document.addEventListener("astro:page-load", initSpotlightGalleries);
</script>
