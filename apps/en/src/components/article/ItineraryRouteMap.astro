---
import LocationsMap from "~/components/map/LocationsMap.astro";
import type { RouteMap } from "~/lib/routeMap";

export interface Props {
  map: RouteMap;
  label: string;
}

const { map, label } = Astro.props;
---

<figure class="route-map m-0" aria-label={label}>
  <LocationsMap
    pins={[]}
    route={map}
    basemap="adaptive"
    scrollZoom={false}
    fullBleed
  />
</figure>
