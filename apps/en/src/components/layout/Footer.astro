---
import { en } from "~/i18n/en";
import { SISTER_SITE_URL } from "~/lib/site";
import CrestMark from "@shared/components/layout/CrestMark.astro";
import SiteLogo from "@shared/components/layout/SiteLogo.astro";
import ThemeToggle from "@shared/components/layout/ThemeToggle.astro";
import { getAllRegions } from "~/lib/regions";

const year = new Date().getFullYear();
const regions = await getAllRegions();

const journalLinks = [
  { href: "/journal", label: en.nav.journal },
  { href: "/stories", label: en.nav.stories },
  { href: "/itineraries", label: en.nav.itineraries },
  { href: "/spotlights", label: en.nav.spotlights },
];
---

<footer class="mt-32 bg-surface-2">
  <div
    class="pad-canvas mx-auto grid max-w-canvas grid-cols-2 gap-x-8 gap-y-10 py-16 md:grid-cols-[3fr_1fr_1fr_1fr] md:gap-12"
  >
    <div class="col-span-2 md:col-span-1">
      <SiteLogo size="footer" link={false} />
      <p class="mt-3 max-w-md text-ink-dim">
        {en.description}
      </p>
      <a
        href={SISTER_SITE_URL}
        class="duration-ui mt-4 block max-w-max rounded-lg border border-line p-4 transition-colors ease-cinema hover:border-line-strong"
        target="_blank"
        rel="noopener noreferrer"
      >
        <p class="text-ink-dim">{en.footer.roKicker}</p>
        <p class="mt-1 flex items-center gap-2.5 font-sans text-xl">
          <span class="block w-7 shrink-0">
            <CrestMark />
          </span>
          {en.footer.roCta}
        </p>
      </a>
      <p class="micro mt-8 text-ink-faint">
        © {year}. {en.footer.rights}
      </p>
    </div>

    <div>
      <ul class="space-y-2">
        {
          journalLinks.map((link) => (
            <li>
              <a href={link.href} class="link-accent font-sans">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <ul class="space-y-2">
        <li>
          <a href="/explore" class="link-accent font-sans">
            {en.nav.explore}
          </a>
        </li>
        {
          regions.map((region) => (
            <li>
              <a
                href={`/explore/region/${region.id}`}
                class="link-accent font-sans"
              >
                {region.data.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <ul class="space-y-2">
        <li>
          <a href="/about" class="link-accent font-sans">
            {en.footer.aboutUs}
          </a>
        </li>
        <li>
          <a
            href={en.footer.instagramUrl}
            class="link-accent font-sans"
            target="_blank"
            rel="noopener noreferrer"
          >
            {en.footer.instagramLabel}
          </a>
        </li>
        <li>
          <a href="/rss.xml" class="link-accent font-sans">
            {en.footer.subscribeLabel}
          </a>
        </li>
      </ul>

      <ThemeToggle
        lightLabel={en.footer.themeLight}
        darkLabel={en.footer.themeDark}
      />
    </div>
  </div>
</footer>
