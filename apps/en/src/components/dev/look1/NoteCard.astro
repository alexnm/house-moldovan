---
/**
 * Look 1 photo card. Same silhouette as `home/ArticleCard.astro`, with a darker
 * read layer replacing the old accent glow.
 */
import type { ImageMetadata } from "astro";
import CoverImage from "@shared/components/media/CoverImage.astro";
import type { Accent } from "@shared/lib/accent";
import { cardAccentStyle } from "@shared/lib/accent";

export interface Props {
  href: string;
  title: string;
  kicker: string;
  meta?: string;
  image: ImageMetadata;
  imageAlt: string;
  aspectClass?: string;
  accent?: Accent;
  regionLabel?: string;
}

const {
  href,
  title,
  kicker,
  meta,
  image,
  imageAlt,
  aspectClass = "aspect-square lg:aspect-[4/5]",
  accent,
  regionLabel,
} = Astro.props;
---

<a
  href={href}
  class="note-card group motion-reveal-media block h-full"
  style={accent ? cardAccentStyle(accent) : undefined}
>
  <figure class:list={["relative overflow-clip rounded-sm", aspectClass]}>
    <CoverImage
      src={image}
      alt={imageAlt}
      widths={[480, 720, 960, 1280]}
      sizes="(min-width: 1024px) 33vw, 100vw"
      format="avif"
      quality={80}
      wrapperClass="motion-hover-media absolute inset-0"
      class="absolute inset-0 h-full w-full object-cover"
    />
    <div
      class="photo-scrim pointer-events-none absolute inset-0"
      aria-hidden="true"
    >
    </div>

    <span class="stamp-badge absolute top-3 left-3 z-10 md:top-4 md:left-4">
      {kicker}
    </span>

    <div
      class="absolute inset-x-0 bottom-0 z-10 flex flex-col justify-end px-4 pt-20 pb-4 md:px-5 md:pb-5"
    >
      <div
        class="note-card__tick"
        style="background: var(--card-accent, var(--color-accent))"
        aria-hidden="true"
      >
      </div>
      {regionLabel && <p class="stamp mt-3 text-photo-ink/80">{regionLabel}</p>}
      <h3
        class="display photo-title-shadow mt-2 text-2xl leading-[0.94] tracking-[-0.03em] text-balance text-photo-ink normal-case lg:text-[1.75rem]"
      >
        {title}
      </h3>
      {meta && <p class="mt-2 text-balance text-photo-ink/80">{meta}</p>}
    </div>
  </figure>
</a>

<style>
  .note-card {
    --card-accent: var(--color-accent);
  }

  .note-card figure img {
    height: 100%;
    width: 100%;
    object-fit: cover;
  }

  .note-card__tick {
    height: 3px;
    width: 3rem;
    border-radius: 1px;
  }
</style>
