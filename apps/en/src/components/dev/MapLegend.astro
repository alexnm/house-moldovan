---
/**
 * A lightweight, human-readable map key. Region colour and kind pictograms help
 * people browse without turning the map into a dashboard of totals.
 */
import type { Accent } from "@shared/lib/accent";
import type { ArticleKind } from "~/lib/articles";
import KindGlyph from "./KindGlyph.astro";
import { ACCENT_PIN_COLOR_FILM } from "~/lib/mapStyles";

export interface Chapter {
  name: string;
  accent: Accent;
  count?: number;
  href?: string;
}

export interface Props {
  chapters: Chapter[];
  class?: string;
}

const { chapters, class: className } = Astro.props;

const KINDS: { label: string; kind: ArticleKind }[] = [
  { label: "Story", kind: "story" },
  { label: "Itinerary stop", kind: "itinerary" },
  { label: "Spotlight", kind: "spotlight" },
];
---

<div class:list={["map-legend", className]}>
  <ul class="map-legend__chapters">
    {
      chapters.map((chapter) => {
        const Tag = chapter.href ? "a" : "span";
        return (
          <li>
            <Tag
              href={chapter.href}
              class="map-legend__chapter"
              style={`--legend-ink: ${ACCENT_PIN_COLOR_FILM[chapter.accent]}`}
            >
              <span class="map-legend__dot" aria-hidden="true" />
              <span>{chapter.name}</span>
            </Tag>
          </li>
        );
      })
    }
  </ul>

  <ul class="map-legend__kinds">
    {
      KINDS.map((entry) => (
        <li class="map-legend__kind">
          <span class="map-legend__glyph" aria-hidden="true">
            <KindGlyph kind={entry.kind} size="0.65rem" />
          </span>
          <span>{entry.label}</span>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .map-legend {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
  }

  .map-legend__chapters,
  .map-legend__kinds {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 1.1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .map-legend__chapter {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-sans);
    font-size: 0.85rem;
    color: var(--color-ink-dim);
    transition: color var(--duration-ui) var(--ease-cinema);
  }

  a.map-legend__chapter:hover {
    color: var(--color-ink);
  }

  .map-legend__dot {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 999px;
    background: var(--legend-ink);
  }

  .map-legend__kind {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-sans);
    font-size: 0.8rem;
    color: var(--color-ink-faint);
  }

  .map-legend__glyph {
    display: grid;
    place-items: center;
    width: 1.05rem;
    height: 1.05rem;
    border-radius: 999px;
    border: 1px solid var(--color-line-strong);
    color: var(--color-ink-faint);
  }
</style>
