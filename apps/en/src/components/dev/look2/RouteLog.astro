---
/**
 * Look 2 journal feed. The uniform photo grid becomes a loose trail of stories:
 * one soft dotted path, a colourful stop per note, and enough editorial copy to
 * invite a reader in without exposing map data.
 */
import type { ImageMetadata } from "astro";
import CoverImage from "@shared/components/media/CoverImage.astro";
import type { Accent } from "@shared/lib/accent";
import KindGlyph from "~/components/dev/KindGlyph.astro";
import type { ArticleKind } from "~/lib/articles";

export interface Entry {
  href: string;
  title: string;
  kind: ArticleKind;
  kicker: string;
  countryMeta: string;
  summary: string;
  accent?: Accent;
  image: ImageMetadata;
}

export interface Props {
  entries: Entry[];
}

const { entries } = Astro.props;
---

<ol class="route-log">
  {
    entries.map((entry) => (
      <li
        class="accent-scope route-stop motion-reveal"
        data-accent={entry.accent}
      >
        <a href={entry.href} class="route-stop__link group">
          <span class="route-stop__dot" aria-hidden="true" />

          <div class="route-stop__body">
            <p class="stamp route-stop__kicker">
              <KindGlyph kind={entry.kind} size="0.85rem" />
              {entry.kicker}
            </p>
            <h3 class="display route-stop__title">{entry.title}</h3>
            <p class="route-stop__place">{entry.countryMeta}</p>
            <p class="route-stop__summary">{entry.summary}</p>
          </div>

          <div class="route-stop__frame">
            <CoverImage
              src={entry.image}
              alt=""
              widths={[320, 480, 640]}
              sizes="(min-width: 900px) 272px, 40vw"
              format="avif"
              quality={74}
              loading="lazy"
              placeholder="blur"
              wrapperClass="motion-hover-media absolute inset-0"
              class="h-full w-full object-cover"
            />
          </div>
        </a>
      </li>
    ))
  }
</ol>

<style>
  .route-log {
    position: relative;
    list-style: none;
    /* Capped so the stop dot, title and frame still read as one line on wide
       screens instead of drifting to opposite edges. */
    max-width: 68rem;
    margin: 0;
    padding: 0;
  }

  /* A quiet path rather than a data rail. Larger dots and a softer dotted line
     keep the journey idea without making the feed feel like a timetable. */
  .route-log::before {
    content: "";
    position: absolute;
    top: 1.9rem;
    bottom: 1.9rem;
    left: 0.28rem;
    width: 0;
    border-left: 2px dotted color-mix(
      in oklch,
      var(--color-line-strong) 72%,
      transparent
    );
  }

  .route-stop__link {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: start;
    column-gap: 1.1rem;
    row-gap: 1rem;
    padding-block: 1.7rem;

    @media (width >= 900px) {
      grid-template-columns: auto minmax(0, 1fr) auto;
      column-gap: 2rem;
      align-items: center;
      padding-block: 2rem;
    }
  }

  .route-stop__dot {
    position: relative;
    z-index: 1;
    width: 0.72rem;
    height: 0.72rem;
    margin-top: 1.5rem;
    border-radius: 999px;
    background: var(--accent-base);
    box-shadow: 0 0 0 5px var(--color-surface);
    transition: scale var(--duration-ui) var(--ease-cinema);

    @media (width >= 900px) {
      margin-top: 0;
    }
  }

  .route-stop__link:hover .route-stop__dot {
    scale: 1.35;
  }

  .route-stop__body {
    min-width: 0;
  }

  .route-stop__kicker {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-accent-ink);
  }

  .route-stop__title {
    margin-top: 0.5rem;
    font-size: clamp(1.75rem, 1.2rem + 1.6vw, 2.6rem);
    line-height: 0.94;
    text-wrap: balance;
    transition: color var(--duration-ui) var(--ease-cinema);
  }

  .route-stop__link:hover .route-stop__title {
    color: var(--color-accent-ink);
  }

  .route-stop__place {
    margin-top: 0.5rem;
    font-family: var(--font-sans);
    font-size: 1rem;
    color: var(--color-ink-dim);
  }

  .route-stop__summary {
    max-width: 48ch;
    margin-top: 0.65rem;
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--color-ink-faint);
    text-wrap: pretty;
  }

  .route-stop__frame {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: clip;
    border-radius: 0.5rem;

    @media (width >= 900px) {
      width: 17rem;
    }
  }

  .route-stop__frame :global(img) {
    height: 100%;
    width: 100%;
    object-fit: cover;
  }
</style>
