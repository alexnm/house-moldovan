---
/**
 * Small solid glyph per article kind, matching the map pin badges. The line-art
 * `TypePictogram` set needs ~64px to read; this is the label-scale counterpart.
 */
import type { ArticleKind } from "~/lib/articles";

export interface Props {
  kind: ArticleKind;
  /** CSS length. Set here rather than by the parent: scoped styles cannot
      reach a child component's root element. */
  size?: string;
  class?: string;
}

const { kind, size = "1em", class: className } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  fill="currentColor"
  aria-hidden="true"
  class={className}
  style={`width:${size};height:${size};flex-shrink:0`}
>
  {
    kind === "story" && (
      <path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zm17.71-10.21a1 1 0 0 0 0-1.41l-2.34-2.34a1 1 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" />
    )
  }
  {
    kind === "itinerary" && (
      <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z" />
    )
  }
  {
    kind === "spotlight" && (
      <path d="M9 3h6l1.8 2H20a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h3.2L9 3Zm3 5.4a4.1 4.1 0 1 0 0 8.2 4.1 4.1 0 0 0 0-8.2Z" />
    )
  }
</svg>
