---
/**
 * Prototype switcher. Dev chrome only: deliberately plain so it never reads as
 * part of the design being evaluated.
 */
export interface Props {
  current: 1 | 2;
}

const { current } = Astro.props;

const LOOKS = [
  { n: 1, href: "/dev/look-1", label: "Field Notes" },
  { n: 2, href: "/dev/look-2", label: "The Atlas" },
] as const;
---

<div class="dev-look-bar">
  <a href="/dev" class="dev-look-bar__home">Looks</a>
  {
    LOOKS.map((look) => (
      <a
        href={look.href}
        class:list={[
          "dev-look-bar__item",
          look.n === current && "dev-look-bar__item--on",
        ]}
        aria-current={look.n === current ? "page" : undefined}
      >
        {look.n}. {look.label}
      </a>
    ))
  }
</div>

<style>
  .dev-look-bar {
    position: fixed;
    z-index: 60;
    bottom: 0.75rem;
    right: 0.75rem;
    display: flex;
    align-items: center;
    gap: 0.15rem;
    padding: 0.25rem;
    border-radius: 999px;
    border: 1px solid oklch(0.5 0 0 / 0.45);
    background: oklch(0.16 0 0 / 0.92);
    font-family: ui-monospace, monospace;
    font-size: 11px;
    color: oklch(0.85 0 0);
    box-shadow: 0 8px 24px -10px oklch(0 0 0 / 0.7);
  }

  .dev-look-bar__home {
    padding: 0.3rem 0.6rem;
    color: oklch(0.62 0 0);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 9px;
  }

  .dev-look-bar__item {
    padding: 0.3rem 0.65rem;
    border-radius: 999px;
    white-space: nowrap;
  }

  .dev-look-bar__item:hover {
    background: oklch(0.28 0 0);
  }

  .dev-look-bar__item--on {
    background: oklch(0.92 0 0);
    color: oklch(0.16 0 0);
  }

  @media (width < 640px) {
    .dev-look-bar__home {
      display: none;
    }
  }
</style>
