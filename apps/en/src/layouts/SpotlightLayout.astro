---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import Hero from "@shared/components/article/Hero.astro";
import SpotlightInfoCard from "~/components/article/SpotlightInfoCard.astro";
import SpotlightGallery from "~/components/article/SpotlightGallery.astro";
import { en } from "~/i18n/en";
import { abbreviateMonths } from "~/lib/months";
import { getPlace } from "~/lib/content";
import { articleListingHref, articleOgPath } from "~/lib/articles";
import {
  articleHeroLocation,
  countryLinks,
  regionAccentForPlaces,
  uniqueRegionLinks,
} from "~/lib/articlePlaces";
import { getAllRegions, regionMapById } from "~/lib/regions";
import { getReadNextArticles } from "~/lib/readNext";
import ReadNext from "~/components/article/ReadNext.astro";

export interface Props {
  entry: CollectionEntry<"spotlights">;
  hasIntro: boolean;
}

const { entry, hasIntro } = Astro.props;
const { data } = entry;

const places = await Promise.all(data.country.map((ref) => getPlace(ref)));
const resolved = places.filter((p): p is NonNullable<typeof p> => Boolean(p));
if (resolved.length === 0)
  throw new Error(`No countries found for spotlight ${entry.id}`);

const regionsById = regionMapById(await getAllRegions());
const accent = regionAccentForPlaces(resolved, regionsById);
const countryLabel =
  resolved.length > 1 ? en.article.countries : en.article.country;
const heroMeta = data.summary;
const items = [
  { label: countryLabel, value: countryLinks(resolved) },
  { label: en.region.kicker, value: uniqueRegionLinks(resolved, regionsById) },
  {
    label: en.article.type,
    value: en.article.storyType[data.type],
  },
  { label: en.article.months, value: abbreviateMonths(data.months) },
];

const heroLocation = await articleHeroLocation({ ...entry, kind: "spotlight" });
const readNext = await getReadNextArticles({ ...entry, kind: "spotlight" });
const ogImage = articleOgPath({ ...entry, kind: "spotlight" });
const description = data.summary;
---

<BaseLayout
  title={`${data.title} · ${en.siteName}`}
  description={description}
  type="article"
  ogImage={ogImage}
  noindex={data.draft}
>
  <article class="accent-scope" data-accent={accent}>
    <Hero
      image={data.hero}
      alt={data.title}
      kicker={en.article.spotlight}
      kickerHref={articleListingHref("spotlight")}
      title={data.title}
      meta={heroMeta}
      location={heroLocation}
      accent={accent}
      transitionName={`hero-${entry.id}`}
    />

    <div
      class="section section-y grid gap-6 lg:grid-cols-[26rem_minmax(0,1fr)] lg:items-start"
    >
      <div class="spotlight-rail" data-spotlight-rail>
        <SpotlightInfoCard items={items} hasIntro={hasIntro}>
          <slot />
        </SpotlightInfoCard>
      </div>

      <SpotlightGallery
        title={data.title}
        photos={data.photos.map((p) => ({
          image: p.image,
          caption: p.caption,
          tagline: p.tagline,
        }))}
      />
    </div>

    {
      readNext.length > 0 && (
        <div class="motion-reveal section-divider">
          <ReadNext articles={readNext} />
        </div>
      )
    }

    <nav class="section mt-4 mb-24">
      <a href="/journal" class="link-more link-accent link-accent--dim">
        ← {en.article.backToJournal}
      </a>
    </nav>
  </article>
</BaseLayout>

<style>
  /* The card stays beside the photos while they scroll, but only when it fits
     the viewport; a taller card (long intro) scrolls with the page instead. */
  @media (min-width: 64rem) {
    .spotlight-rail[data-fits] {
      position: sticky;
      top: 6rem;
    }
  }
</style>

<script>
  function fitSpotlightRails() {
    document
      .querySelectorAll<HTMLElement>("[data-spotlight-rail]")
      .forEach((rail) => {
        const fits = rail.offsetHeight <= window.innerHeight - 128;
        rail.toggleAttribute("data-fits", fits);
      });
  }

  fitSpotlightRails();
  document.addEventListener("astro:page-load", fitSpotlightRails);
  window.addEventListener("resize", fitSpotlightRails, { passive: true });
</script>
