---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import Hero from "@shared/components/article/Hero.astro";
import Prose from "@shared/components/article/Prose.astro";
import ItineraryTripCard, {
  type Fact,
} from "~/components/article/ItineraryTripCard.astro";
import ItineraryParts from "~/components/article/ItineraryParts.astro";
import ItineraryHighlights from "~/components/article/ItineraryHighlights.astro";
import { en } from "~/i18n/en";
import { abbreviateMonths } from "~/lib/months";
import { getPlace } from "~/lib/content";
import { articleListingHref } from "~/lib/articles";
import {
  articleHeroLocation,
  countryLinks,
  regionAccentForPlaces,
  uniqueRegionLinks,
} from "~/lib/articlePlaces";
import { getAllRegions, regionMapById } from "~/lib/regions";
import { buildLocationIndex } from "~/lib/locations";
import {
  buildItineraryBases,
  buildRouteMap,
  heroRouteFromLocations,
  itineraryBaseCount,
  itineraryDayCount,
  uniqueStops,
} from "~/lib/itinerary";
import { getReadNextArticles } from "~/lib/readNext";
import ReadNext from "~/components/article/ReadNext.astro";
import type { MarkdownHeading } from "@astrojs/markdown-remark";
import { buildBodyToc } from "~/lib/bodyToc";
import ArticleToc from "~/components/article/ArticleToc.astro";

export interface Props {
  entry: CollectionEntry<"itineraries">;
  contentHeadings: MarkdownHeading[];
}

const { entry, contentHeadings } = Astro.props;
const { data } = entry;

const toc = buildBodyToc(contentHeadings);
const hasToc = toc.length > 0;

const headerPlaces = await Promise.all(
  data.country.map((ref) => getPlace(ref)),
);
const resolved = headerPlaces.filter((p): p is NonNullable<typeof p> =>
  Boolean(p),
);
if (resolved.length === 0)
  throw new Error(`No countries in country[] for itinerary ${entry.id}`);

const regionsById = regionMapById(await getAllRegions());
const accent = regionAccentForPlaces(resolved, regionsById);
const countryLabel =
  resolved.length > 1 ? en.article.countries : en.article.country;
const dayCount = itineraryDayCount(data.bases);
const locationIndex = await buildLocationIndex();

const resolveStop = (id: string, day: number) => {
  const loc = locationIndex.get(id);
  if (!loc) {
    throw new Error(
      `Itinerary ${entry.id} day ${day}: unknown location "${id}"`,
    );
  }
  return loc;
};

let dayIndex = 0;
const bases = data.bases.map((base) => {
  const location = locationIndex.get(base.location);
  if (!location) {
    throw new Error(
      `Itinerary ${entry.id}: unknown base "${base.location}"`,
    );
  }
  const days = base.days.map((d) => {
    dayIndex += 1;
    return {
      dayIndex,
      description: d.description,
      locations: d.locations.map((id) => resolveStop(id, dayIndex)),
    };
  });
  return {
    location,
    title: base.title,
    image: base.image,
    toNext: base.toNext,
    hidden: base.hidden,
    days,
  };
});

const dayRows = bases.flatMap((base) => base.days);
const routeLocations = dayRows.flatMap((day) => day.locations);
const placeNames = heroRouteFromLocations(routeLocations);
const pageDescription = data.summary;

const parts = buildItineraryBases(bases, contentHeadings);
const routeMap = buildRouteMap(dayRows, parts);
const stops = uniqueStops(dayRows);
const gettingAround = [data.gettingAround].flat();

const facts: Fact[] = [
  { label: countryLabel, value: countryLinks(resolved) },
  { label: en.region.kicker, value: uniqueRegionLinks(resolved, regionsById) },
  {
    label: en.article.itineraryRouteFact,
    value: [
      {
        label: en.article.itineraryRouteCount(
          itineraryBaseCount(parts),
          stops.length,
        ),
        href: "#itinerary-route-heading",
      },
    ],
  },
  { label: en.article.itineraryDuration, value: en.article.days(dayCount) },
  {
    label: en.article.itineraryGettingAround,
    transport: gettingAround,
  },
  { label: en.article.months, value: abbreviateMonths(data.months) },
];

const highlights = data.highlights.map((h) => {
  const loc = locationIndex.get(h.location);
  if (!loc) {
    throw new Error(
      `Itinerary ${entry.id}: unknown highlight location "${h.location}"`,
    );
  }
  const label = h.title || loc.name;
  return { image: h.image, caption: label, location: label };
});

const heroLocation = await articleHeroLocation({ ...entry, kind: "itinerary" });
const readNext = await getReadNextArticles({ ...entry, kind: "itinerary" });
---

<BaseLayout
  title={`${data.title} · ${en.siteName}`}
  description={pageDescription}
  type="article"
  ogImage={`/og/itineraries/${entry.id}.png`}
  noindex={data.draft}
>
  <article class="itinerary-page accent-scope" data-accent={accent}>
    <Hero
      image={data.hero}
      alt={data.title}
      kicker={en.article.itinerary}
      kickerHref={articleListingHref("itinerary")}
      title={data.title}
      meta={data.summary}
      location={heroLocation}
      transitionName={`hero-${entry.id}`}
    />

    <div
      class="section itinerary-intro relative z-10 grid gap-y-12 pt-10 lg:grid-cols-[minmax(0,1fr)_32.5rem] lg:gap-x-18 lg:pt-0"
    >
      <div class="lg:col-start-2 lg:row-start-1 lg:-mt-56">
        <ItineraryTripCard
          facts={facts}
          why={data.why}
          map={routeMap}
          mapLabel={`Route map: ${placeNames}`}
        />
      </div>
      <div class="lg:col-start-1 lg:row-start-1 lg:pt-18">
        <ItineraryParts parts={parts.filter((part) => !part.hidden)} />
      </div>
    </div>

    <div class="section section-y">
      <ItineraryHighlights highlights={highlights} />
    </div>

    <div
      class:list={[
        "section section-y section-gap grid",
        hasToc && "md:grid-cols-[14rem_1fr]",
      ]}
    >
      {hasToc && <ArticleToc sections={toc} />}

      <div class="min-w-0">
        <Prose class="itinerary-prose mx-0!">
          <slot />
        </Prose>
      </div>
    </div>

    {
      readNext.length > 0 && (
        <div class="motion-reveal section-divider">
          <ReadNext articles={readNext} />
        </div>
      )
    }

    <nav class="section mt-4 mb-24">
      <a href="/journal" class="link-more link-accent link-accent--dim">
        ← {en.article.backToJournal}
      </a>
    </nav>
  </article>
</BaseLayout>

<style>
  /* Leave room for the trip card that overlaps the bottom-right of the hero. */
  @media (min-width: 64rem) {
    :global(.itinerary-page [data-nav-hero] .hero-bottom > *) {
      max-width: min(100%, calc(100% - 36rem));
    }
  }

  /* Short regional tick above each day section in the story. */
  :global(.itinerary-prose h2::before) {
    content: "";
    display: block;
    width: 3rem;
    height: 4px;
    margin-bottom: 1.1rem;
    border-radius: 1px;
    background: var(--color-accent);
  }
</style>
