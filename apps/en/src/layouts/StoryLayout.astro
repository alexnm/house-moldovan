---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import Hero from "@shared/components/article/Hero.astro";
import Prose from "@shared/components/article/Prose.astro";
import StoryInfoCard from "~/components/article/StoryInfoCard.astro";
import ArticleLightbox from "~/components/article/ArticleLightbox.astro";
import { readingMinutes } from "~/lib/readingTime";
import { en } from "~/i18n/en";
import { abbreviateMonths } from "~/lib/months";
import { getPlace } from "~/lib/content";
import { articleListingHref, articleOgPath } from "~/lib/articles";
import {
  articleHeroLocation,
  countryLinks,
  regionAccentForPlaces,
  uniqueRegionLinks,
} from "~/lib/articlePlaces";
import { getAllRegions, regionMapById } from "~/lib/regions";
import { getReadNextArticles } from "~/lib/readNext";
import ReadNext from "~/components/article/ReadNext.astro";
import type { MarkdownHeading } from "@astrojs/markdown-remark";
import { buildBodyToc } from "~/lib/bodyToc";

export interface Props {
  entry: CollectionEntry<"stories">;
  contentHeadings: MarkdownHeading[];
}

const { entry, contentHeadings } = Astro.props;
const { data } = entry;

const toc = buildBodyToc(contentHeadings);

const places = await Promise.all(data.country.map((ref) => getPlace(ref)));
const resolved = places.filter((p): p is NonNullable<typeof p> => Boolean(p));
if (resolved.length === 0)
  throw new Error(`No countries found for story ${entry.id}`);

const regionsById = regionMapById(await getAllRegions());
const accent = regionAccentForPlaces(resolved, regionsById);
const countryLabel =
  resolved.length > 1 ? en.article.countries : en.article.country;
const items = [
  { label: countryLabel, value: countryLinks(resolved) },
  { label: en.region.kicker, value: uniqueRegionLinks(resolved, regionsById) },
  {
    label: en.article.type,
    value: en.article.storyType[data.type],
  },
  { label: en.article.months, value: abbreviateMonths(data.months) },
  {
    label: en.article.readingTime,
    value: en.article.minutesRead(readingMinutes(entry.body)),
  },
  { label: en.article.published, value: en.date.monthYear(data.published) },
];

const heroLocation = await articleHeroLocation({ ...entry, kind: "story" });
const readNext = await getReadNextArticles({ ...entry, kind: "story" });
const ogImage = articleOgPath({ ...entry, kind: "story" });
---

<BaseLayout
  title={`${data.title} · ${en.siteName}`}
  description={data.summary}
  type="article"
  ogImage={ogImage}
  noindex={data.draft}
>
  <article class="accent-scope" data-accent={accent}>
    <Hero
      image={data.hero}
      alt={data.title}
      kicker={en.article.story}
      kickerHref={articleListingHref("story")}
      title={data.title}
      meta={data.summary}
      location={heroLocation}
      accent={accent}
      transitionName={`hero-${entry.id}`}
    />

    <div
      class="section section-y grid gap-10 lg:grid-cols-[25rem_minmax(0,1fr)] lg:items-start lg:gap-14"
    >
      <div class="story-rail" data-story-rail>
        <StoryInfoCard items={items} sections={toc} />
      </div>
      <div class="min-w-0">
        <Prose class="mx-0!">
          <slot />
        </Prose>
      </div>
    </div>

    <ArticleLightbox title={data.title} />

    {
      readNext.length > 0 && (
        <div class="motion-reveal section-divider">
          <ReadNext articles={readNext} />
        </div>
      )
    }

    <nav class="section mt-4 mb-24">
      <a href="/journal" class="link-more link-accent link-accent--dim">
        ← {en.article.backToJournal}
      </a>
    </nav>
  </article>
</BaseLayout>

<style>
  /* The card (facts + contents) stays beside the story while it scrolls,
     but only when it fits the viewport. */
  @media (min-width: 64rem) {
    .story-rail[data-fits] {
      position: sticky;
      top: 6rem;
    }
  }
</style>

<script>
  function fitStoryRails() {
    document
      .querySelectorAll<HTMLElement>("[data-story-rail]")
      .forEach((rail) => {
        const fits = rail.offsetHeight <= window.innerHeight - 128;
        rail.toggleAttribute("data-fits", fits);
      });
  }

  fitStoryRails();
  document.addEventListener("astro:page-load", fitStoryRails);
  window.addEventListener("resize", fitStoryRails, { passive: true });
</script>
