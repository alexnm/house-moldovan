---
import CrestMark from "~/components/layout/CrestMark.astro";
import AtlasVerticalCard from "~/components/ro/AtlasVerticalCard.astro";
import { ro } from "~/i18n/ro";
import type { RoAtlasRangeTile } from "~/lib/roHome";

export interface Props {
  rangeTiles: RoAtlasRangeTile[];
  /** Anchor id for the hikes section smooth-scroll target */
  hikesAnchor?: string;
}

const { rangeTiles, hikesAnchor = "trasee" } = Astro.props;
---

<section
  class="atlas-wall relative isolate h-svh min-h-svh w-full overflow-clip"
  data-nav-hero
  data-nav-minimal
>
  <ul
    class="atlas-wall__columns grid h-full w-full grid-cols-3 grid-rows-2 gap-px bg-surface md:grid-cols-6 md:grid-rows-1"
  >
    {
      rangeTiles.map(({ range, atlas, count }) => (
        <AtlasVerticalCard
          href={`/munti/${range.id}`}
          title={range.data.name}
          countLabel={ro.range.countOf(count)}
          image={atlas}
          imageAlt={`Peisaj din ${range.data.name}`}
          priority
        />
      ))
    }
  </ul>

  <div
    class="atlas-wall__footer pointer-events-none absolute inset-x-0 bottom-0 z-20"
  >
    <div class="atlas-wall__footer-scrim" aria-hidden="true"></div>
    <div
      class="pad-canvas pointer-events-none relative mx-auto max-w-canvas pb-8 text-center md:pb-10"
    >
      <div
        class="atlas-wall__emblem pointer-events-none mb-6 flex justify-center 2xl:mb-8"
        aria-hidden="true"
      >
        <div class="atlas-wall__emblem-disc pointer-events-none">
          <span class="atlas-wall__emblem-mark pointer-events-none">
            <CrestMark />
          </span>
        </div>
      </div>
      <h1
        class="display region-name atlas-wall__title hero-on-photo mx-auto max-w-[14ch] animate-cinema-rise leading-[0.76] tracking-[-0.06em] text-balance uppercase"
      >
        {ro.siteName}
      </h1>
      <a
        href={`#${hikesAnchor}`}
        class="link-accent micro pointer-events-auto mt-8 inline-block opacity-90 2xl:mt-16"
      >
        {ro.home.exploreAll} →
      </a>
    </div>
  </div>
</section>

<style>
  .atlas-wall__columns {
    min-height: 100svh;
    height: 100svh;
  }

  .atlas-wall__emblem-disc {
    display: flex;
    align-items: center;
    justify-content: center;
    width: clamp(4rem, 2rem + 4.5vw, 9.5rem);
    height: clamp(4rem, 2rem + 4.5vw, 9.5rem);
    border-radius: 9999px;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    box-shadow: 0 12px 40px -12px oklch(0 0 0 / 0.45);
  }

  .atlas-wall__emblem-mark {
    display: block;
    width: clamp(2.75rem, 1.5rem + 3.25vw, 7rem);
    height: auto;
    color: var(--color-ink);
  }

  .atlas-wall__footer-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      var(--color-photo-scrim) 0%,
      color-mix(in oklch, var(--color-photo-scrim) 60%, transparent) 20%,
      transparent 40%
    );
  }

  .atlas-wall__title {
    font-size: clamp(3.25rem, 2rem + 5.5vw, 10.5rem);
    text-shadow: 0 2px 40px
      color-mix(in oklch, var(--color-photo-scrim) 65%, transparent);
  }
</style>
