---
import { ro } from "~/i18n/ro";
import CrestMark from "~/components/layout/CrestMark.astro";
import SiteLogo from "@shared/components/layout/SiteLogo.astro";

const path = Astro.url.pathname;

export interface Props {
  /** Viewport-fit pages stack the bar above their content instead of over it. */
  inFlow?: boolean;
}

const { inFlow = false } = Astro.props;

type NavLink = {
  href: string;
  label: string;
  /** Extra path prefixes that count as this link's section. */
  match?: string[];
};

const links: NavLink[] = [
  { href: "/trasee", label: ro.nav.trasee },
  // Massif pages live under `/munti`, but the map is where they are listed.
  { href: "/harta", label: ro.nav.harta, match: ["/harta", "/munti"] },
];

const isActive = (link: NavLink): boolean =>
  (link.match ?? [link.href]).some((prefix) =>
    prefix === "/" ? path === "/" : path.startsWith(prefix),
  );
---

<nav
  class:list={[
    "site-nav z-40 pt-5 pb-4",
    inFlow ? "relative" : "fixed inset-x-0 top-0",
  ]}
  data-site-nav
  aria-label="Navigare"
>
  <div
    class="pad-canvas mx-auto flex max-w-canvas items-center justify-between gap-4 sm:gap-6"
  >
    <SiteLogo href="/" label={ro.siteName}>
      <CrestMark slot="mark" />
    </SiteLogo>

    <ul class="flex items-center gap-5 leading-[1.2] sm:gap-7">
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              class:list={["nav-link link-accent", isActive(l) && "is-active"]}
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</nav>
