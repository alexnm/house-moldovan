---
import { ro } from "~/i18n/ro";
import { SISTER_SITE_URL } from "~/lib/site";
import CrestMark from "~/components/layout/CrestMark.astro";
import SiteLogo from "@shared/components/layout/SiteLogo.astro";
import ThemeToggle from "@shared/components/layout/ThemeToggle.astro";

const year = new Date().getFullYear();

const navLinks = [
  { href: "/trasee", label: ro.nav.trasee },
  { href: "/harta", label: ro.nav.harta },
];
---

<footer class="mt-32 bg-surface-2">
  <div
    class="pad-canvas mx-auto grid max-w-canvas grid-cols-1 gap-y-10 py-16 md:grid-cols-[2fr_1fr_1fr] md:gap-12"
  >
    <div>
      <SiteLogo size="footer" link={false} href="/" label={ro.siteName}>
        <CrestMark slot="mark" />
      </SiteLogo>
      <p class="mt-3 max-w-md text-ink-dim">{ro.description}</p>
      <p class="micro mt-8 text-ink-faint">
        © {year}. {ro.footer.rights}
      </p>
      <ThemeToggle
        lightLabel={ro.footer.themeLight}
        darkLabel={ro.footer.themeDark}
      />
    </div>

    <div>
      <ul class="space-y-2 text-ink-dim">
        {
          navLinks.map((link) => (
            <li>
              <a href={link.href} class="link-accent link-accent--dim">
                {link.label}
              </a>
            </li>
          ))
        }
        <li>
          <a href="/rss.xml" class="link-accent link-accent--dim">
            {ro.footer.rssLabel}
          </a>
        </li>
      </ul>
    </div>

    <div>
      <a
        href={SISTER_SITE_URL}
        class="duration-ui block rounded-lg border border-line p-4 transition-colors ease-cinema hover:border-line-strong"
        target="_blank"
        rel="noopener noreferrer"
      >
        <p class="micro text-ink-faint">{ro.footer.enKicker}</p>
        <p class="display mt-1 text-lg">{ro.footer.enCta} →</p>
      </a>
    </div>
  </div>
</footer>
