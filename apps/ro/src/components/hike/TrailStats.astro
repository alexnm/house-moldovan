---
import { ro } from "~/i18n/ro";
import type { WaymarkCode } from "~/lib/waymarks";
import WaymarkBadge from "./WaymarkBadge.astro";

export interface Props {
  range: { name: string; href: string };
  distance: number;
  shape: "dus-intors" | "circuit" | "traversare";
  elevationGain: number;
  summit?: number;
  duration: readonly [number, number];
  difficulty: "usor" | "mediu" | "dificil" | "tehnic";
  waymark: readonly WaymarkCode[];
  season: ReadonlyArray<"primavara" | "vara" | "toamna" | "iarna">;
  trailhead: { name: string; url?: string };
}

const {
  range,
  distance,
  shape,
  elevationGain,
  summit,
  duration,
  difficulty,
  waymark,
  season,
  trailhead,
} = Astro.props;

const seasonLabel = season.map((s) => ro.season[s]).join(", ");

const primary = [
  { label: ro.hike.difficulty, value: ro.difficulty[difficulty] },
  { label: ro.hike.duration, value: ro.units.duration(duration) },

  { label: ro.hike.shape, value: ro.shape[shape] },
];

const secondary = [
  { label: ro.hike.distance, value: ro.units.distance(distance) },
  {
    label: ro.hike.elevationGain,
    value: `+${ro.units.elevation(elevationGain)}`,
  },
  ...(summit
    ? [{ label: ro.hike.summit, value: ro.units.elevation(summit) }]
    : []),
  { label: ro.hike.season, value: seasonLabel },
];

/** Below md: label · value on one row; md+: stacked like the sidebar. */
const row =
  "flex items-baseline justify-between gap-x-4 md:block";
const label = "micro shrink-0 text-ink-dim";
const value =
  "min-w-0 text-right font-mono text-base text-ink md:mt-0.5 md:text-left";
---

<aside class="motion-reveal" aria-label={ro.hike.stats}>
  <dl class="space-y-3 md:space-y-4">
    <div class={row}>
      <dt class={label}>{ro.hike.range}</dt>
      <dd class={value}>
        <a href={range.href} class="link-accent">{range.name}</a>
      </dd>
    </div>
    {
      primary.map((s) => (
        <div class={row}>
          <dt class={label}>{s.label}</dt>
          <dd class={value}>{s.value}</dd>
        </div>
      ))
    }
  </dl>

  <dl class="mt-6 space-y-3 border-t border-line pt-6 md:mt-8 md:space-y-4 md:pt-8">
    {
      secondary.map((s) => (
        <div class={row}>
          <dt class={label}>{s.label}</dt>
          <dd class={value}>{s.value}</dd>
        </div>
      ))
    }
    <div class={row}>
      <dt class={label}>{ro.hike.trailhead}</dt>
      <dd class={value}>
        {
          trailhead.url ? (
            <a
              href={trailhead.url}
              target="_blank"
              rel="noopener noreferrer"
              class="link-accent"
            >
              {trailhead.name}
            </a>
          ) : (
            trailhead.name
          )
        }
      </dd>
    </div>

    <div class="flex items-center justify-between gap-x-4 md:block">
      <dt class={label}>{ro.hike.waymark}</dt>
      <dd class="md:mt-1.5"><WaymarkBadge marks={waymark} /></dd>
    </div>
  </dl>
</aside>
