---
import { ro } from "~/i18n/ro";
import {
  ELEVATION_LABEL_PX,
  ELEVATION_PROFILE_LAYOUT,
  ELEVATION_PROFILE_LAYOUT_COMPACT,
  renderProfileSvg,
  type ElevationPoint,
} from "@shared/lib/gpx";
import { HIKE_PROFILE_SCRUB_EVENT } from "~/lib/hikeScrub";

export interface Props {
  profile: ElevationPoint[];
  minElevation: number;
  maxElevation: number;
  /** GPX-derived length: chart geometry + hover position along the track. */
  distanceKm: number;
  /** Frontmatter distance shown next to the profile title (not necessarily GPX length). */
  publishedDistanceKm: number;
}

const { profile, minElevation, maxElevation, distanceKm, publishedDistanceKm } =
  Astro.props;
const keyboardHintId = "elev-profile-keyboard-hint";
const liveId = "elev-profile-live";

/** One chart per breakpoint: a phone-sized viewBox keeps the axis labels at
    12px, which a single wide viewBox cannot do without skewing them. */
const layouts = [ELEVATION_PROFILE_LAYOUT_COMPACT, ELEVATION_PROFILE_LAYOUT];
const charts = layouts.map((layout) =>
  renderProfileSvg(profile, distanceKm, {
    layout,
    ariaLabel: ro.hike.profile,
    describedById: keyboardHintId,
  }),
);
---

<figure class="motion-reveal elevation-profile-figure" data-elevation-profile>
  <figcaption
    class="mb-3 flex flex-col items-baseline justify-between sm:flex-row"
  >
    <span class="micro text-ink-faint">{ro.hike.profile}</span>
    <span class="micro text-ink-dim">
      {ro.units.elevation(minElevation)} – {ro.units.elevation(maxElevation)} ·
      {ro.units.distance(publishedDistanceKm)}
    </span>
  </figcaption>
  <p id={keyboardHintId} class="sr-only">{ro.hike.profileKeyboard}</p>
  <p id={liveId} class="sr-only" aria-live="polite"></p>
  <div class="overflow-clip rounded border border-line bg-surface-2">
    <div class="sm:hidden" set:html={charts[0]} />
    <div class="hidden sm:block" set:html={charts[1]} />
  </div>
</figure>

<style>
  /* The ink accents are darkened for the light canvas, so thin the area wash
     to keep the ridge line the dominant mark. */
  :global(html[data-theme="light"])
    .elevation-profile-figure
    :global(.elev-area) {
    fill-opacity: 0.12;
  }

  /* Height follows the viewBox, so both charts scale uniformly. */
  .elevation-profile-figure :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }
</style>

<script
  define:vars={{
    profile,
    distanceKm,
    elevLayouts: layouts,
    labelPx: ELEVATION_LABEL_PX,
    liveId,
    scrubEvent: HIKE_PROFILE_SCRUB_EVENT,
  }}
>
  (function () {
    if (!Array.isArray(profile) || profile.length < 2) return;

    function interpolate(ps, d) {
      if (d <= ps[0].d)
        return { d, h: ps[0].h, lng: ps[0].lng, lat: ps[0].lat };
      const last = ps[ps.length - 1];
      if (d >= last.d) return { d, h: last.h, lng: last.lng, lat: last.lat };
      let lo = 0;
      let hi = ps.length - 1;
      while (hi - lo > 1) {
        const mid = (lo + hi) >> 1;
        if (ps[mid].d <= d) lo = mid;
        else hi = mid;
      }
      const a = ps[lo];
      const b = ps[hi];
      const t = (d - a.d) / (b.d - a.d || 1);
      return {
        d,
        h: a.h + t * (b.h - a.h),
        lng: a.lng + t * (b.lng - a.lng),
        lat: a.lat + t * (b.lat - a.lat),
      };
    }

    function emitScrub(detail) {
      document.dispatchEvent(new CustomEvent(scrubEvent, { detail }));
    }

    function fmtElev(m) {
      return `${Math.round(m).toLocaleString("ro-RO")} m`;
    }
    function fmtDist(km) {
      return km < 1
        ? `${Math.round(km * 1000)} m`
        : `${km.toLocaleString("ro-RO", { maximumFractionDigits: 1 })} km`;
    }

    function initChart(svg, elevLayout, live) {
      const hit = svg.querySelector(".elev-hit");
      const group = svg.querySelector(".elev-hover-group");
      const vline = svg.querySelector(".elev-vline");
      const dot = svg.querySelector(".elev-dot");
      const label = svg.querySelector(".elev-readout");
      const distLabel = svg.querySelector(".elev-readout-dist");
      if (!hit || !group || !vline || !dot || !label || !distLabel) return;

      const W = elevLayout.width;
      const ml = elevLayout.marginLeft;
      const mr = elevLayout.marginRight;
      const mt = elevLayout.marginTop;
      const mb = elevLayout.marginBottom;
      const innerL = ml;
      const innerR = W - mr;
      const innerT = mt;
      const innerB = elevLayout.height - mb;

      const xs = profile.map((p) => p.d);
      const xMin = Math.min(...xs);
      const xMax = distanceKm;
      const xR = xMax - xMin || 1;
      const ys = profile.map((p) => p.h);
      const yMin = Math.min(...ys);
      const yMax = Math.max(...ys);
      const yR = yMax - yMin || 1;

      const sx = (d) => innerL + ((d - xMin) / xR) * (innerR - innerL);
      const sy = (h) => innerB - ((h - yMin) / yR) * (innerB - innerT);

      // Labels are sized in user units, so the size that renders at labelPx
      // depends on how far the viewBox is being scaled right now.
      let fs = elevLayout.fontSize;
      const measureLabel = () => {
        const w = svg.getBoundingClientRect().width;
        if (!w) return;
        fs = Math.min(labelPx / (w / elevLayout.width), elevLayout.maxFontSize);
        svg.style.setProperty("--elev-label", `${fs.toFixed(2)}px`);
      };
      measureLabel();
      // Observe the wrapper, not the SVG: resize callbacks do not fire for SVG
      // elements in every browser.
      const box = svg.parentElement;
      if (typeof ResizeObserver === "function" && box) {
        const observer = new ResizeObserver(measureLabel);
        observer.observe(box);
      } else {
        window.addEventListener("resize", measureLabel);
      }

      const labelY = innerT + 6;
      const step = Math.max(xR / 40, 0.05);
      let cursorD = xMin;
      let pointerActive = false;

      function clientToSvg(svgEl, clientX, clientY) {
        const pt = svgEl.createSVGPoint();
        pt.x = clientX;
        pt.y = clientY;
        const ctm = svgEl.getScreenCTM();
        if (!ctm) return null;
        return pt.matrixTransform(ctm.inverse());
      }

      function hide() {
        if (pointerActive) return;
        if (document.activeElement === hit) return;
        group.setAttribute("opacity", "0");
        emitScrub({ active: false });
      }

      function showAtDistance(d, announce) {
        const clamped = Math.min(xMax, Math.max(xMin, d));
        cursorD = clamped;
        const { h, lng, lat } = interpolate(profile, clamped);
        const px = sx(clamped);
        const py = sy(h);
        const elevText = fmtElev(h);
        const distText = fmtDist(clamped);
        const valueText = `${elevText}, ${distText}`;
        const valueNow = Math.round(((clamped - xMin) / xR) * 100);

        vline.setAttribute("x1", String(px));
        vline.setAttribute("x2", String(px));

        dot.setAttribute("cx", String(px));
        dot.setAttribute("cy", String(py));

        label.textContent = elevText;
        distLabel.textContent = distText;

        const nearRight = px > innerR - fs * 5;
        const anchor = nearRight ? "end" : "start";
        const dx = nearRight ? -6 : 6;
        label.setAttribute("x", String(px));
        label.setAttribute("y", String(labelY));
        label.setAttribute("text-anchor", anchor);
        label.setAttribute("dx", String(dx));
        distLabel.setAttribute("x", String(px));
        distLabel.setAttribute("y", String(labelY + fs + 4));
        distLabel.setAttribute("text-anchor", anchor);
        distLabel.setAttribute("dx", String(dx));

        hit.setAttribute("aria-valuenow", String(valueNow));
        hit.setAttribute("aria-valuetext", valueText);
        if (announce && live) live.textContent = valueText;

        group.setAttribute("opacity", "1");
        emitScrub({ active: true, d: clamped, lng, lat });
      }

      function showAtPointer(clientX, clientY) {
        const loc = clientToSvg(svg, clientX, clientY);
        if (!loc) return;
        const mx = loc.x;
        const my = loc.y;
        if (mx < innerL || mx > innerR || my < innerT || my > innerB) {
          hide();
          return;
        }
        const d = xMin + ((mx - innerL) / (innerR - innerL)) * xR;
        showAtDistance(d, false);
      }

      hit.addEventListener("pointermove", (e) => {
        pointerActive = true;
        showAtPointer(e.clientX, e.clientY);
      });
      hit.addEventListener("pointerleave", () => {
        pointerActive = false;
        hide();
      });
      hit.addEventListener("focus", () => {
        showAtDistance(cursorD, true);
      });
      hit.addEventListener("blur", () => {
        pointerActive = false;
        group.setAttribute("opacity", "0");
        emitScrub({ active: false });
      });
      hit.addEventListener("keydown", (e) => {
        let next;
        if (e.key === "ArrowRight" || e.key === "ArrowUp") {
          next = cursorD + step;
        } else if (e.key === "ArrowLeft" || e.key === "ArrowDown") {
          next = cursorD - step;
        } else if (e.key === "Home") {
          next = xMin;
        } else if (e.key === "End") {
          next = xMax;
        } else {
          return;
        }
        e.preventDefault();
        showAtDistance(next, true);
      });
    }

    document.querySelectorAll("[data-elevation-profile]").forEach((wrap) => {
      const live = wrap.querySelector(`#${liveId}`);
      wrap.querySelectorAll("svg").forEach((svg, i) => {
        initChart(svg, elevLayouts[i] ?? elevLayouts[0], live);
      });
    });
  })();
</script>
