---
import type { CollectionEntry } from "astro:content";
import RoLayout from "./RoLayout.astro";
import Hero from "@shared/components/article/Hero.astro";
import Prose from "@shared/components/article/Prose.astro";
import TrailStats from "~/components/hike/TrailStats.astro";
import ElevationProfile from "~/components/hike/ElevationProfile.astro";
import HikeMap from "~/components/hike/HikeMap.astro";
import ReadNext from "~/components/ro/ReadNext.astro";
import { ro } from "~/i18n/ro";
import { getRange } from "~/lib/content";
import { getGpxTrack, hasGpxElevationProfile, parseGpx } from "@shared/lib/gpx";
import { getReadNextHikes } from "~/lib/readNextHikes";

export interface Props {
  entry: CollectionEntry<"hikes">;
}

const { entry } = Astro.props;
const { data } = entry;

const range = await getRange(data.range);
if (!range) throw new Error(`Range not found for hike ${entry.id}`);

const track = parseGpx(data.gpx);
const gpxTrack = getGpxTrack(data.gpx);
const gpxHref = data.gpx.startsWith("/") ? data.gpx : `/${data.gpx}`;
const showElevationProfile = hasGpxElevationProfile(track);
const hasMapPanel = Boolean(gpxTrack) || showElevationProfile;
const readNext = await getReadNextHikes(entry);
---

<RoLayout
  title={`${data.title} · ${ro.siteName}`}
  description={data.summary}
  type="article"
  ogImage={`/og/${entry.id}.png`}
  noindex={data.draft}
>
  <article>
    <Hero
      image={data.hero}
      alt={data.title}
      kicker={range.data.name}
      kickerHref={`/munti/${range.id}`}
      title={data.title}
      meta={data.summary}
      transitionName={`hike-${entry.id}`}
    />

    <section
      class:list={[
        "section section-y-tight",
        hasMapPanel && "grid gap-10 lg:grid-cols-[14rem_1fr] lg:gap-12",
      ]}
    >
      <div class="space-y-8">
        <TrailStats
          distance={data.distance}
          shape={data.shape}
          elevationGain={data.elevationGain}
          summit={data.summit}
          duration={data.duration}
          difficulty={data.difficulty}
          waymark={data.waymark}
          season={data.season}
          trailhead={data.trailhead}
        />

        {
          !gpxTrack && (
            <a
              href={gpxHref}
              download
              class="link-accent link-accent--dim micro inline-block"
            >
              {ro.hike.gpxDownload} ↓
            </a>
          )
        }
      </div>

      {
        hasMapPanel && (
          <div class="min-w-0 space-y-8">
            {gpxTrack && (
              <div class="accent-scope" data-accent="terracotta">
                <HikeMap line={gpxTrack.line} gpxHref={gpxHref} />
              </div>
            )}
            {showElevationProfile && (
              <div class="accent-scope" data-accent="saffron">
                <ElevationProfile
                  profile={track.profile}
                  minElevation={track.minElevation}
                  maxElevation={track.maxElevation}
                  distanceKm={track.distanceKm}
                  publishedDistanceKm={data.distance}
                />
              </div>
            )}
          </div>
        )
      }
    </section>

    <div class="accent-scope" data-accent="saffron">
      <Prose class="section mt-16">
        <slot />
      </Prose>
    </div>

    {
      readNext.length > 0 && (
        <div class="section-divider">
          <ReadNext hikes={readNext} />
        </div>
      )
    }
  </article>
</RoLayout>
