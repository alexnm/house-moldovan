---
import BaseHead from "@shared/components/layout/BaseHead.astro";
import NavRo from "~/components/layout/NavRo.astro";
import SiteNavScroll from "@shared/components/layout/SiteNavScroll.astro";
import FooterRo from "~/components/layout/FooterRo.astro";
import { ro } from "~/i18n/ro";
import "~/styles/app.css";
import "~/styles/fonts.css";

export interface Props {
  title: string;
  description: string;
  ogImage?: string;
  type?: "website" | "article";
  bodyClass?: string;
  noindex?: boolean;
}

const { title, description, ogImage, type, bodyClass, noindex } = Astro.props;
---

<!doctype html>
<html lang="ro">
  <head>
    <BaseHead
      title={title}
      description={description}
      ogImage={ogImage}
      type={type}
      locale="ro"
      siteName={ro.siteName}
      noindex={noindex}
    />
  </head>
  <body class:list={["min-h-screen antialiased", bodyClass]}>
    <a
      href="#main"
      class="sr-only z-50 focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:rounded focus:bg-surface-2 focus:px-3 focus:py-2"
    >
      Sari la conținut
    </a>
    <NavRo />
    <SiteNavScroll />
    <main id="main">
      <slot />
    </main>
    <FooterRo />
  </body>
</html>
