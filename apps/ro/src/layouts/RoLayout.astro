---
import BaseHead from "@shared/components/layout/BaseHead.astro";
import NavRo from "~/components/layout/NavRo.astro";
import SiteNavScroll from "@shared/components/layout/SiteNavScroll.astro";
import FooterRo from "~/components/layout/FooterRo.astro";
import { ro } from "~/i18n/ro";
import "~/styles/app.css";
import "~/styles/fonts.css";

export interface Props {
  title: string;
  description: string;
  ogImage?: string;
  type?: "website" | "article";
  bodyClass?: string;
  noindex?: boolean;
  /** Full-bleed pages that own the whole viewport drop the footer. */
  footer?: boolean;
  /**
   * Nav plus content add up to one viewport and nothing scrolls. The bar joins
   * the flow, so the content below it starts where the bar ends.
   */
  fitViewport?: boolean;
}

const {
  title,
  description,
  ogImage,
  type,
  bodyClass,
  noindex,
  footer = true,
  fitViewport = false,
} = Astro.props;
---

<!doctype html>
<html lang="ro">
  <head>
    <BaseHead
      title={title}
      description={description}
      ogImage={ogImage}
      type={type}
      locale="ro"
      siteName={ro.siteName}
      noindex={noindex}
    />
  </head>
  <body
    class:list={[
      "antialiased",
      fitViewport ? "viewport-shell" : "min-h-screen",
      bodyClass,
    ]}
  >
    <a
      href="#main"
      class="sr-only z-50 focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:rounded focus:bg-surface-2 focus:px-3 focus:py-2"
    >
      Sari la conținut
    </a>
    <NavRo inFlow={fitViewport} />
    <SiteNavScroll />
    <main id="main">
      <slot />
    </main>
    {footer && <FooterRo />}
  </body>
</html>
