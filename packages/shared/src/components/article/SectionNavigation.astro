---
import TablerIcon from "../icons/TablerIcon.astro";
import type { TablerIconName } from "../../lib/tablerIcon";

export interface SectionLink {
  id: string;
  label: string;
  icon: TablerIconName;
}

export interface Props {
  sections: SectionLink[];
  class?: string;
}

const { sections, class: className } = Astro.props;
---

<nav aria-label="Page sections" class:list={["section-nav", className]}>
  <ol class="section-nav__list">
    {
      sections.map((section: SectionLink) => (
        <li>
          <a href={`#${section.id}`} class="section-nav__link">
            <TablerIcon name={section.icon} class="section-nav__glyph" />
            <span class="pt-px">{section.label}</span>
          </a>
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .section-nav__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .section-nav__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.75rem;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: var(--tracking-microcaps);
    text-transform: uppercase;
    line-height: 1;
    text-decoration: none;
    color: var(--color-photo-ink);
    background: color-mix(in oklch, var(--color-photo-scrim) 48%, transparent);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    border: 1px solid
      color-mix(in oklch, var(--color-photo-ink) 18%, transparent);
    transition:
      background-color var(--duration-ui) var(--ease-cinema),
      border-color var(--duration-ui) var(--ease-cinema);
  }

  .section-nav__link:hover {
    background: color-mix(in oklch, var(--color-photo-scrim) 62%, transparent);
    border-color: color-mix(in oklch, var(--color-photo-ink) 32%, transparent);
  }

  .section-nav__glyph {
    width: 0.95rem;
    height: 0.95rem;
  }
</style>
