---
export interface Crumb {
  label: string;
  href?: string;
}

export interface Props {
  crumbs: Crumb[];
  /** on-photo = over hero photos; on-ink = scrim / canvas layouts */
  tone?: "on-photo" | "on-ink";
  class?: string;
}

const { crumbs, tone = "on-photo", class: className } = Astro.props;
---

<nav aria-label="Breadcrumb" class:list={["crumbs", `crumbs--${tone}`, className]}>
  <ol class="crumbs__list">
    {
      crumbs.map((crumb, i) => (
        <li class="crumbs__item">
          {i > 0 && <span class="crumbs__sep" aria-hidden="true">/</span>}
          {crumb.href ? (
            <a href={crumb.href} class="crumbs__link">
              {crumb.label}
            </a>
          ) : (
            <span class="crumbs__current" aria-current="page">
              {crumb.label}
            </span>
          )}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .crumbs__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .crumbs__item {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .crumbs__sep {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    opacity: 0.55;
  }

  .crumbs__link,
  .crumbs__current {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: var(--tracking-microcaps);
    text-transform: uppercase;
    line-height: 1.4;
    text-decoration: none;
  }

  .crumbs--on-photo .crumbs__link {
    color: color-mix(in oklch, var(--color-photo-ink) 82%, transparent);
    transition: color var(--duration-ui) var(--ease-cinema);
  }

  .crumbs--on-photo .crumbs__link:hover {
    color: var(--color-photo-ink);
  }

  .crumbs--on-photo .crumbs__current {
    color: var(--color-photo-ink);
  }

  .crumbs--on-photo .crumbs__sep {
    color: color-mix(in oklch, var(--color-photo-ink) 55%, transparent);
  }

  .crumbs--on-ink .crumbs__link {
    color: var(--color-ink-dim);
    transition: color var(--duration-ui) var(--ease-cinema);
  }

  .crumbs--on-ink .crumbs__link:hover {
    color: var(--color-accent-ink);
  }

  .crumbs--on-ink .crumbs__current {
    color: var(--color-accent-ink);
  }

  .crumbs--on-ink .crumbs__sep {
    color: var(--color-ink-faint);
  }
</style>
