---
import type { ImageMetadata } from "astro";
import CoverImage from "../media/CoverImage.astro";
import type { Accent } from "../../lib/accent";

export interface Props {
  image: ImageMetadata;
  alt: string;
  kicker?: string;
  /** When set, kicker renders as a link (e.g. country back nav). */
  kickerHref?: string;
  title: string;
  /** Optional leading glyph, e.g. country flag. */
  titleFlag?: string;
  /**
   * Uppercase luggage-tag display for brand / place / short section labels.
   * Leave false for story, spotlight, and itinerary titles (mixed case).
   */
  meta?: string;
  metaClass?: string;
  transitionName?: string;
  accent?: Accent;
}

const {
  image,
  alt,
  kicker,
  kickerHref,
  title,
  titleFlag,
  meta,
  metaClass,
  transitionName,
  accent,
} = Astro.props;

const hasKickerSlot = Astro.slots.has("kicker");
const kickerClass = "stamp-badge";
---

<header
  class:list={["relative isolate overflow-clip", accent && "accent-scope"]}
  data-accent={accent}
  data-nav-hero
>
  <div class="relative aspect-[16/9] max-h-dvh min-h-svh w-full overflow-clip">
    <div class="motion-parallax absolute inset-0 -top-[8%] -bottom-[8%]">
      <CoverImage
        src={image}
        alt={alt}
        widths={[640, 960, 1280, 1920, 2560]}
        sizes="100vw"
        priority
        placeholder="blur"
        format="avif"
        quality={82}
        wrapperClass="h-full w-full"
        transitionName={transitionName}
        class="h-full w-full object-cover"
      />
    </div>
    <div class="hero-overlay" aria-hidden="true"></div>
    <div
      class="pad-canvas hero-bottom absolute inset-x-0 bottom-0 z-10 mx-auto flex max-w-canvas flex-col items-start gap-4 md:gap-5"
    >
      {
        hasKickerSlot ? (
          <div class="m-0 h-5 animate-cinema-fade">
            <slot name="kicker" />
          </div>
        ) : (
          kicker && (
            <p class="m-0 animate-cinema-fade">
              {kickerHref ? (
                <a href={kickerHref} class={kickerClass}>
                  {kicker}
                </a>
              ) : (
                <span class={kickerClass}>{kicker}</span>
              )}
            </p>
          )
        )
      }
      <h1
        class:list={[
          "display page-title hero-on-photo animate-cinema-rise drop-shadow-[0_2px_24px_oklch(0.1_0.02_55/0.55)]",
          titleFlag && "flex flex-wrap items-baseline gap-x-3",
        ]}
      >
        {titleFlag && <span aria-hidden="true">{titleFlag}</span>}
        <span>{title}</span>
      </h1>
      {
        meta && (
          <p
            class:list={[
              "hero-on-photo-dim hero-summary motion-stagger animate-cinema-fade",
              metaClass,
            ]}
          >
            {meta}
          </p>
        )
      }
    </div>
  </div>
</header>
