---
/**
 * Inline twin of `/logo-pe-creasta.svg`, which stays for favicon / OG where a
 * concrete color is required. Here the crest and summit marker take
 * `currentColor` so they follow the theme ink.
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg
  class:list={["block h-auto w-full", className]}
  viewBox="0 0 32 32"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <path
    d="M2 23 10 11 16 16 22 8 30 23Z"
    fill="oklch(0.67 0.165 35)"
    opacity="0.92"></path>
  <path
    d="M10 11 16 16 22 8"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"></path>
  <circle cx="22" cy="8" r="2" fill="currentColor"></circle>
</svg>
