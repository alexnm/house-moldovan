---
interface Props {
  /** Larger type for footer / masthead */
  size?: "nav" | "footer";
  /** When false, render a non-link (footer masthead) */
  link?: boolean;
  /** Logo destination (default `/`) */
  href?: string;
  /** Single-line wordmark label (overrides House/Moldovan split) */
  label?: string;
  class?: string;
}

const {
  size = "nav",
  link = true,
  href = "/",
  label,
  class: className,
} = Astro.props;

/** Inline mark (e.g. RO crest) passed as `<Mark slot="mark" />` */
const mark = Astro.slots.has("mark");

const classes = [
  "site-logo",
  size === "nav" && "nav-link",
  size === "footer" && "site-logo--footer",
  mark && "flex items-center gap-2.5",
  className,
];

/** Two spans when the name splits into soft and strong halves, else one. */
const wordmark = label
  ? [{ text: label, class: undefined }]
  : [
      { text: "House", class: "site-logo__soft" },
      { text: "Moldovan", class: "site-logo__strong" },
    ];

/** A linked mark sits beside the wordmark, not inside it. */
const grouped = link && mark;
---

{
  grouped && (
    /* The mark rides in front of the link rather than inside it, so the
       underline sweep tracks the wordmark and the crest stays out of the hit
       area. */
    <span class:list={["site-logo-group flex items-center gap-2.5", className]}>
      <span class="block w-7 shrink-0">
        <slot name="mark" />
      </span>
      <a
        href={href}
        class:list={[
          "link-accent site-logo",
          size === "nav" && "nav-link",
          size === "footer" && "site-logo--footer",
        ]}
      >
        {wordmark.map((part) => (
          <span class={part.class}>{part.text}</span>
        ))}
      </a>
    </span>
  )
}

{
  link && !grouped && (
    <a href={href} class:list={["link-accent", ...classes]}>
      {wordmark.map((part) => (
        <span class={part.class}>{part.text}</span>
      ))}
    </a>
  )
}

{
  !link && (
    <p class:list={classes}>
      {mark && (
        <span class="block w-7 shrink-0">
          <slot name="mark" />
        </span>
      )}
      {wordmark.map((part) => (
        <span class={part.class}>{part.text}</span>
      ))}
    </p>
  )
}
