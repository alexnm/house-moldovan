{
  "name": "house-moldovan",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm dev:en",
    "dev:en": "pnpm --filter @house-moldovan/en dev",
    "dev:ro": "pnpm --filter @house-moldovan/ro dev",
    "build": "pnpm build:all",
    "build:en": "pnpm --filter @house-moldovan/en build",
    "build:ro": "pnpm --filter @house-moldovan/ro build",
    "build:all": "pnpm build:en && pnpm build:ro",
    "deploy:en": "pnpm --filter @house-moldovan/en run deploy",
    "deploy:ro": "pnpm --filter @house-moldovan/ro run deploy",
    "check": "pnpm check:all",
    "check:en": "pnpm --filter @house-moldovan/en check",
    "check:ro": "pnpm --filter @house-moldovan/ro check",
    "check:all": "pnpm check:en && pnpm check:ro && eslint . && prettier --check .",
    "fix": "eslint . --fix && prettier --write .",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "25.6.0",
    "eslint": "10.2.1",
    "eslint-plugin-astro": "1.7.0",
    "prettier": "3.8.3",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "0.7.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.0"
  }
}
