---
import BaseHead from "~/components/layout/BaseHead.astro";
import Nav from "~/components/layout/Nav.astro";
import SiteNavScroll from "~/components/layout/SiteNavScroll.astro";
import Footer from "~/components/layout/Footer.astro";
import "~/styles/fonts-en.css";

export interface Props {
  title: string;
  description: string;
  ogImage?: string;
  type?: "website" | "article";
  bodyClass?: string;
  noindex?: boolean;
}

const { title, description, ogImage, type, bodyClass, noindex } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={title}
      description={description}
      ogImage={ogImage}
      type={type}
      locale="en"
      noindex={noindex}
    />
  </head>
  <body class:list={["min-h-screen antialiased", bodyClass]}>
    <a
      href="#main"
      class="sr-only z-50 focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:rounded focus:bg-surface-2 focus:px-3 focus:py-2"
    >
      Skip to content
    </a>
    <Nav />
    <SiteNavScroll />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
