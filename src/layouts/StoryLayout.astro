---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import Hero from "~/components/article/Hero.astro";
import Prose from "~/components/article/Prose.astro";
import MetaBar from "~/components/article/MetaBar.astro";
import { en } from "~/i18n/en";
import { getPlace } from "~/lib/content";
import { articleOgPath } from "~/lib/articles";
import {
  countryLinks,
  regionAccentForPlaces,
  uniqueRegionLinks,
} from "~/lib/articlePlaces";
import { getAllRegions, regionMapById } from "~/lib/regions";
import { getReadNextArticles } from "~/lib/readNext";
import ReadNext from "~/components/article/ReadNext.astro";
import type { MarkdownHeading } from "@astrojs/markdown-remark";
import { buildBodyToc } from "~/lib/bodyToc";
import ArticleToc from "~/components/article/ArticleToc.astro";

export interface Props {
  entry: CollectionEntry<"stories">;
  contentHeadings: MarkdownHeading[];
}

const { entry, contentHeadings } = Astro.props;
const { data } = entry;

const toc = buildBodyToc(contentHeadings);
const hasToc = toc.length > 0;

const places = await Promise.all(data.country.map((ref) => getPlace(ref)));
const resolved = places.filter((p): p is NonNullable<typeof p> => Boolean(p));
if (resolved.length === 0)
  throw new Error(`No countries found for story ${entry.id}`);

const regionsById = regionMapById(await getAllRegions());
const accent = regionAccentForPlaces(resolved, regionsById);
const countryLabel =
  resolved.length > 1 ? en.article.countries : en.article.country;
const items = [
  { label: countryLabel, value: countryLinks(resolved) },
  { label: en.region.kicker, value: uniqueRegionLinks(resolved, regionsById) },
  {
    label: en.article.type,
    value: en.article.storyType[data.type],
  },
  { label: en.article.months, value: data.months },
];

const readNext = await getReadNextArticles({ ...entry, kind: "story" });
const ogImage = articleOgPath({ ...entry, kind: "story" });
---

<BaseLayout
  title={`${data.title} · ${en.siteName}`}
  description={data.summary}
  type="article"
  ogImage={ogImage}
  noindex={data.draft}
>
  <article class="accent-scope" data-accent={accent}>
    <Hero
      image={data.hero}
      alt={data.title}
      kicker={en.article.story}
      title={data.title}
      meta={data.summary}
      accent={accent}
      transitionName={`hero-${entry.id}`}
    />

    <MetaBar items={items} />

    {
      hasToc ? (
        <div class="section section-y section-gap grid md:grid-cols-[14rem_1fr]">
          <ArticleToc sections={toc} />
          <div class="min-w-0">
            <Prose class="motion-reveal mx-0!">
              <slot />
            </Prose>
          </div>
        </div>
      ) : (
        <Prose class="motion-reveal section mt-12 @md:mt-16">
          <slot />
        </Prose>
      )
    }

    {
      readNext.length > 0 && (
        <div class="motion-reveal section-divider">
          <ReadNext articles={readNext} />
        </div>
      )
    }

    <nav class="section mt-4 mb-24">
      <a href="/journal" class="link-more link-accent link-accent--dim">
        ← {en.article.backToJournal}
      </a>
    </nav>
  </article>
</BaseLayout>
