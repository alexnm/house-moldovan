---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import Hero from "~/components/article/Hero.astro";
import Prose from "~/components/article/Prose.astro";
import MetaBar from "~/components/article/MetaBar.astro";
import ItineraryIntroCards from "~/components/article/ItineraryIntroCards.astro";
import ItineraryDaysCompact from "~/components/article/ItineraryDaysCompact.astro";
import { en } from "~/i18n/en";
import { getPlace } from "~/lib/content";
import {
  countryLinks,
  regionAccentForPlaces,
  uniqueRegionLinks,
} from "~/lib/articlePlaces";
import { getAllRegions, regionMapById } from "~/lib/regions";
import { heroRouteFromItineraryDays } from "~/lib/itinerary";
import { getReadNextArticles } from "~/lib/readNext";
import ReadNext from "~/components/article/ReadNext.astro";
import type { MarkdownHeading } from "@astrojs/markdown-remark";
import { buildBodyToc } from "~/lib/bodyToc";
import ArticleToc from "~/components/article/ArticleToc.astro";

export interface Props {
  entry: CollectionEntry<"itineraries">;
  contentHeadings: MarkdownHeading[];
}

const { entry, contentHeadings } = Astro.props;
const { data } = entry;

const toc = buildBodyToc(contentHeadings);
const hasToc = toc.length > 0;

const headerPlaces = await Promise.all(
  data.country.map((ref) => getPlace(ref)),
);
const resolved = headerPlaces.filter((p): p is NonNullable<typeof p> =>
  Boolean(p),
);
if (resolved.length === 0)
  throw new Error(`No countries in country[] for itinerary ${entry.id}`);

const regionsById = regionMapById(await getAllRegions());
const accent = regionAccentForPlaces(resolved, regionsById);
const countryLabel =
  resolved.length > 1 ? en.article.countries : en.article.country;
const dayCount = data.days.length;
const placeNames = heroRouteFromItineraryDays(data.days);
const pageDescription = data.summary;

const dayRows = await Promise.all(
  data.days.map(async (d, i) => {
    const locations = await Promise.all(
      d.locations.map(async (l) => {
        const place = await getPlace(l.country);
        if (!place) {
          throw new Error(
            `Itinerary ${entry.id} day ${i + 1}: country not found for location "${l.label}"`,
          );
        }
        return { label: l.label, country: place };
      }),
    );
    return {
      dayIndex: i + 1,
      description: d.description,
      locations,
    };
  }),
);

const items = [
  { label: countryLabel, value: countryLinks(resolved) },
  { label: en.region.kicker, value: uniqueRegionLinks(resolved, regionsById) },
  { label: "Duration", value: en.article.days(dayCount) },
  { label: en.article.months, value: data.months },
];

const readNext = await getReadNextArticles({ ...entry, kind: "itinerary" });
---

<BaseLayout
  title={`${data.title} · ${en.siteName}`}
  description={pageDescription}
  type="article"
  ogImage={`/og/itineraries/${entry.id}.png`}
  noindex={data.draft}
>
  <article class="accent-scope" data-accent={accent}>
    <Hero
      image={data.hero}
      alt={data.title}
      kicker={en.article.itinerary}
      title={data.title}
      meta={data.summary}
      transitionName={`hero-${entry.id}`}
    />

    <MetaBar items={items} />

    <div
      class:list={[
        "section section-y section-gap grid",
        hasToc && "md:grid-cols-[14rem_1fr]",
      ]}
    >
      {hasToc && <ArticleToc sections={toc} />}

      <div class="flex min-w-0 flex-col gap-[var(--space-section)]">
        <ItineraryIntroCards
          highlights={data.highlights}
          travelTips={data.travelTips}
        />
        <ItineraryDaysCompact days={dayRows} />
        <Prose class="mx-0!">
          <slot />
        </Prose>
      </div>
    </div>

    {
      readNext.length > 0 && (
        <div class="motion-reveal section-divider">
          <ReadNext articles={readNext} />
        </div>
      )
    }

    <nav class="section mt-4 mb-24">
      <a href="/journal" class="link-more link-accent link-accent--dim">
        ← {en.article.backToJournal}
      </a>
    </nav>
  </article>
</BaseLayout>
