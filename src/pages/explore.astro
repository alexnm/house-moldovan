---
import Hero from "~/components/article/Hero.astro";
import ExploreFeed from "~/components/explore/ExploreFeed.astro";
import BaseLayout from "~/layouts/BaseLayout.astro";
import { en } from "~/i18n/en";
import { getAllRegions } from "~/lib/regions";
import { getAllPlaces, getEnFeed } from "~/lib/content";
import heroImage from "~/assets/peru/machu-picchu.jpg";

const [places, feed, regions] = await Promise.all([
  getAllPlaces(),
  getEnFeed(),
  getAllRegions(),
]);
---

<BaseLayout
  title={`${en.explore.title} · ${en.siteName}`}
  description={en.explore.intro}
  ogImage="/og/explore.png"
>
  <Hero
    image={heroImage}
    alt="Dolomite peaks above Val Badia, Italy"
    title={en.explore.intro}
    meta={en.explore.sub}
    transitionName="hero-explore"
  >
    <ul
      slot="kicker"
      class="flex flex-wrap items-center gap-2"
      aria-label={en.explore.regionsNav}
    >
      {
        regions.map((region) => (
          <li>
            <a
              href={`#region-${region.id}`}
              class="stamp-badge stamp-badge--accent accent-scope duration-ui transition-opacity ease-cinema hover:opacity-90"
              data-accent={region.data.accent}
            >
              {region.data.name}
            </a>
          </li>
        ))
      }
    </ul>
  </Hero>

  <ExploreFeed regions={regions} places={places} feed={feed} />
</BaseLayout>
