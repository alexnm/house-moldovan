---
import Hero from "~/components/article/Hero.astro";
import BaseLayout from "~/layouts/BaseLayout.astro";
import JournalFeed from "~/components/journal/JournalFeed.astro";
import { en } from "~/i18n/en";
import { getEnFeed, getPlace } from "~/lib/content";
import { articleHref, articleRssDescription } from "~/lib/articles";
import { getAllRegions, regionIdFromPlace, regionMapById } from "~/lib/regions";
import type { Accent } from "~/lib/accent";
import type { CollectionEntry } from "astro:content";

const feed = await getEnFeed();
const regionsById = regionMapById(await getAllRegions());
const featured = feed.find((a) => a.data.featured) ?? feed[0];
const rest = featured ? feed.filter((a) => a !== featured) : feed;

let featuredAccent: Accent | undefined;
let featuredHref = "";
let featuredSummary = "";
if (featured) {
  const resolved = (
    await Promise.all(featured.data.country.map((ref) => getPlace(ref)))
  ).filter((p): p is CollectionEntry<"places"> => Boolean(p));
  if (resolved.length) {
    const first = resolved[0]!;
    featuredAccent =
      first.data.accent ??
      regionsById.get(regionIdFromPlace(first))?.data.accent;
  }
  featuredHref = articleHref(featured);
  featuredSummary = articleRssDescription(featured);
}
---

<BaseLayout
  title={`${en.journal.metaTitle} · ${en.siteName}`}
  description={en.journal.metaDescription}
>
  {
    featured && (
      <a href={featuredHref} class="block">
        <Hero
          image={featured.data.hero}
          alt={featured.data.title}
          kicker={en.journal.featuredKicker}
          title={featured.data.title}
          meta={featuredSummary}
          accent={featuredAccent}
          transitionName={`hero-${featured.id}`}
        />
      </a>
    )
  }

  <JournalFeed feed={rest} />
</BaseLayout>
