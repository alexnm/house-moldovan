---
import CoverImage from "~/components/media/CoverImage.astro";
import RoLayout from "~/layouts/RoLayout.astro";
import ArticleCard from "~/components/home/ArticleCard.astro";
import RangeCard from "~/components/home/RangeCard.astro";
import { ro } from "~/i18n/ro";
import {
  getHikes,
  getAllRanges,
  getRange,
  rangeNameByTrailId,
} from "~/lib/content";
import { trailCoverFromFrontmatterPath } from "~/lib/trailCoverImport";
import { accentForRange } from "~/lib/ranges";

const [hikes, ranges] = await Promise.all([getHikes(), getAllRanges()]);
const rangeNames = rangeNameByTrailId(ranges);
const featured = hikes.find((h) => h.data.featured) ?? hikes[0];
const recent = hikes.filter((h) => h !== featured).slice(0, 6);

const countByRange = new Map<string, number>();
for (const h of hikes) {
  countByRange.set(
    h.data.range.id,
    (countByRange.get(h.data.range.id) ?? 0) + 1,
  );
}

const rangeTiles = ranges
  .filter((r) => countByRange.has(r.id))
  .sort(
    (a, b) => (countByRange.get(b.id) ?? 0) - (countByRange.get(a.id) ?? 0),
  );

let featuredAccent: string | undefined;
let featuredRangeName = "";
if (featured) {
  const range = await getRange(featured.data.range);
  if (range) {
    featuredAccent = accentForRange(range.id, range.data.accent);
    featuredRangeName = range.data.name;
  }
}
---

<RoLayout title={ro.siteName} description={ro.description}>
  {
    featured && (
      <section
        class="relative isolate overflow-clip"
        style={featuredAccent ? `--accent: ${featuredAccent}` : undefined}
      >
        <a href={`/ro/${featured.id}`} class="block">
          <div
            class="relative aspect-[16/9] max-h-dvh min-h-svh w-full overflow-clip"
            data-nav-hero
          >
            <div class="motion-parallax absolute inset-0 -top-[8%] -bottom-[8%]">
              <CoverImage
                src={featured.data.hero}
                alt={featured.data.title}
                widths={[1080, 1440, 1920, 2560]}
                sizes="100vw"
                priority
                placeholder="blur"
                format="avif"
                quality={84}
                wrapperClass="h-full w-full"
                transitionName={`hike-${featured.id}`}
                class="h-full w-full object-cover"
              />
            </div>
            <div class="hero-overlay" aria-hidden="true"></div>
            <div class="pad-canvas hero-bottom absolute inset-x-0 bottom-0 z-10 mx-auto max-w-canvas">
              <h1
                class="display max-w-[18ch] animate-cinema-rise text-[clamp(2.4rem,5vw+1rem,6rem)] leading-[0.96] text-balance hero-on-photo drop-shadow-[0_1px_2px_oklch(0_0_0/0.45)]"
                style="font-family: var(--font-display-ro)"
              >
                {featured.data.title}
              </h1>
              <p class="hero-on-photo-dim hero-summary animate-cinema-fade motion-stagger mt-6 md:mt-8">
                {ro.home.featuredKicker} · {featuredRangeName}
              </p>
            </div>
          </div>
        </a>
      </section>
    )
  }

  <section class="mx-auto my-24 max-w-canvas pad-canvas">
    <header class="mb-10 flex items-baseline justify-between">
      <h2
        class="display text-3xl md:text-4xl"
        style="font-family: var(--font-display-ro)"
      >
        {ro.home.rangesHeading}
      </h2>
    </header>
    <ul class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
      {
        rangeTiles.map((r) => {
          const accent = accentForRange(r.id, r.data.accent);
          const cover = trailCoverFromFrontmatterPath(r.data.cover);
          return (
            <RangeCard
              href={`/ro/munti/${r.id}`}
              title={r.data.name}
              summary={r.data.summary}
              countLabel={ro.range.countOf(countByRange.get(r.id) ?? 0)}
              accent={accent}
              image={cover}
              imageAlt={`Peisaj din ${r.data.name}`}
              as="h3"
            />
          );
        })
      }
    </ul>
  </section>

  <section class="mx-auto my-24 max-w-canvas pad-canvas">
    <header class="mb-10 flex items-baseline justify-between">
      <h2
        class="display text-3xl md:text-4xl"
        style="font-family: var(--font-display-ro)"
      >
        {ro.home.recentHeading}
      </h2>
      <a href="/ro/trasee" class="link-more link-accent link-accent--dim">
        {ro.home.seeAll} →
      </a>
    </header>
    <ul class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
      {
        recent.map((h) => (
          <li>
            <ArticleCard
              href={`/ro/${h.id}`}
              title={h.data.title}
              kicker={`${ro.shape[h.data.shape]} · ${ro.units.distance(h.data.distance)}`}
              meta={ro.units.duration(h.data.duration)}
              image={h.data.hero}
              imageAlt={h.data.title}
              size="md"
              accent={accentForRange(h.data.range.id)}
              regionLabel={rangeNames.get(h.data.range.id) ?? h.data.range.id}
              transitionName={`hike-${h.id}`}
            />
          </li>
        ))
      }
    </ul>
  </section>
</RoLayout>
