---
import AtlasHero from "~/components/ro/AtlasHero.astro";
import HikeRhythmGrid from "~/components/ro/HikeRhythmGrid.astro";
import RoLayout from "~/layouts/RoLayout.astro";
import { ro } from "~/i18n/ro";
import { loadRoAtlasHomeData } from "~/lib/roHome";

const { hikes, rangeNames, rangeTiles } = await loadRoAtlasHomeData();
---

<RoLayout title={ro.siteName} description={ro.description}>
  <AtlasHero rangeTiles={rangeTiles} />

  <section id="trasee" class="pad-canvas mx-auto max-w-canvas py-16 md:py-24">
    <header class="mb-10">
      <h2 class="display section-heading">{ro.feed.title}</h2>
    </header>
    <HikeRhythmGrid hikes={hikes} rangeNames={rangeNames} />
  </section>
</RoLayout>
