---
import RoLayout from "~/layouts/RoLayout.astro";
import { ro } from "~/i18n/ro";
---

<RoLayout
  title={`${ro.about.title} · ${ro.siteName}`}
  description={ro.description}
>
  <section class="mx-auto max-w-canvas pad-canvas pt-32 pb-24">
    <p class="micro text-ink-faint">{ro.about.title}</p>
    <h1
      class="display mt-3 text-[clamp(2rem,3vw+1rem,4.2rem)] leading-[1.02] text-balance"
      style="font-family: var(--font-display-ro)"
    >
      Munți, marcaje, lumină.
    </h1>
    <div class="prose-body mt-12">
      <p>
        <em>Pe creastă</em> e un jurnal personal cu trasee din Carpați. Fiecare tură
        are marcaj, profil de elevație, hartă cu track-ul GPX și note pentru zilele
        când contează detaliile, nu textul de turism.
      </p>
      <p>
        Un site mai larg, cu stories, spotlights și itinerarii din lume, în engleză:
        <a href="/">House Moldovan</a>.
      </p>
    </div>
  </section>
</RoLayout>
