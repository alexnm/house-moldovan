---
import RoLayout from "~/layouts/RoLayout.astro";
import HikeRhythmGrid from "~/components/ro/HikeRhythmGrid.astro";
import { ro } from "~/i18n/ro";
import { getAllRanges, getHikes, rangeNameById } from "~/lib/content";

const hikes = await getHikes();
const ranges = await getAllRanges();
const rangeNames = rangeNameById(ranges);
---

<RoLayout
  title={`${ro.feed.title} · ${ro.siteName}`}
  description={ro.feed.intro}
>
  <section class="pad-canvas mx-auto max-w-canvas pt-32">
    <p class="micro text-ink-faint">{ro.feed.title}</p>
    <h1 class="display page-title mt-3 text-balance">
      {ro.feed.intro}
    </h1>
  </section>

  <section class="pad-canvas mx-auto my-16 max-w-canvas">
    <HikeRhythmGrid hikes={hikes} rangeNames={rangeNames} />
  </section>
</RoLayout>
