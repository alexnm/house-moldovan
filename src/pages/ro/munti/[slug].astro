---
import type { GetStaticPaths } from "astro";
import RoLayout from "~/layouts/RoLayout.astro";
import Hero from "~/components/article/Hero.astro";
import HikeRhythmGrid from "~/components/ro/HikeRhythmGrid.astro";
import { ro } from "~/i18n/ro";
import { getAllRanges, getHikes } from "~/lib/content";
import { trailCoverFromFrontmatterPath } from "~/lib/trailCoverImport";

export const getStaticPaths = (async () => {
  const [ranges, hikes] = await Promise.all([getAllRanges(), getHikes()]);
  return ranges.map((range) => {
    const items = hikes.filter((h) => h.data.range.id === range.id);
    return {
      params: { slug: range.id },
      props: { range, hikes: items },
    };
  });
}) satisfies GetStaticPaths;

interface Props {
  range: Awaited<ReturnType<typeof getAllRanges>>[number];
  hikes: Awaited<ReturnType<typeof getHikes>>;
}

const { range, hikes } = Astro.props as Props;
const cover = trailCoverFromFrontmatterPath(range.data.cover);
const countLabel = ro.range.countOf(hikes.length);
const heroMeta = [range.data.summary, countLabel].filter(Boolean).join(" · ");
---

<RoLayout
  title={`${range.data.name} · ${ro.siteName}`}
  description={range.data.summary ?? ro.range.intro(range.data.name)}
>
  {
    cover ? (
      <Hero
        image={cover}
        alt={`Peisaj din ${range.data.name}`}
        kicker={ro.nav.munti}
        kickerHref="/ro/munti"
        title={range.data.name}
        meta={heroMeta}
        transitionName={`range-${range.id}`}
      />
    ) : (
      <section class="pad-canvas mx-auto max-w-canvas pt-32 pb-14 md:pt-40 md:pb-20">
        <p class="micro text-ink-faint">{ro.nav.munti}</p>
        <h1 class="display page-title mt-3 text-balance">{range.data.name}</h1>
        {heroMeta && (
          <p class="mt-4 max-w-[60ch] text-lg leading-snug text-pretty text-ink-dim">
            {heroMeta}
          </p>
        )}
      </section>
    )
  }

  <section class="pad-canvas mx-auto my-16 max-w-canvas">
    <HikeRhythmGrid hikes={hikes} rangeLabel={range.data.name} />
  </section>
</RoLayout>
