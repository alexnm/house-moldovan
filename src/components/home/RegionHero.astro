---
import type { ImageMetadata } from "astro";
import CoverImage from "~/components/media/CoverImage.astro";
import type { Accent } from "~/lib/accent";
import { en } from "~/i18n/en";

export interface Props {
  name: string;
  tagline: string;
  order: number;
  accent: Accent;
  images: ImageMetadata[];
}

const { name, tagline, order, accent, images } = Astro.props;
const photos = images.slice(0, 4);

/** Contact-sheet slots: nudged right for clear space around the title. */
const slots = [
  { x: 22, y: 16, w: 34, rotate: -6 },
  { x: 56, y: 8, w: 40, rotate: 4 },
  { x: 32, y: 46, w: 36, rotate: 7 },
  { x: 64, y: 50, w: 38, rotate: -5 },
] as const;
---

<section
  class="accent-scope relative isolate overflow-clip"
  data-accent={accent}
  data-nav-hero
  data-nav-hero-accent
>
  <div class="region-hero accent-drenched">
    {
      photos.length > 0 && (
        <div class="region-hero__sheet" aria-hidden="true">
          {photos.map((img, i) => {
            const slot = slots[i];
            if (!slot) return null;
            return (
              <div
                class="region-hero__frame"
                style={`--x:${slot.x}%;--y:${slot.y}%;--w:${slot.w}%;--r:${slot.rotate}deg`}
              >
                <CoverImage
                  src={img}
                  alt=""
                  widths={[400, 640, 960, 1200]}
                  sizes="(min-width: 1024px) min(36vw, 600px), 70vw"
                  format="avif"
                  quality={80}
                  priority={i === 0}
                  placeholder={i === 0 ? "blur" : "shell"}
                  wrapperClass="h-full w-full"
                  class="h-full w-full object-cover"
                />
              </div>
            );
          })}
        </div>
      )
    }

    <div class="region-hero__scrim" aria-hidden="true"></div>

    <div class="region-hero__copy section">
      <p class="stamp animate-cinema-fade opacity-70">
        {en.region.chapter(order)}
      </p>
      <h1 class="region-hero__name region-name display animate-cinema-rise">
        {name}
      </h1>
      <p class="region-hero__tag motion-stagger animate-cinema-fade">
        {tagline}
      </p>
    </div>
  </div>
</section>

<style>
  .region-hero {
    position: relative;
    isolation: isolate;
    min-height: 50vh;
    max-height: 50vh;
    overflow: clip;
    display: flex;
    align-items: flex-end;

    @media (width >= 640px) {
      min-height: min(100svh, 52rem);
      max-height: none;
    }
  }

  .region-hero__sheet {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    /* Same shell as `.section` so the cluster stays within the content column */
    width: 100%;
    max-width: var(--container-wide);
    margin-inline: auto;

    @media (width >= 1536px) {
      max-width: var(--width-canvas);
    }
  }

  .region-hero__frame {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: var(--w);
    max-width: 600px;
    aspect-ratio: 1 / 1;
    border-radius: 2px;
    transform: rotate(var(--r));
    box-shadow:
      0 4px 14px oklch(0 0 0 / 0.14),
      0 22px 48px -14px oklch(0 0 0 / 0.38);

    @media (width >= 768px) {
      aspect-ratio: 5 / 4;
    }
  }

  /* Shorter mobile hero: pull the top pair down toward the lower two */
  @media (width < 640px) {
    .region-hero__frame:nth-child(1) {
      top: 30%;
    }

    .region-hero__frame:nth-child(2) {
      top: 24%;
    }
  }

  .region-hero__frame :global(> *) {
    overflow: clip;
    border-radius: inherit;
    height: 100%;
    width: 100%;
  }

  .region-hero__frame :global(img) {
    height: 100%;
    width: 100%;
    object-fit: cover;
  }

  .region-hero__scrim {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    z-index: 2;
    height: min(55%, 22rem);
    pointer-events: none;
    background: linear-gradient(
      to top,
      color-mix(in oklch, var(--accent-base) 92%, black) 0%,
      color-mix(in oklch, var(--accent-base) 55%, transparent) 55%,
      transparent 100%
    );
  }

  /* `.section` supplies the same inline padding + max-width as page content */
  .region-hero__copy {
    position: relative;
    z-index: 3;
    width: 100%;
    padding-block: 5.5rem 2rem;

    @media (width >= 640px) {
      padding-block: 5.5rem 3.5rem;
    }
  }

  .region-hero__name {
    margin-top: 0.5rem;
    font-size: clamp(4.25rem, 14vw, 9.5rem);
    line-height: 0.82;
    letter-spacing: -0.045em;
    text-transform: uppercase;
    max-width: 14ch;
    text-wrap: balance;
  }

  .region-hero__tag {
    margin-top: 1.25rem;
    max-width: 36ch;
    font-family: var(--font-sans);
    font-size: clamp(1.05rem, 0.9rem + 0.45vw, 1.3rem);
    font-weight: 500;
    line-height: 1.35;
    opacity: 0.9;
  }
</style>
