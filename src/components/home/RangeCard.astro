---
import type { ImageMetadata } from "astro";
import CoverImage from "~/components/media/CoverImage.astro";

export interface Props {
  href: string;
  title: string;
  summary?: string;
  /** Pre-rendered label (e.g. `ro.range.countOf(n)`). */
  countLabel: string;
  image?: ImageMetadata;
  imageAlt?: string;
  as?: "h2" | "h3";
  /** Zero-padded index for watermark (01, 02, …). */
  index?: number;
}

const {
  href,
  title,
  summary,
  countLabel,
  image,
  imageAlt,
  as = "h2",
  index,
} = Astro.props;

const alt = imageAlt ?? `Peisaj din ${title}`;
const titleClass = "display region-name range-card__title text-balance";
---

<li class="motion-reveal-media">
  <a
    href={href}
    class="range-card accent-scope accent-drenched group relative grid aspect-square overflow-clip rounded-sm p-5 md:p-6"
  >
    {
      image && (
        <>
          <div class="range-card__photo" aria-hidden="true">
            <CoverImage
              src={image}
              alt={alt}
              widths={[320, 480, 640]}
              sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw"
              format="avif"
              quality={70}
              placeholder="shell"
              wrapperClass="motion-hover-media h-full w-full"
              class="h-full w-full object-cover"
            />
          </div>
        </>
      )
    }
    {
      index != null && (
        <span
          class="range-card__watermark display pointer-events-none absolute -top-3 -right-1 z-10 leading-none select-none"
          aria-hidden="true"
        >
          {String(index).padStart(2, "0")}
        </span>
      )
    }
    <p class="stamp relative z-10 self-start opacity-70">{countLabel}</p>
    <div class="relative z-10 self-start">
      {
        as === "h3" ? (
          <h3 class={titleClass}>{title}</h3>
        ) : (
          <h2 class={titleClass}>{title}</h2>
        )
      }
      {
        summary && (
          <p class="mt-4 max-w-[36ch] font-sans text-base leading-snug text-pretty opacity-90">
            {summary}
          </p>
        )
      }
    </div>
  </a>
</li>

<style>
  .range-card {
    --accent-base: var(--color-range-sky);
    --motion-photo-scale: 1.07;
  }

  .range-card {
    grid-template-rows: 10% 1fr;
  }

  .range-card__title {
    font-size: clamp(2.4rem, 3.5vw, 3.25rem);
    line-height: 0.9;
    letter-spacing: -0.035em;
  }

  .range-card__watermark {
    font-size: clamp(6rem, 14vw, 9rem);
    opacity: 0.14;
  }

  .range-card__photo {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    z-index: 0;
    height: 70%;
    overflow: clip;
    -webkit-mask-image: linear-gradient(
      to top,
      black 0%,
      black 60%,
      transparent 100%
    );
    mask-image: linear-gradient(to top, black 0%, black 60%, transparent 100%);
  }

  .range-card__photo :global(.cover-image-shell),
  .range-card__photo :global(.cover-image-shell > *) {
    height: 100%;
    width: 100%;
  }

  .range-card__photo :global(img) {
    height: 100%;
    width: 100%;
    object-fit: cover;
  }
</style>
