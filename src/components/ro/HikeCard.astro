---
import type { ImageMetadata } from "astro";
import CoverImage from "~/components/media/CoverImage.astro";
import WaymarkBadge from "~/components/hike/WaymarkBadge.astro";
import { ro } from "~/i18n/ro";
import { renderSparklineSvg, type ElevationPoint } from "~/lib/gpx";
import type { WaymarkCode } from "~/lib/waymarks";

export interface Props {
  href: string;
  title: string;
  rangeName: string;
  distance: number;
  elevationGain: number;
  duration: readonly [number, number];
  difficulty: keyof typeof ro.difficulty;
  waymark: readonly WaymarkCode[];
  image: ImageMetadata;
  imageAlt?: string;
  profile?: ElevationPoint[];
  transitionName?: string;
  hikeId?: string;
  filterRange?: string;
  filterDifficulty?: string;
  filterSeason?: string;
  filterShape?: string;
}

const {
  href,
  title,
  rangeName,
  distance,
  elevationGain,
  duration,
  difficulty,
  waymark,
  image,
  imageAlt,
  profile,
  transitionName,
  hikeId,
  filterRange,
  filterDifficulty,
  filterSeason,
  filterShape,
} = Astro.props;

const sparkline =
  profile && profile.length >= 2 ? renderSparklineSvg(profile) : "";
const alt = imageAlt ?? title;
---

<li
  data-hike-id={hikeId}
  data-range={filterRange}
  data-difficulty={filterDifficulty ?? difficulty}
  data-season={filterSeason}
  data-shape={filterShape}
>
  <a
    href={href}
    class="hike-card group block"
    data-difficulty={difficulty}
    transition:name={transitionName}
  >
    <div class="relative aspect-[16/10] overflow-hidden bg-surface-3">
      <CoverImage
        src={image}
        alt={alt}
        widths={[480, 720, 960]}
        sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw"
        format="avif"
        quality={82}
        wrapperClass="motion-hover-media h-full w-full"
        class="h-full w-full object-cover"
      />
      <div
        class="absolute inset-x-0 bottom-0 flex items-end justify-between gap-3 bg-gradient-to-t from-[oklch(0.15_0.02_55/0.75)] to-transparent px-4 pt-8 pb-3"
      >
        {
          sparkline && (
            <div class="hike-card__sparkline opacity-90" set:html={sparkline} />
          )
        }
        <WaymarkBadge marks={waymark} size={16} />
      </div>
    </div>

    <div class="flex flex-col gap-3 p-5">
      <div>
        <p class="micro text-ink-faint">
          {rangeName} ·{" "}
          <span class="trail-accent">{ro.difficulty[difficulty]}</span>
        </p>
        <h3 class="display mt-1 text-xl leading-tight text-balance md:text-2xl">
          {title}
        </h3>
      </div>
      <dl class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
        <div>
          <dt class="sr-only">{ro.hike.distance}</dt>
          <dd class="ro-stat text-lg text-ink">
            {ro.units.distance(distance)}
          </dd>
        </div>
        <div>
          <dt class="sr-only">{ro.hike.elevationGain}</dt>
          <dd class="ro-stat trail-accent text-lg">
            +{ro.units.elevation(elevationGain)}
          </dd>
        </div>
        <div>
          <dt class="sr-only">{ro.hike.duration}</dt>
          <dd class="ro-stat text-lg text-ink-dim">
            {ro.units.duration(duration)}
          </dd>
        </div>
      </dl>
    </div>
  </a>
</li>
