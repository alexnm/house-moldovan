---
import type { ImageMetadata } from "astro";
import CoverImage from "~/components/media/CoverImage.astro";

export interface Props {
  href: string;
  title: string;
  summary?: string;
  countLabel: string;
  image?: ImageMetadata;
  imageAlt?: string;
  as?: "h2" | "h3";
}

const {
  href,
  title,
  summary,
  countLabel,
  image,
  imageAlt,
  as = "h2",
} = Astro.props;

const alt = imageAlt ?? `Peisaj din ${title}`;
const TitleTag = as === "h3" ? "h3" : "h2";
---

<li>
  <a href={href} class="range-sheet group block h-full">
    {
      image && (
        <div class="relative aspect-[5/3] overflow-hidden bg-surface-3">
          <CoverImage
            src={image}
            alt={alt}
            widths={[480, 720, 960]}
            sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw"
            format="avif"
            quality={82}
            wrapperClass="motion-hover-media h-full w-full"
            class="h-full w-full object-cover"
          />
        </div>
      )
    }
    <div class="flex flex-1 flex-col gap-3 p-6">
      <TitleTag class="display text-xl leading-tight text-balance md:text-2xl">
        {title}
      </TitleTag>
      {
        summary && (
          <p class="max-w-[42ch] text-[0.95rem] leading-snug text-pretty text-ink-dim">
            {summary}
          </p>
        )
      }
      <p class="micro mt-auto text-ink-faint">{countLabel}</p>
    </div>
  </a>
</li>
