---
import { ro } from "~/i18n/ro";
import ThemeToggle from "~/components/layout/ThemeToggle.astro";

const year = new Date().getFullYear();
---

<footer class="mt-32 border-t border-line">
  <div
    class="mx-auto grid max-w-canvas gap-12 pad-canvas py-16 md:grid-cols-[2fr_1fr_1fr]"
  >
    <div>
      <p class="display text-3xl" style="font-family: var(--font-display-ro)">
        Pe creastă
      </p>
      <p class="mt-3 max-w-md text-ink-dim">{ro.description}</p>
      <p class="micro mt-8 text-ink-faint">
        © {year}. {ro.footer.rights}
      </p>
      <ThemeToggle
        lightLabel={ro.footer.themeLight}
        darkLabel={ro.footer.themeDark}
      />
    </div>

    <div>
      <p class="micro mb-4">{ro.nav.trasee}</p>
      <ul class="space-y-2 text-ink-dim">
        <li>
          <a href="/ro/trasee" class="link-accent link-accent--dim"
            >{ro.nav.trasee}</a
          >
        </li>
        <li>
          <a href="/ro/munti" class="link-accent link-accent--dim"
            >{ro.nav.munti}</a
          >
        </li>
        <li>
          <a href="/ro/despre" class="link-accent link-accent--dim"
            >{ro.nav.despre}</a
          >
        </li>
      </ul>
    </div>

    <div>
      <p class="micro mb-4">Abonare</p>
      <ul class="space-y-2 text-ink-dim">
        <li>
          <a href="/ro/rss.xml" class="link-accent link-accent--dim"
            >{ro.footer.rssLabel}</a
          >
        </li>
      </ul>

      <a
        href="/"
        class="mt-10 block rounded-lg border border-line p-4 transition-colors duration-ui ease-cinema hover:border-line-strong"
      >
        <p class="micro text-ink-faint">{ro.footer.enKicker}</p>
        <p class="display mt-1 text-lg">{ro.footer.enCta} →</p>
      </a>
    </div>
  </div>
</footer>
