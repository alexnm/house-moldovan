---
import { ro } from "~/i18n/ro";

const path = Astro.url.pathname;
const isActive = (href: string): boolean =>
  href === "/ro" ? path === "/ro" || path === "/ro/" : path.startsWith(href);

const links = [
  { href: "/ro/trasee", label: ro.nav.trasee },
  { href: "/ro/munti", label: ro.nav.munti },
  { href: "/ro/despre", label: ro.nav.despre },
];
---

<nav
  class="site-nav fixed inset-x-0 top-0 z-40 py-4"
  data-site-nav
  aria-label="Navigare"
>
  <div
    class="pad-canvas mx-auto flex max-w-canvas items-center justify-between gap-4 md:gap-6"
  >
    <a
      href="/ro"
      class="display duration-ui flex items-center gap-2.5 text-xl tracking-tight text-ink transition-opacity ease-cinema hover:opacity-70"
      style="font-family: var(--font-display-ro)"
    >
      <img
        src="/logo-pe-creasta.svg"
        alt=""
        width="28"
        height="28"
        class="size-7 shrink-0"
        decoding="async"
      />
      {ro.siteName}
    </a>

    <ul class="hidden items-center gap-7 md:flex">
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              class:list={[
                "micro link-accent",
                isActive(l.href) && "is-active",
              ]}
            >
              {l.label}
            </a>
          </li>
        ))
      }
      <li>
        <a href="/" class="micro link-accent" target="_blank">
          {ro.nav.en} →
        </a>
      </li>
    </ul>

    <details class="relative flex items-center md:hidden">
      <summary
        class="micro list-none rounded-full border border-line px-3 py-1.5 text-ink-nav [&::-webkit-details-marker]:hidden"
      >
        Meniu
      </summary>
      <ul
        class="absolute right-0 mt-3 flex w-56 flex-col gap-3 rounded-lg border border-line bg-surface-2 p-4 shadow-lift"
      >
        {
          links.map((l) => (
            <li>
              <a href={l.href} class="micro link-accent block">
                {l.label}
              </a>
            </li>
          ))
        }
        <li>
          <a href="/" class="micro link-accent block">
            {ro.nav.en} →
          </a>
        </li>
      </ul>
    </details>
  </div>
</nav>
