---
import { ro } from "~/i18n/ro";
import SiteLogo from "~/components/layout/SiteLogo.astro";

const path = Astro.url.pathname;
const isActive = (href: string): boolean =>
  href === "/ro" ? path === "/ro" || path === "/ro/" : path.startsWith(href);

const links = [
  { href: "/ro/trasee", label: ro.nav.trasee },
  { href: "/ro/munti", label: ro.nav.munti },
  { href: "/ro/despre", label: ro.nav.despre },
];
---

<nav
  class="site-nav fixed inset-x-0 top-0 z-40 pt-5 pb-4"
  data-site-nav
  aria-label="Navigare"
>
  <div
    class="pad-canvas mx-auto flex max-w-canvas items-center justify-between gap-4 sm:gap-6"
  >
    <SiteLogo href="/ro" mark="/logo-pe-creasta.svg" label={ro.siteName} />

    <ul class="hidden items-center gap-7 leading-[1.2] sm:flex">
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              class:list={[
                "nav-link link-accent",
                isActive(l.href) && "is-active",
              ]}
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>

    <details class="relative flex items-center sm:hidden">
      <summary
        class="nav-link link-accent list-none [&::-webkit-details-marker]:hidden"
        aria-label="Meniu"
      >
        Meniu
      </summary>
      <div
        class="nav-mobile-panel absolute right-0 mt-3 w-64 rounded-lg border border-line bg-surface-2 px-5 py-5 shadow-lift"
      >
        <ul class="flex flex-col gap-5">
          {
            links.map((l) => (
              <li>
                <a href={l.href} class="nav-link link-accent block">
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </details>
  </div>
</nav>
