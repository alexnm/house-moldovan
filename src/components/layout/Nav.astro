---
import { en } from "~/i18n/en";
import NavDropdown from "~/components/layout/NavDropdown.astro";
import SiteLogo from "~/components/layout/SiteLogo.astro";
import { placeShortName } from "~/lib/articlePlaces";
import { countriesForRegion, getAllPlaces } from "~/lib/content";
import { getAllRegions } from "~/lib/regions";

const path = Astro.url.pathname;

const isJournalActive =
  path === "/journal" ||
  path.startsWith("/journal/") ||
  path.startsWith("/stories") ||
  path.startsWith("/spotlights") ||
  path.startsWith("/itineraries");

const isExploreActive = path === "/explore" || path.startsWith("/explore/");

const isAboutActive = path === "/about" || path.startsWith("/about/");

const journalLinks = [
  { href: "/stories", label: en.nav.stories },
  { href: "/itineraries", label: en.nav.itineraries },
  { href: "/spotlights", label: en.nav.spotlights },
];

const [regions, places] = await Promise.all([getAllRegions(), getAllPlaces()]);

const exploreMenu = regions
  .map((region) => ({
    id: region.id,
    name: region.data.name,
    href: `/explore/region/${region.id}`,
    accent: region.data.accent,
    countries: countriesForRegion(places, region.id).map((country) => ({
      id: country.id,
      name: placeShortName(country),
      flag: country.data.flag,
      href: `/explore/${country.id}`,
    })),
  }))
  .filter((region) => region.countries.length > 0);
---

<nav
  class="site-nav fixed inset-x-0 top-0 z-40 pt-5 pb-4"
  data-site-nav
  aria-label="Primary"
>
  <div
    class="pad-canvas mx-auto flex max-w-canvas items-center justify-between gap-4 sm:gap-6"
  >
    <SiteLogo />

    <ul class="hidden items-center gap-7 leading-[1.2] sm:flex">
      <NavDropdown
        label={en.nav.journal}
        href="/journal"
        menuId="nav-journal"
        active={isJournalActive}
      >
        <ul class="flex min-w-44 flex-col gap-0.5 p-2">
          {
            journalLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class:list={[
                    "nav-link nav-link--sub link-accent link-accent--dim block rounded-md px-2.5 py-2",
                    (path === link.href || path.startsWith(link.href + "/")) &&
                      "is-active",
                  ]}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </NavDropdown>

      <NavDropdown
        label={en.nav.explore}
        href="/explore"
        menuId="nav-explore"
        active={isExploreActive}
        panelClass="-right-[3rem]"
        panelInnerClass="w-max max-w-[calc(100vw-4rem)] px-7 py-6"
      >
        <div class="flex flex-wrap gap-x-8 gap-y-8">
          {
            exploreMenu.map((region) => (
              <div
                class="accent-scope min-w-40 shrink-0"
                data-accent={region.accent}
              >
                <a
                  href={region.href}
                  class="micro duration-ui block font-medium whitespace-nowrap text-accent-ink transition-opacity ease-cinema hover:opacity-80"
                >
                  {region.name}
                </a>
                <ul class="mt-3.5 space-y-1">
                  {region.countries.map((country) => (
                    <li>
                      <a
                        href={country.href}
                        class:list={[
                          "nav-link nav-link--sub link-accent link-accent--dim flex items-center gap-2 rounded-md px-1.5 py-2 whitespace-nowrap",
                          path === country.href && "is-active",
                        ]}
                      >
                        <span class="text-base leading-none" aria-hidden="true">
                          {country.flag}
                        </span>
                        {country.name}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </NavDropdown>

      <li>
        <a
          href="/about"
          class:list={["nav-link link-accent", isAboutActive && "is-active"]}
        >
          {en.nav.about}
        </a>
      </li>

      {
        /* <li>
        <a
          href="/ro"
          class="nav-link link-accent"
          target="_blank"
          rel="noopener noreferrer"
        >
          {en.nav.ro} →
        </a>
      </li> */
      }
    </ul>

    <details class="relative flex items-center sm:hidden">
      <summary
        class="nav-link link-accent list-none [&::-webkit-details-marker]:hidden"
        aria-label={en.nav.openMenu}
      >
        Menu
      </summary>
      <div
        class="nav-mobile-panel absolute right-0 mt-3 w-64 rounded-lg border border-line bg-surface-2 px-5 py-5 shadow-lift"
      >
        <ul class="flex flex-col gap-5">
          <li>
            <a
              href="/journal"
              class:list={[
                "nav-link link-accent block",
                isJournalActive && "is-active",
              ]}
            >
              {en.nav.journal}
            </a>
            <ul class="nav-submenu mt-4 space-y-4 ps-3.5">
              {
                journalLinks.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      class:list={[
                        "nav-link link-accent block",
                        (path === link.href ||
                          path.startsWith(link.href + "/")) &&
                          "is-active",
                      ]}
                    >
                      {link.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </li>

          <li>
            <a
              href="/explore"
              class:list={[
                "nav-link link-accent block",
                isExploreActive && "is-active",
              ]}
            >
              {en.nav.explore}
            </a>
            <ul class="nav-submenu mt-4 space-y-4 ps-3.5">
              {
                exploreMenu.map((region) => (
                  <li class="accent-scope" data-accent={region.accent}>
                    <a
                      href={region.href}
                      class:list={[
                        "nav-link duration-ui block transition-opacity ease-cinema hover:opacity-80",
                        (path === region.href ||
                          path.startsWith(region.href + "/")) &&
                          "is-active",
                      ]}
                    >
                      {region.name}
                    </a>
                  </li>
                ))
              }
            </ul>
          </li>

          <li>
            <a
              href="/about"
              class:list={[
                "nav-link link-accent block",
                isAboutActive && "is-active",
              ]}
            >
              {en.nav.about}
            </a>
          </li>

          {
            /* <li>
            <a
              href="/ro"
              class="nav-link link-accent block"
              target="_blank"
              rel="noopener noreferrer"
            >
              {en.nav.ro} →
            </a>
          </li> */
          }
        </ul>
      </div>
    </details>
  </div>
</nav>
