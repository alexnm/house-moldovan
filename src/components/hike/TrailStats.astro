---
import { ro } from "~/i18n/ro";
import type { WaymarkCode } from "~/lib/waymarks";
import WaymarkBadge from "./WaymarkBadge.astro";

export interface Props {
  distance: number;
  shape: "dus-intors" | "circuit" | "traversare";
  elevationGain: number;
  elevationLoss?: number;
  summit?: number;
  duration: readonly [number, number];
  difficulty: "usor" | "mediu" | "dificil" | "tehnic";
  waymark: readonly WaymarkCode[];
  season: ReadonlyArray<"primavara" | "vara" | "toamna" | "iarna">;
  trailhead: { name: string; access?: string };
}

const {
  distance,
  shape,
  elevationGain,
  elevationLoss,
  summit,
  duration,
  difficulty,
  waymark,
  season,
  trailhead,
} = Astro.props;

const seasonLabel = season.map((s) => ro.season[s]).join(", ");

const trailheadValue = trailhead.access
  ? `${trailhead.name} · ${trailhead.access}`
  : trailhead.name;

const primary = [
  { label: ro.hike.difficulty, value: ro.difficulty[difficulty] },
  { label: ro.hike.duration, value: ro.units.duration(duration) },
  {
    label: ro.hike.elevationGain,
    value: `+${ro.units.elevation(elevationGain)}`,
  },
];

const secondary = [
  { label: ro.hike.distance, value: ro.units.distance(distance) },
  { label: ro.hike.trailhead, value: trailheadValue },
  ...(summit
    ? [{ label: ro.hike.summit, value: ro.units.elevation(summit) }]
    : []),
  ...(elevationLoss !== undefined && elevationLoss !== elevationGain
    ? [
        {
          label: ro.hike.elevationLoss,
          value: `-${ro.units.elevation(elevationLoss)}`,
        },
      ]
    : []),
  { label: ro.hike.shape, value: ro.shape[shape] },
  { label: ro.hike.season, value: seasonLabel },
];
---

<aside class="motion-reveal" aria-label={ro.hike.difficulty}>
  <dl class="space-y-4">
    {
      primary.map((s) => (
        <div>
          <dt class="micro text-ink-dim">{s.label}</dt>
          <dd class="mt-0.5 font-mono text-base text-ink">{s.value}</dd>
        </div>
      ))
    }
  </dl>

  <dl class="mt-8 space-y-4 border-t border-line pt-8">
    {
      secondary.map((s) => (
        <div>
          <dt class="micro text-ink-dim">{s.label}</dt>
          <dd class="mt-0.5 font-mono text-base text-ink">{s.value}</dd>
        </div>
      ))
    }
    <div>
      <dt class="micro text-ink-dim">{ro.hike.waymark}</dt>
      <dd class="mt-1.5"><WaymarkBadge marks={waymark} /></dd>
    </div>
  </dl>
</aside>
