---
import "leaflet/dist/leaflet.css";
import { ro } from "~/i18n/ro";

export interface Props {
  /** GeoJSON vertex order: [lng, lat]. */
  line: [number, number][];
  /** Public URL to the GPX file (e.g. `/trasee/foo.gpx`). */
  gpxHref: string;
}

const { line, gpxHref } = Astro.props;
---

<figure class="motion-reveal" aria-label={ro.hike.mapCaption}>
  <figcaption
    class="micro mb-3 flex items-baseline justify-between gap-3 text-ink-faint"
  >
    <span>{ro.hike.mapCaption}</span>
    <a href={gpxHref} download class="link-accent link-accent--dim shrink-0">
      {ro.hike.gpxDownload} ↓
    </a>
  </figcaption>
  <div
    class="hike-route-map isolate z-0 h-[min(22rem,55vh)] w-full overflow-hidden rounded-lg border border-line bg-surface-2 [&_.leaflet-container]:h-full [&_.leaflet-container]:font-sans [&_.leaflet-container]:text-[11px]"
    data-line={JSON.stringify(line)}
  >
  </div>
</figure>

<script>
  import L from "leaflet";

  function accentStroke(el: HTMLElement): string {
    const scope = el.closest(".accent-scope");
    const source = scope ?? document.documentElement;
    return (
      getComputedStyle(source).getPropertyValue("--color-accent").trim() ||
      "#d9875c"
    );
  }

  function initHikeMaps(root: ParentNode = document): void {
    root
      .querySelectorAll<HTMLElement>(".hike-route-map:not([data-mounted])")
      .forEach((el) => {
        const raw = el.dataset.line;
        if (!raw) return;

        const line = JSON.parse(raw) as [number, number][];
        const latlngs: L.LatLngExpression[] = line.map(([lng, lat]) => [
          lat,
          lng,
        ]);

        const mount = (): void => {
          if (el.dataset.mounted === "1") return;
          el.dataset.mounted = "1";

          const map = L.map(el, {
            scrollWheelZoom: false,
            attributionControl: true,
          });

          L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
            attribution:
              '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
          }).addTo(map);

          const poly = L.polyline(latlngs, {
            color: accentStroke(el),
            weight: 4,
            opacity: 0.92,
            lineJoin: "round",
          }).addTo(map);

          const fit = (): void => {
            map.invalidateSize();
            map.fitBounds(poly.getBounds().pad(0.1));
          };

          requestAnimationFrame(fit);
          setTimeout(fit, 200);
        };

        if (typeof IntersectionObserver !== "undefined") {
          const io = new IntersectionObserver(
            (entries) => {
              for (const e of entries) {
                if (e.isIntersecting) {
                  io.disconnect();
                  mount();
                  break;
                }
              }
            },
            { rootMargin: "120px" },
          );
          io.observe(el);
        } else {
          mount();
        }
      });
  }

  initHikeMaps();
  document.addEventListener("astro:page-load", () => initHikeMaps());
</script>
