---
import type { ImageMetadata } from "astro";
import CoverImage from "~/components/media/CoverImage.astro";
import { buildRhythmCells } from "~/lib/rhythmGrid";

export interface Props {
  photos: { image: ImageMetadata; caption: string; tagline: string }[];
}

const { photos } = Astro.props;
const cells = buildRhythmCells(photos);
---

<section class="spotlight-photo-grid section section-y w-full">
  <div
    class="grid grid-cols-1 items-stretch gap-[var(--grid-gap)] sm:grid-cols-2 lg:grid-cols-3"
  >
    {
      cells.map(({ item, span }) => (
        <div
          class:list={[
            "spotlight-photo motion-reveal-media relative min-h-0 overflow-clip rounded",
            span === 2 && "lg:col-span-2",
            span === 2
              ? "aspect-[16/9] lg:aspect-auto lg:h-full lg:min-h-[min(36rem,50vh)]"
              : "aspect-[4/5]",
          ]}
        >
          <CoverImage
            src={item.image}
            alt={item.caption}
            widths={
              span === 2 ? [800, 1200, 1600, 2400] : [480, 720, 960, 1280, 1600]
            }
            sizes={
              span === 2
                ? "(min-width: 1536px) 60rem, (min-width: 768px) 66vw, 100vw"
                : "(min-width: 1536px) 30rem, (min-width: 768px) 33vw, 100vw"
            }
            loading="lazy"
            format="avif"
            quality={82}
            wrapperClass="absolute inset-0"
            class="absolute inset-0 h-full w-full object-cover"
          />
          <span class="stamp-badge absolute top-3 left-3 z-10 md:top-4 md:left-4">
            {item.tagline}
          </span>
        </div>
      ))
    }
  </div>
</section>

<style>
  /* Beat Astro's unlayered `[data-astro-image]{height:auto}` (replaced elements
     ignore inset-stretching, so object-cover needs an explicit height). */
  .spotlight-photo-grid img {
    height: 100%;
    width: 100%;
    object-fit: cover;
  }
</style>
